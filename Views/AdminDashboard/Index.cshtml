@model MvcMusic.ViewModels.AdminDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Analytics Dashboard";
    var salesDayLabels = Json.Serialize(Model.SalesByDay.Select(s => s.Label).ToList());
    var salesDayData   = Json.Serialize(Model.SalesByDay.Select(s => s.Value).ToList());
    var salesWeekLabels = Json.Serialize(Model.SalesByWeek.Select(s => s.Label).ToList());
    var salesWeekData   = Json.Serialize(Model.SalesByWeek.Select(s => s.Value).ToList());
    var salesMonthLabels = Json.Serialize(Model.SalesByMonth.Select(s => s.Label).ToList());
    var salesMonthData   = Json.Serialize(Model.SalesByMonth.Select(s => s.Value).ToList());
    var seasonLabels = Json.Serialize(Model.SalesBySeason.Select(s => s.Label).ToList());
    var seasonData   = Json.Serialize(Model.SalesBySeason.Select(s => s.Value).ToList());
    var topSellerLabels = Json.Serialize(Model.TopSellers.Select(s => s.Label).ToList());
    var topSellerData   = Json.Serialize(Model.TopSellers.Select(s => s.Value).ToList());
    var catLabels = Json.Serialize(Model.RevenueByCategory.Select(s => s.Label).ToList());
    var catData   = Json.Serialize(Model.RevenueByCategory.Select(s => s.Value).ToList());
}

<div class="nc-page">
    <div class="nc-container-fluid">

        <!-- Page Header -->
        <div class="dash-header">
            <div>
                <h1 class="nc-page-title">Analytics Dashboard</h1>
                <span class="nc-text-muted">Welcome back,</span> <span style="font-weight:700;color:var(--nc-primary);">@ViewData["CurrentUserName"]</span>
            </div>
            <div class="dash-header-time">
                <i class="fa fa-clock me-1"></i>
                <span id="liveTime"></span>
            </div>
        </div>

        <!-- Stat Cards -->
        <div class="dash-stats-grid">
            <div class="dash-stat-card revenue">
                <div class="dash-stat-icon"><i class="fa fa-money-bill-wave"></i></div>
                <div class="dash-stat-body">
                    <div class="dash-stat-label">Total Revenue</div>
                    <div class="dash-stat-value">@GlobalConfig.CurrencySymbol @Model.TotalRevenue.ToString("N0")</div>
                    <div class="dash-stat-sub">Delivered orders only</div>
                </div>
            </div>
            <div class="dash-stat-card orders">
                <div class="dash-stat-icon"><i class="fa fa-bag-shopping"></i></div>
                <div class="dash-stat-body">
                    <div class="dash-stat-label">Total Orders</div>
                    <div class="dash-stat-value">@Model.TotalOrders</div>
                    <div class="dash-stat-sub">All time</div>
                </div>
            </div>
            <div class="dash-stat-card customers">
                <div class="dash-stat-icon"><i class="fa fa-users"></i></div>
                <div class="dash-stat-body">
                    <div class="dash-stat-label">Customers</div>
                    <div class="dash-stat-value">@Model.TotalCustomers</div>
                    <div class="dash-stat-sub">Registered accounts</div>
                </div>
            </div>
            <div class="dash-stat-card products">
                <div class="dash-stat-icon"><i class="fa fa-guitar"></i></div>
                <div class="dash-stat-body">
                    <div class="dash-stat-label">Products</div>
                    <div class="dash-stat-value">@Model.TotalProducts</div>
                    <div class="dash-stat-sub">In catalog</div>
                </div>
            </div>
            <div class="dash-stat-card employees">
                <div class="dash-stat-icon"><i class="fa fa-user-tie"></i></div>
                <div class="dash-stat-body">
                    <div class="dash-stat-label">Employees</div>
                    <div class="dash-stat-value">@Model.TotalEmployees</div>
                    <div class="dash-stat-sub">Admin + Staff</div>
                </div>
            </div>
        </div>

        <!-- Charts Row 1: Sales by Day and by Month -->
        <div class="dash-charts-row">
            <div class="dash-chart-card wide">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-calendar-day me-2"></i>Sales Last 30 Days</div>
                    <div class="dash-chart-sub">Daily revenue trend</div>
                </div>
                <div class="dash-chart-body">
                    <canvas id="chartDay"></canvas>
                </div>
            </div>
            <div class="dash-chart-card">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-calendar me-2"></i>Sales by Season</div>
                    <div class="dash-chart-sub">Seasonal breakdown</div>
                </div>
                <div class="dash-chart-body">
                    <canvas id="chartSeason"></canvas>
                </div>
            </div>
        </div>

        <!-- Charts Row 2: By Week, By Month -->
        <div class="dash-charts-row">
            <div class="dash-chart-card">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-calendar-week me-2"></i>Sales Last 12 Weeks</div>
                    <div class="dash-chart-sub">Weekly revenue</div>
                </div>
                <div class="dash-chart-body">
                    <canvas id="chartWeek"></canvas>
                </div>
            </div>
            <div class="dash-chart-card">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-calendar-alt me-2"></i>Sales Last 12 Months</div>
                    <div class="dash-chart-sub">Monthly revenue</div>
                </div>
                <div class="dash-chart-body">
                    <canvas id="chartMonth"></canvas>
                </div>
            </div>
        </div>

        <!-- Charts Row 3: Top Sellers + Revenue by Category -->
        <div class="dash-charts-row">
            <div class="dash-chart-card">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-trophy me-2"></i>Top Sellers</div>
                    <div class="dash-chart-sub">By units sold</div>
                </div>
                <div class="dash-chart-body">
                    <canvas id="chartTopSellers"></canvas>
                </div>
            </div>
            <div class="dash-chart-card">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-chart-pie me-2"></i>Revenue by Category</div>
                    <div class="dash-chart-sub">Total from orders</div>
                </div>
                <div class="dash-chart-body">
                    <canvas id="chartCategory"></canvas>
                </div>
            </div>
        </div>
        <!-- Row 4: Recent Data Tables -->
        <div class="dash-tables-row">
            <!-- Recent Orders -->
            <div class="dash-table-card">
                <div class="dash-chart-header">
                    <div class="dash-chart-title"><i class="fa fa-shopping-bag me-2"></i>Recent Orders</div>
                    <div class="dash-chart-sub">Latest 10 transactions</div>
                </div>
                <div class="dash-table-container">
                    <table class="nc-recent-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Products</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="order-id">#@order.Id</td>
                                    <td>@order.CustomerName</td>
                                    <td class="products-cell" title="@order.Products">@order.Products</td>
                                    <td class="amount">@GlobalConfig.CurrencySymbol@order.Amount.ToString("N2")</td>
                                    <td>
                                        @{
                                            var statusClass = order.Status.ToLower() switch {
                                                "delivered" => "status-delivered",
                                                "pending" => "status-pending",
                                                "shipped" => "status-shipped",
                                                _ => "status-default"
                                            };
                                        }
                                        <span class="status-badge @statusClass">@order.Status</span>
                                    </td>
                                    <td class="date-cell">@order.Date.ToString("MMM d, h:mm tt")</td>
                                </tr>
                            }
                            @if (!Model.RecentOrders.Any())
                            {
                                <tr><td colspan="6" class="text-center nc-text-muted py-4">No recent orders found.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="dash-table-footer">
                    <a asp-controller="Orders" asp-action="Index" class="btn-nc-link">View All Orders <i class="fa fa-chevron-right ms-1"></i></a>
                </div>
            </div>

            <!-- Recent Activity Logs (Admin/SuperAdmin only) -->
            @if (ViewBag.ShowLogs == true)
            {
                <div class="dash-table-card">
                    <div class="dash-chart-header">
                        <div class="dash-chart-title"><i class="fa fa-list-ul me-2"></i>Activity Log</div>
                        <div class="dash-chart-sub">Recent staff actions</div>
                    </div>
                    <div class="dash-table-container">
                        <table class="nc-recent-table">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>User</th>
                                    <th>Action</th>
                                    <th>Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.RecentLogs)
                                {
                                    <tr>
                                        <td class="date-cell utc-time" data-utc="@log.Timestamp.ToString("yyyy-MM-ddTHH:mm:ssZ")">@log.Timestamp.ToString("HH:mm:ss")</td>
                                        <td>
                                            <div class="log-user">
                                                <span class="log-username">@log.Username</span>
                                                <span class="log-role">@log.Role</span>
                                            </div>
                                        </td>
                                        <td><span class="action-badge">@log.Action</span></td>
                                        <td class="details-cell">@Html.Raw(log.Details)</td>
                                    </tr>
                                }
                                @if (!Model.RecentLogs.Any())
                                {
                                    <tr><td colspan="4" class="text-center nc-text-muted py-4">No recent activity found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="dash-table-footer">
                        <a asp-controller="ActivityLogs" asp-action="Index" class="btn-nc-link">View Detailed Logs <i class="fa fa-chevron-right ms-1"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Live clock
        function updateClock() {
            const now = new Date();
            document.getElementById('liveTime').textContent = now.toLocaleString();
        }
        updateClock();
        setInterval(updateClock, 1000);

        // Convert UTC to Local
        document.querySelectorAll('.utc-time').forEach(el => {
            const utc = el.getAttribute('data-utc');
            if (utc) {
                const d = new Date(utc);
                el.textContent = d.toLocaleTimeString([], { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' });
            }
        });

        const ncPrimary = '#7babdd';
        const chartDefaults = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: 'rgba(14,18,26,0.95)',
                    titleColor: '#e2e8f2',
                    bodyColor: '#aab4cc',
                    borderColor: 'rgba(122,171,221,0.3)',
                    borderWidth: 1,
                    callbacks: {
                        label: ctx => {
                            const currency = window.ncConfig?.currency;
                            return ` ${currency} ` + Number(ctx.parsed.y ?? ctx.parsed).toLocaleString(undefined, {minimumFractionDigits: 2});
                        }
                    }
                }
            },
            scales: {
                x: { ticks: { color: '#647087', font: { size: 11 } }, grid: { color: 'rgba(122,171,221,0.07)' } },
                y: { ticks: { color: '#647087', font: { size: 11 }, callback: v => (window.ncConfig?.currency) + Number(v).toLocaleString() }, grid: { color: 'rgba(122,171,221,0.07)' } }
            }
        };

        const gradientCtx = id => {
            const canvas = document.getElementById(id);
            const ctx = canvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 250);
            gradient.addColorStop(0, 'rgba(123,171,221,0.35)');
            gradient.addColorStop(1, 'rgba(123,171,221,0.01)');
            return { ctx, gradient };
        };

        // Day chart
        const dayCtx = gradientCtx('chartDay');
        new Chart(dayCtx.ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(salesDayLabels),
                datasets: [{ data: @Html.Raw(salesDayData), borderColor: ncPrimary, backgroundColor: dayCtx.gradient, fill: true, tension: 0.4, pointRadius: 3, pointBackgroundColor: ncPrimary }]
            },
            options: { ...chartDefaults }
        });

        // Week chart
        const wkCtx = gradientCtx('chartWeek');
        new Chart(wkCtx.ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(salesWeekLabels),
                datasets: [{ data: @Html.Raw(salesWeekData), backgroundColor: 'rgba(123,171,221,0.3)', borderColor: ncPrimary, borderWidth: 1.5, borderRadius: 6 }]
            },
            options: { ...chartDefaults }
        });

        // Month chart
        const moCtx = gradientCtx('chartMonth');
        new Chart(moCtx.ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(salesMonthLabels),
                datasets: [{ data: @Html.Raw(salesMonthData), backgroundColor: 'rgba(123,171,221,0.3)', borderColor: ncPrimary, borderWidth: 1.5, borderRadius: 6 }]
            },
            options: { ...chartDefaults }
        });

        // Season chart (doughnut)
        new Chart(document.getElementById('chartSeason'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(seasonLabels),
                datasets: [{
                    data: @Html.Raw(seasonData),
                    backgroundColor: ['rgba(123,171,221,0.7)', 'rgba(129,199,132,0.7)', 'rgba(255,183,77,0.7)', 'rgba(229,115,115,0.7)'],
                    borderColor: '#0a0c10',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'bottom', labels: { color: '#aab4cc', font: { size: 12 }, padding: 16 } },
                    tooltip: { callbacks: { label: ctx => ` ${(window.ncConfig?.currency)} ` + Number(ctx.parsed).toLocaleString(undefined, {minimumFractionDigits: 2}) } }
                },
                cutout: '65%'
            }
        });

        // Top sellers
        new Chart(document.getElementById('chartTopSellers'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(topSellerLabels),
                datasets: [{ data: @Html.Raw(topSellerData), backgroundColor: 'rgba(210,219,234,0.3)', borderColor: '#d2dbea', borderWidth: 1.5, borderRadius: 6 }]
            },
            options: {
                ...chartDefaults,
                indexAxis: 'y',
                plugins: { ...chartDefaults.plugins,
                    tooltip: { callbacks: { label: ctx => ' ' + ctx.parsed.x + ' units sold' } }
                },
                scales: {
                    x: { ticks: { color: '#647087' }, grid: { color: 'rgba(122,171,221,0.07)' } },
                    y: { ticks: { color: '#aab4cc', font: { size: 11 } }, grid: { color: 'rgba(122,171,221,0.07)' } }
                }
            }
        });

        // Category doughnut
        const catColors = ['rgba(123,171,221,0.8)','rgba(129,199,132,0.8)','rgba(255,183,77,0.8)','rgba(229,115,115,0.8)','rgba(186,104,200,0.8)','rgba(77,208,225,0.8)','rgba(255,138,101,0.8)'];
        new Chart(document.getElementById('chartCategory'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(catLabels),
                datasets: [{
                    data: @Html.Raw(catData),
                    backgroundColor: catColors,
                    borderColor: '#0a0c10',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'bottom', labels: { color: '#aab4cc', font: { size: 12 }, padding: 16 } },
                    tooltip: { callbacks: { label: ctx => ` ${(window.ncConfig?.currency)} ` + Number(ctx.parsed).toLocaleString(undefined, {minimumFractionDigits: 2}) } }
                },
                cutout: '65%'
            }
        });
    </script>
}

@section Styles {
    <style>
        .dash-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .dash-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--nc-border);
        }

        .dash-header-time {
            padding: 0.5rem 1rem;
            background: rgba(122, 171, 221, 0.05);
            border: 1px solid var(--nc-border);
            border-radius: 100px;
            font-size: 0.85rem;
            font-family: 'Inter', sans-serif;
            color: var(--nc-primary);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .dash-stat-card {
            background: var(--nc-bg-card);
            border: 1px solid var(--nc-border);
            border-radius: var(--nc-radius);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.5rem;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

        .dash-stat-card:hover {
            transform: translateY(-3px);
            border-color: var(--nc-primary);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        .dash-stat-icon {
            width: 54px;
            height: 54px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            background: rgba(122, 171, 221, 0.1);
            color: var(--nc-primary);
            border: 1px solid rgba(122, 171, 221, 0.2);
        }

        .revenue .dash-stat-icon { color: var(--nc-success); background: rgba(129, 199, 132, 0.1); border-color: rgba(129, 199, 132, 0.2); }
        .orders .dash-stat-icon { color: var(--nc-primary); }
        .customers .dash-stat-icon { color: var(--nc-warning); background: rgba(255, 183, 77, 0.1); border-color: rgba(255, 183, 77, 0.2); }
        .products .dash-stat-icon { color: #8c9cb1; }
        .employees .dash-stat-icon { color: #818cf8; background: rgba(129, 140, 248, 0.1); border-color: rgba(129, 140, 248, 0.2); }

        .dash-stat-body {
            display: flex;
            flex-direction: column;
        }

        .dash-stat-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--nc-text-muted);
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .dash-stat-value {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            line-height: 1.2;
        }

        .dash-stat-sub {
            font-size: 0.7rem;
            color: var(--nc-text-muted);
            margin-top: 0.25rem;
        }

        /* Chart Section */
        .dash-charts-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .dash-chart-card {
            background: var(--nc-bg-card);
            border: 1px solid var(--nc-border);
            border-radius: var(--nc-radius);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

        .dash-chart-card.wide {
            grid-column: span 2;
        }

        @@media (max-width: 1200px) {
            .dash-chart-card.wide {
                grid-column: span 1;
            }
        }

        .dash-chart-header {
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--nc-border);
        }

        .dash-chart-title {
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
        }

        .dash-chart-sub {
            font-size: 0.8rem;
            color: var(--nc-text-muted);
            margin-top: 0.25rem;
        }

        .dash-chart-body {
            flex-grow: 1;
            min-height: 300px;
            position: relative;
        }

        .dash-management-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .mgmt-card {
            background: var(--nc-bg-card);
            border: 1px solid var(--nc-border);
            border-radius: var(--nc-radius);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: center;
            transition: var(--transition);
            text-decoration: none !important;
            position: relative;
            overflow: hidden;
        }

        .mgmt-card:hover {
            transform: translateY(-5px);
            border-color: var(--nc-primary);
            box-shadow: var(--nc-shadow-glow);
        }

        .mgmt-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 150px;
            height: 150px;
            background: radial-gradient(circle, var(--nc-primary-glow) 0%, transparent 70%);
            border-radius: 50%;
            transform: translate(30%, -30%);
            transition: var(--transition);
            opacity: 0;
        }

        .mgmt-card:hover::before {
            opacity: 1;
        }

        .mgmt-icon {
            font-size: 2.5rem;
            color: var(--nc-primary);
            margin-bottom: 1.5rem;
        }

        .mgmt-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .mgmt-desc {
            color: var(--nc-text-muted);
            font-size: 0.9rem;
            line-height: 1.5;
            margin-bottom: 1.5rem;
        }

        .mgmt-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--nc-primary);
            font-weight: 700;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: auto;
        }

        .mgmt-card:hover .mgmt-link {
            color: #fff;
        }

        .mgmt-link i {
            transition: transform 0.2s;
        }

        .mgmt-card:hover .mgmt-link i {
            transform: translateX(5px);
        }
        /* Dashboard Tables */
        .dash-tables-row {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .dash-table-card {
            background: var(--nc-bg-card);
            border: 1px solid var(--nc-border);
            border-radius: var(--nc-radius);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .dash-table-container {
            flex-grow: 1;
            overflow-x: auto;
            margin: 0 -1.5rem;
            padding: 0 1.5rem;
        }

        .nc-recent-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .nc-recent-table th {
            text-align: left;
            padding: 1rem 0.75rem;
            color: var(--nc-text-muted);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--nc-border);
        }

        .nc-recent-table td {
            padding: 1rem 0.75rem;
            color: #d2dbea;
            border-bottom: 1px solid rgba(122, 171, 221, 0.05);
            vertical-align: middle;
        }

        .nc-recent-table tr:hover td {
            background: rgba(122, 171, 221, 0.02);
        }

        .order-id { font-weight: 700; color: var(--nc-primary); }
        .amount { font-weight: 700; color: #fff; }
        
        .products-cell {
            max-width: 200px;
            overflow: hidden;
