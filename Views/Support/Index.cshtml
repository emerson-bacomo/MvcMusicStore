@model IEnumerable<MvcMusic.Models.ChatRoom>
@{
    ViewData["Title"] = "Customer Support";
}
@using MvcMusic.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <div class="nc-breadcrumb"><i class="fa fa-headset"></i> Support Panel</div>
                <h1 class="nc-page-title">Customer Support</h1>
                <p class="nc-page-subtitle">Manage customer inquiries and real-time chats</p>
            </div>
        </div>

        <div id="messenger" class="nc-messenger">
            <!-- Sidebar -->
            <div class="nc-messenger-sidebar">
                <div class="nc-messenger-sidebar-header">
                    <div class="position-relative">
                        <i class="fa fa-magnifying-glass position-absolute" style="left:1rem; top:50%; transform:translateY(-50%); color:var(--nc-text-muted);"></i>
                        <input type="text" id="inboxSearch" class="nc-chat-input w-100" style="padding-left:2.5rem;" placeholder="Search conversations...">
                    </div>
                </div>
                <div class="nc-messenger-inbox" id="inboxList">
                    @if (ViewBag.DraftCustomerId != null)
                    {
                        <div class="nc-inbox-item active" onclick="showDraft('@ViewBag.DraftCustomerId', '@ViewBag.DraftSubject', '@ViewBag.DraftCustomerName')" id="draft-item">
                            <div class="nc-inbox-avatar">
                                @(ViewBag.DraftCustomerName?[0].ToString().ToUpper() ?? "?")
                            </div>
                            <div class="nc-inbox-info">
                                <div class="nc-inbox-subject">@ViewBag.DraftSubject</div>
                                <div class="nc-inbox-customer">@ViewBag.DraftCustomerName</div>
                                <div class="nc-inbox-preview italic text-primary">Draft Message...</div>
                            </div>
                        </div>
                    }
                    @foreach (var room in Model)
                    {
                        var lastMsg = room.Messages.OrderByDescending(m => m.Timestamp).FirstOrDefault();
                        <div class="nc-inbox-item @(ViewBag.ActiveRoomId == room.Id ? "active" : "")" onclick="loadChat(@room.Id, '@room.Subject', '@(room.Customer?.FullName ?? room.Customer?.UserName)')" id="room-item-@room.Id">
                            <div class="nc-inbox-avatar">
                                @(room.Customer?.FirstName?.FirstOrDefault().ToString().ToUpper() ?? "?")
                            </div>
                            <div class="nc-inbox-info">
                                <div class="nc-inbox-subject">@room.Subject</div>
                                <div class="nc-inbox-customer">@(room.Customer?.FullName ?? room.Customer?.UserName)</div>
                                <div class="nc-inbox-preview">@(lastMsg?.Content ?? "No messages yet")</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Main Chat Area -->
            <div class="nc-messenger-main" id="chatArea">
                <div class="nc-messenger-empty" id="chatEmptyState" @(ViewBag.ActiveRoomId != null || ViewBag.DraftCustomerId != null ? "style=display:none" : "")>
                    <i class="fa fa-comments"></i>
                    <h3>Select a conversation</h3>
                    <p>Choose a chat from the inbox to start messaging.</p>
                </div>

                <div id="chatContent" style="@(ViewBag.ActiveRoomId != null || ViewBag.DraftCustomerId != null ? "display:flex" : "display:none"); flex:1; flex-direction:column;">
                    <div class="nc-messenger-header">
                        <div class="d-flex align-items-center">
                            <button class="btn-back" onclick="toggleMobileSidebar()">
                                <i class="fa fa-arrow-left"></i>
                            </button>
                            <div>
                                <h4 id="activeSubject" class="mb-0" style="font-size:1.1rem; font-weight:700;">Subject</h4>
                                <div id="activeCustomer" style="font-size:0.8rem; color:var(--nc-text-muted);">Customer Name</div>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <div class="dropdown">
                                <button class="nc-action-link" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa fa-ellipsis-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary">
                                    <li>
                                        <button class="dropdown-item text-danger d-flex align-items-center gap-2" onclick="deleteCurrentRoom(this)">
                                            <i class="fa fa-trash-can"></i> Delete Conversation
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="nc-messenger-body" id="messageList">
                        <!-- Messages will be loaded here -->
                    </div>
                    <div id="typingIndicator" class="nc-typing-indicator mx-3">
                        <span id="typingName">Someone</span> is typing
                        <div class="nc-typing-dots"><span></span><span></span><span></span></div>
                    </div>

                    <div class="nc-messenger-footer">
                        <form id="chatForm" class="nc-chat-input-wrapper">
                            <input type="text" id="chatInput" class="nc-chat-input" placeholder="Type a message..." autocomplete="off">
                            <button type="submit" class="btn-chat-send">
                                <i class="fa fa-paper-plane"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/Chat.css" />
    <style>
        .nc-messenger-header .dropdown-menu {
            padding: 0.65rem;
            min-width: 200px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            background: #1a1d21 !important;
            border: 1px solid var(--nc-border) !important;
        }

        .nc-messenger-header .dropdown-item, 
        #utPortalTrigger .dropdown-item {
            border-radius: var(--nc-radius-sm);
            padding: 0.6rem 0.85rem;
            font-size: 0.85rem;
            font-weight: 600;
            transition: var(--transition);
        }

        .nc-messenger-header .dropdown-item.text-danger,
        #utPortalTrigger .dropdown-item.text-danger {
            color: #ff8a80 !important;
        }

        .nc-messenger-header .dropdown-item.text-danger:hover,
        #utPortalTrigger .dropdown-item.text-danger:hover {
            background: rgba(255, 152, 152, 0.1) !important;
            color: #ff9b9bff !important;
        }

        .nc-messenger-header .dropdown-item i {
            font-size: 0.95rem;
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        let currentRoomId = null;
        let isDraftMode = false;
        let draftData = null;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        async function start() {
            try {
                await connection.start();
                console.log("SignalR Connected.");
                await connection.invoke("JoinSupportGroup");
                
                @if (ViewBag.DraftCustomerId != null) {
                    <text>showDraft('@ViewBag.DraftCustomerId', '@ViewBag.DraftSubject', '@ViewBag.DraftCustomerName');</text>
                } else if (ViewBag.ActiveRoomId != null) {
                    <text>
                        const roomId = @ViewBag.ActiveRoomId;
                        const roomItem = document.getElementById(`room-item-${roomId}`);
                        if (roomItem) {
                            roomItem.click();
                        }
                    </text>
                }
            } catch (err) {
                console.log(err);
                setTimeout(start, 5000);
            }
        };

        let typingTimeout;
        function sendTypingStatus(isTyping) {
            if (currentRoomId && !isDraftMode) {
                connection.invoke("SendTypingStatus", currentRoomId, isTyping).catch(err => console.error(err));
            }
        }

        connection.on("ReceiveTypingStatus", function (data) {
            if (data.roomId === currentRoomId && data.senderId !== '@UserManager.GetUserId(User)') {
                const indicator = document.getElementById('typingIndicator');
                const nameSpan = document.getElementById('typingName');
                if (data.isTyping) {
                    nameSpan.innerText = data.senderName;
                    indicator.style.display = 'block';
                    scrollToBottom();
                } else {
                    indicator.style.display = 'none';
                }
            }
        });

        connection.on("ReceiveMessage", function (message) {
            if (message.roomId === currentRoomId) {
                appendMessage(message);
                scrollToBottom();
            }
        });

        connection.on("UpdateInbox", function (data) {
            let roomItem = document.getElementById(`room-item-${data.roomId}`);
            const inbox = document.getElementById('inboxList');
            
            if (!roomItem && inbox) {
                const div = document.createElement('div');
                div.className = 'nc-inbox-item';
                div.id = `room-item-${data.roomId}`;
                div.onclick = () => loadChat(data.roomId, data.subject, data.customerName);
                div.innerHTML = `
                    <div class="nc-inbox-avatar">${data.customerName[0].toUpperCase()}</div>
                    <div class="nc-inbox-info">
                        <div class="nc-inbox-subject text-truncate">${data.subject}</div>
                        <div class="nc-inbox-customer text-truncate">${data.customerName}</div>
                        <div class="nc-inbox-preview text-truncate small text-muted">${data.content}</div>
                    </div>
                `;
                inbox.prepend(div);
                
                if (typeof window.showToast === 'function') {
                    window.showToast(`New message from ${data.customerName}`, 'info');
                }
            } else if (roomItem) {
                const preview = roomItem.querySelector('.nc-inbox-preview');
                if (preview) preview.innerText = data.content;
                inbox.prepend(roomItem);
            }
        });

        async function loadChat(roomId, subject, customer) {
            currentRoomId = roomId;
            isDraftMode = false;
            
            // Update URL
            const url = new URL(window.location);
            url.searchParams.set('roomId', roomId);
            url.searchParams.delete('customerId');
            url.searchParams.delete('subject');
            window.history.pushState({}, '', url);

            document.querySelectorAll('.nc-inbox-item').forEach(el => el.classList.remove('active'));
            const roomEl = document.getElementById(`room-item-${roomId}`);
            if (roomEl) roomEl.classList.add('active');
            
            document.getElementById('chatEmptyState').style.display = 'none';
            document.getElementById('chatContent').style.display = 'flex';
            document.getElementById('activeSubject').innerText = subject;
            document.getElementById('activeCustomer').innerText = customer;
            
            if (window.innerWidth < 992) {
                document.getElementById('messenger').classList.add('show-chat');
            }

            const response = await fetch(`/support/get-messages?roomId=${roomId}`);
            const messages = await response.json();
            
            const list = document.getElementById('messageList');
            list.innerHTML = '';
            messages.forEach(appendMessage);
            scrollToBottom();

            await connection.invoke("JoinRoom", roomId);
        }

        function showDraft(customerId, subject, customerName) {
            isDraftMode = true;
            currentRoomId = null;
            draftData = { customerId, subject, customerName };

            // Update URL
            const url = new URL(window.location);
            url.searchParams.set('customerId', customerId);
            url.searchParams.set('subject', subject);
            url.searchParams.delete('roomId');
            window.history.pushState({}, '', url);

            document.querySelectorAll('.nc-inbox-item').forEach(el => el.classList.remove('active'));
            const draftEl = document.getElementById('draft-item');
            if (draftEl) draftEl.classList.add('active');

            document.getElementById('chatEmptyState').style.display = 'none';
            document.getElementById('chatContent').style.display = 'flex';
            document.getElementById('activeSubject').innerText = subject;
            document.getElementById('activeCustomer').innerText = customerName;
            document.getElementById('messageList').innerHTML = '<div class="text-center py-5 opacity-50 small"><i class="fa fa-info-circle me-2"></i>Draft mode. Your room will be created when you send the first message.</div>';
        }

        async function deleteCurrentRoom(element) {
            if (isDraftMode) {
                window.showSidePopup(element, "Discard Draft?", () => {
                    document.getElementById('draft-item')?.remove();
                    document.getElementById('chatContent').style.display = 'none';
                    document.getElementById('chatEmptyState').style.display = 'flex';
                    
                    // Reset URL
                    const url = new URL(window.location);
                    url.search = '';
                    window.history.pushState({}, '', url);
                }, "fa-trash-can", "Discard", "var(--nc-error)", "", "btn-danger");
                return;
            }

            if (!currentRoomId) return;

            window.showSidePopup(element, "Delete Chat?", async () => {
                try {
                    const response = await fetch('/support/DeleteRoom', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `roomId=${currentRoomId}`
                    });
                    if (response.ok) {
                        document.getElementById(`room-item-${currentRoomId}`)?.remove();
                        document.getElementById('chatContent').style.display = 'none';
                        document.getElementById('chatEmptyState').style.display = 'flex';
                        currentRoomId = null;
                        
                        // Reset URL
                        const url = new URL(window.location);
                        url.search = '';
                        window.history.pushState({}, '', url);

                        if (typeof window.showToast === 'function') {
                            window.showToast("Conversation deleted.", "info");
                        }
                    }
                } catch (err) {
                    console.error(err);
                }
            }, "fa-trash-can", "Delete", "var(--nc-error)", "", "btn-danger");
        }

        function appendMessage(msg) {
            const list = document.getElementById('messageList');
            const div = document.createElement('div');
            const isMe = msg.senderId === '@UserManager.GetUserId(User)';
            
            div.className = `nc-message ${isMe ? 'sent' : 'received'}`;
            
            let senderHtml = '';
            if (!isMe) {
                senderHtml = `<div class="nc-message-sender">${msg.senderName}</div>`;
            } else {
                // For staff side, even sent messages should show "You (Name)" if we want
                senderHtml = `<div class="nc-message-sender">You</div>`;
            }

            const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            div.innerHTML = `
                ${senderHtml}
                <div class="nc-message-bubble">
                    ${msg.content}
                    <div class="nc-message-time">${time}</div>
                </div>
            `;
            list.appendChild(div);
        }

        function scrollToBottom() {
            const list = document.getElementById('messageList');
            list.scrollTop = list.scrollHeight;
        }

        function toggleMobileSidebar() {
            document.getElementById('messenger').classList.remove('show-chat');
        }

        document.getElementById('chatForm').addEventListener('submit', async function (e) {
            e.preventDefault();
            const input = document.getElementById('chatInput');
            const content = input.value.trim();
            if (!content) return;

            if (isDraftMode) {
                // Create room first
                const response = await fetch('/support/CreateRoom', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `customerId=${draftData.customerId}&subject=${encodeURIComponent(draftData.subject)}`
                });
                const result = await response.json();
                if (result.success) {
                    currentRoomId = result.id;
                    isDraftMode = false;
                    document.getElementById('draft-item')?.remove();
                    document.getElementById('messageList').innerHTML = ''; 

                    // Update URL
                    const url = new URL(window.location);
                    url.searchParams.set('roomId', result.id);
                    url.searchParams.delete('customerId');
                    url.searchParams.delete('subject');
                    window.history.pushState({}, '', url);
                } else {
                    return;
                }
            }
            
            if (content && currentRoomId) {
                input.value = '';
                sendTypingStatus(false);
                await connection.invoke("SendMessage", currentRoomId, content);
            }
        });

        document.getElementById('chatInput').addEventListener('input', function() {
            sendTypingStatus(true);
            clearTimeout(typingTimeout);
            typingTimeout = setTimeout(() => sendTypingStatus(false), 10000);
        });

        document.getElementById('chatInput').addEventListener('blur', function() {
            sendTypingStatus(false);
        });

        document.getElementById('chatInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('chatForm').dispatchEvent(new Event('submit'));
            }
        });

        // Search functionality
        document.getElementById('inboxSearch').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.nc-inbox-item').forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(term) ? 'flex' : 'none';
            });
        });

        // Auto-open room if requested
        $(document).ready(function() {
            const activeRoomId = '@ViewBag.ActiveRoomId';
            if (activeRoomId) {
                const roomItem = document.getElementById(`room-item-${activeRoomId}`);
                if (roomItem) {
                    roomItem.click();
                }
            }
        });

        start();
    </script>
}
