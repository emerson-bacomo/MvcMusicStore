@model MvcMusic.ViewModels.ResetPasswordViewModel
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject IOptions<IdentityOptions> IdentityOptions
@{
    ViewData["Title"] = "Change Temporary Password";
    Layout = "_Layout";
}

<div class="nc-page" style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - var(--nc-nav-height, 80px)); padding-top: 2rem; padding-bottom: 2rem;">
    <div class="nc-container" style="max-width: 500px; width: 100%;">
        <div class="nc-page-header text-center">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-lock me-1"></i> Security Update</div>
                <h1 class="nc-page-title">Change Temporary Password</h1>
                <p class="nc-page-subtitle">For your security, you must change your temporary password before proceeding.</p>
            </div>
        </div>

        <div class="nc-card nc-form-card" style="overflow: visible !important;">
            <div class="nc-card-body" style="overflow: visible !important;">
                <form asp-action="ChangeTemporaryPassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="nc-validation-summary"></div>

                    <div class="nc-floating-group nc-password-wrapper">
                        <input type="password" name="newPassword" id="newPassword" class="nc-floating-control nc-password-strength" placeholder=" " required 
                               data-val-password-min="@IdentityOptions.Value.Password.RequiredLength"
                               data-val-password-uppercase="@IdentityOptions.Value.Password.RequireUppercase.ToString().ToLower()"
                               data-val-password-lowercase="@IdentityOptions.Value.Password.RequireLowercase.ToString().ToLower()"
                               data-val-password-digit="@IdentityOptions.Value.Password.RequireDigit.ToString().ToLower()"
                               data-val-password-special="@IdentityOptions.Value.Password.RequireNonAlphanumeric.ToString().ToLower()"
                               data-label="New Password" autocomplete="new-password" />
                        <label class="nc-floating-label" for="newPassword">
                            <i class="fa fa-lock me-1"></i> New Password
                        </label>
                    </div>

                    <div class="nc-floating-group nc-password-wrapper mb-4">
                        <input type="password" id="confirmPassword" class="nc-floating-control" placeholder=" " required 
                               data-compare="#newPassword" data-val-equalto="Passwords do not match."
                               data-label="Confirm New Password" autocomplete="new-password" />
                        <label class="nc-floating-label" for="confirmPassword">
                            <i class="fa fa-shield me-1"></i> Confirm New Password
                        </label>
                    </div>

                    <button type="submit" id="submitBtn" class="btn-nc-primary w-100" style="padding:0.75rem; border-radius:var(--nc-radius-sm);">
                        <i class="fa fa-check-circle me-2"></i> Update Password & Continue
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Validation is handled by ValidationEngine.js *@
}
