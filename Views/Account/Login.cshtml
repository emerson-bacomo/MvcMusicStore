@model MvcMusic.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
    ViewBag.FormTitle = "Welcome back";
    ViewBag.FormSubtitle = "Sign in to continue your musical journey";
}

<form asp-action="Login" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    <div asp-validation-summary="All" class="nc-validation-summary" 
         style="@(ViewData.ModelState.IsValid ? "display:none" : "margin-bottom: 2rem;")"></div>

    <nc-floating-input label="Email or Username" icon="fa fa-user">
        <input asp-for="Email" class="nc-floating-control" placeholder=" " />
    </nc-floating-input>

    <nc-floating-input label="Password" icon="fa fa-lock" class="nc-password-wrapper">
        <input asp-for="Password" class="nc-floating-control" type="password" placeholder=" " autocomplete="current-password" />
    </nc-floating-input>

    <div class="nc-form-group d-flex justify-content-between align-items-center" style="margin-bottom: 1.5rem;">
        <label class="nc-checkbox" style="cursor: pointer;">
            <input asp-for="RememberMe" type="checkbox" 
                   style="accent-color: var(--nc-primary);" />
            <span style="color: var(--nc-text-secondary);
                         font-size: 0.85rem;
                         margin-left: 0.5rem;">Remember me</span>
        </label>
    </div>

    <button type="submit" class="btn-nc-primary" 
            style="padding: 0.85rem;
                   font-weight: 700;
                   border-radius: var(--nc-radius-sm);
                   width: 100%;">
        <i class="fa fa-right-to-bracket me-1"></i> Login
    </button>
</form>

<div class="nc-auth-divider">or</div>

<p style="text-align: center;
          font-size: 0.85rem;
          color: var(--nc-text-secondary);">
    New to NightCord?
    <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]"
       style="color: var(--nc-primary);
              font-weight: 600;">
        Register
    </a>
</p>

@section FooterLinks {
    <p style="text-align: center;
              font-size: 0.8rem;
              margin-bottom: 0;">
        <a href="javascript:history.back()" 
           style="color: var(--nc-text-muted);">
            <i class="fa fa-arrow-left me-1"></i> Back
        </a>
    </p>
}


