@model MvcMusic.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="nc-page">
    <div class="nc-container" style="max-width: 500px;">
        <div class="nc-page-header text-center">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-lock me-1"></i> Security Update</div>
                <h1 class="nc-page-title">Change Your Password</h1>
                <p class="nc-page-subtitle">For your security, you must change your temporary password before proceeding.</p>
            </div>
        </div>

        <div class="nc-card nc-form-card">
            <div class="nc-card-body">
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="nc-validation-summary"></div>

                    <div class="nc-floating-group nc-password-wrapper">
                        <input type="password" name="newPassword" id="newPassword" class="nc-floating-control" placeholder=" " required data-val-length-min="6" data-label="New Password" autocomplete="new-password" />
                        <label class="nc-floating-label" for="newPassword">
                            <i class="fa fa-lock me-1"></i> New Password
                        </label>
                    </div>

                    <div class="nc-floating-group nc-password-wrapper mb-4">
                        <input type="password" id="confirmPassword" class="nc-floating-control" placeholder=" " required data-label="Confirm New Password" autocomplete="new-password" />
                        <label class="nc-floating-label" for="confirmPassword">
                            <i class="fa fa-shield me-1"></i> Confirm New Password
                        </label>
                    </div>

                    <button type="submit" id="submitBtn" class="btn-nc-primary w-100" style="padding:0.75rem; border-radius:var(--nc-radius-sm);">
                        <i class="fa fa-check-circle me-2"></i> Update Password & Continue
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const pass = document.getElementById('newPassword');
            const confirm = document.getElementById('confirmPassword');
            const submit = document.getElementById('submitBtn');

            function validate() {
                const isMatch = pass.value === confirm.value;
                const hasValue = confirm.value.length > 0;
                
                if (hasValue && !isMatch) {
                    window.ValidationEngine.setError(confirm, "Passwords do not match.");
                    submit.disabled = true;
                } else {
                    window.ValidationEngine.setError(confirm, "");
                    submit.disabled = !isMatch || pass.value.length < 6;
                }
            }

            pass.addEventListener('input', validate);
            confirm.addEventListener('input', validate);
        });
    </script>
}
