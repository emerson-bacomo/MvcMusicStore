@model MvcMusic.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Join NightCord";
    Layout = "_AuthLayout";
    ViewBag.FormTitle = "Create Account";
    ViewBag.FormSubtitle = "Start your musical journey with NightCord";
}

<form asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="nc-validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="nc-form-group">
        <label class="nc-label" asp-for="UserName">
            <i class="fa fa-user me-1"></i> Username
        </label>
        <input asp-for="UserName" class="nc-input" placeholder="Choose a username" />
        <span asp-validation-for="UserName" class="nc-validation-error"></span>
    </div>

    <div class="nc-form-group">
        <label class="nc-label" asp-for="Email">
            <i class="fa fa-envelope me-1"></i> Email Address
        </label>
        <input asp-for="Email" class="nc-input" type="email" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="nc-validation-error"></span>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="nc-form-group">
                <label class="nc-label" asp-for="Password">
                    <i class="fa fa-lock me-1"></i> Password
                </label>
                <input asp-for="Password" class="nc-input" type="password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="nc-validation-error"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="nc-form-group">
                <label class="nc-label" asp-for="ConfirmPassword">
                    <i class="fa fa-shield me-1"></i> Confirm
                </label>
                <input asp-for="ConfirmPassword" class="nc-input" type="password" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="nc-validation-error"></span>
            </div>
        </div>
    </div>

    <button type="submit" class="btn-nc-primary" style="padding:0.85rem; font-weight:700; border-radius:var(--nc-radius-sm); width:100%; margin-top:1rem;">
        <i class="fa fa-user-plus me-1"></i> Create Account
    </button>
</form>

<p style="text-align:center;font-size:0.85rem;color:var(--nc-text-secondary); margin-top:2rem;">
    Already have an account?
    <a asp-controller="Account" asp-action="Login" style="color:var(--nc-primary);font-weight:600;">
        Log In
    </a>
</p>

@section FooterLinks {
    <p style="text-align:center;font-size:0.8rem;margin-bottom:0;">
        <a asp-controller="Home" asp-action="Index" style="color:var(--nc-text-muted);">
            <i class="fa fa-arrow-left me-1"></i> Back to Home
        </a>
    </p>
}
