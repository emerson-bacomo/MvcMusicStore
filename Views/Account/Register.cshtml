    @model MvcMusic.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
    ViewBag.FormTitle = "Register";
    ViewBag.FormSubtitle = "Start your musical journey with NightCord";
}

<form asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    <div asp-validation-summary="All" class="nc-validation-summary" 
         style="@(ViewData.ModelState.IsValid ? "display:none" : "margin-bottom: 2rem;")"></div>

    <nc-floating-input label="First Name" icon="fa fa-user">
        <input asp-for="FirstName" class="nc-floating-control" placeholder=" " />
    </nc-floating-input>

    <nc-floating-input label="Last Name" icon="fa fa-user">
        <input asp-for="LastName" class="nc-floating-control" placeholder=" " />
    </nc-floating-input>

    <div class="mb-4">
        <nc-floating-input label="Email Address" icon="fa fa-envelope">
            <input asp-for="Email" class="nc-floating-control" type="email" placeholder=" " data-ajax-url="@Url.Action("IsEmailAvailable", "Account")" />
        </nc-floating-input>
    </div>

    <nc-floating-input label="Password" icon="fa fa-lock" class="nc-password-wrapper">
        <input asp-for="Password" class="nc-floating-control nc-password-strength" type="password" placeholder=" " autocomplete="new-password" id="Password" />
    </nc-floating-input>

    <nc-floating-input label="Confirm Password" icon="fa fa-shield" class="nc-password-wrapper">
        <input asp-for="ConfirmPassword" class="nc-floating-control" type="password" placeholder=" " autocomplete="off" data-compare="#Password" />
    </nc-floating-input>

    <button type="submit" class="btn-nc-primary" 
            style="padding: 0.85rem;
                   font-weight: 700;
                   border-radius: var(--nc-radius-sm);
                   width: 100%;
                   margin-top: 1rem;">
        <i class="fa fa-user-plus me-1"></i> Register
    </button>
</form>

<p style="text-align: center;
          font-size: 0.85rem;
          color: var(--nc-text-secondary);
          margin-top: 2rem;">
    Already have an account?
    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]"
       style="color: var(--nc-primary);
              font-weight: 600;">
        Login
    </a>
</p>

@section FooterLinks {
    <p style="text-align: center;
              font-size: 0.8rem;
              margin-bottom: 0;">
        <a href="javascript:history.back()" 
           style="color: var(--nc-text-muted);">
            <i class="fa fa-arrow-left me-1"></i> Back
        </a>
    </p>
}


