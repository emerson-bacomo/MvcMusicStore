@{
    ViewData["Title"] = "Category Management";
}

<div class="nc-page">
    <div class="nc-container-fluid">
        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">Category Management</h1>
                <p class="nc-page-subtitle">Organize your instruments into logical groupings.</p>
            </div>
            <div class="nc-page-actions">
                <button type="button" class="btn-nc-primary nc-btn-featured" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                    <i class="fa fa-plus me-2"></i> New Category
                </button>
            </div>
        </div>

        <div id="categories-table"></div>
    </div>
</div>

<!-- Create Category Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content nc-card" style="border:1px solid var(--nc-border); background: #131822 !important; border-radius: 12px; overflow: hidden;">
            <div class="modal-header border-0 pb-0" style="padding: 1.5rem 1.5rem 0 1.5rem;">
                <h5 class="modal-title nc-page-title fs-5"><i class="fa fa-layer-group me-2" style="color: #9ac5f4;"></i> Create New Category</h5>
                <button type="button" class="ms-auto btn-close-custom" data-bs-dismiss="modal" aria-label="Close" style="background: transparent; border: none; color: var(--nc-text-muted); font-size: 1.2rem;">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3" style="margin-bottom: 0 !important;">
                        <label class="form-label" style="color: var(--nc-text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">Category Name</label>
                        <input type="text" name="name" id="categoryNameInput" class="nc-input" required placeholder="Enter category name...">
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 p-4">
                    <button type="button" class="btn-nc-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-nc-primary px-4">
                        <i class="fa fa-plus me-1"></i> Create Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const modal = document.getElementById('createCategoryModal');
        if (modal) {
            modal.addEventListener('shown.bs.modal', function () {
                document.getElementById('categoryNameInput').focus();
            });
        }
    });
</script>



@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
}

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';
        
        document.addEventListener('DOMContentLoaded', function() {
            const table = new UpdatableTable('#categories-table', {
                label: '',
                storagePrefix: 'category',
                request: {
                    url: '@Url.Action("GetTableData", "Categories")',
                    type: 'GET'
                },
                fieldDefinitions: {
                    name: { label: 'Category Name', widthPercentage: '25%', widthMinimum: '200px' },
                    productCount: { 
                        label: 'Products',
                        renderContent: (val, col, rowData) => `
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold nc-text-primary" style="font-size: 1.1rem; min-width: 20px;">${val}</span>
                                <a href="/Products/Index?categoryId=${rowData.id}" class="btn-nc-outline d-inline-flex align-items-center" style="font-size:0.75rem; padding: 0 0.8rem; height: 32px; white-space: nowrap;">
                                    <i class="fa fa-eye me-1" style="font-size: 0.75rem;"></i> <span style="line-height: 1;">View Products</span>
                                </a>
                            </div>
                        `
                    },
                    actions: {
                        label: 'Actions',
                        widthPercentage: '1%',
                        spanStyle: 'padding: 0; display: flex; justify-content: flex-start;',
                        renderContent: function(value, col, rowData) {
                            return `
                                <div class="nc-action-group justify-content-start">
                                    <button type="button" class="nc-action-link delete" title="Delete" 
                                            onclick="window.updatableTables['categories-table'].confirmDelete('${rowData.id}', '@Url.Action("Delete", "Categories")', this)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                },
                onSave: function() {
                    window.location.reload();
                }
            });
        });
    </script>
}
