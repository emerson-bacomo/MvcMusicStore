@model List<MvcMusic.Models.ApplicationUser>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="nc-page">
    <div class="container-fluid px-4">
        @if (TempData["Success"] != null)
        {
            <div class="nc-alert nc-alert-success"><i class="fa fa-circle-check"></i> @TempData["Success"]</div>
        }

        <div class="nc-page-header">
            <div>
                <div class="nc-breadcrumb"><i class="fa fa-users"></i> Admin Panel</div>
                <h1 class="nc-page-title">Customer Management</h1>
                <p class="nc-page-subtitle">Handle your registered customer base</p>
            </div>
        </div>

        <div id="customers-table-container"></div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
    <style>
        .cust-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--nc-border); }
        .cust-avatar-placeholder { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,183,77,0.15); color: #ffb74d; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 800; border: 1.5px solid var(--nc-border); }
        
        .cust-badge { font-size: 0.73rem; padding: 0.2rem 0.7rem; border-radius: 100px; font-weight: 700; display: inline-block; }
        .cust-badge.active { background: rgba(129,199,132,0.1); color: #81c784; border: 1px solid rgba(129,199,132,0.2); }
        .cust-badge.banned { background: rgba(229,115,115,0.1); color: #e57373; border: 1px solid rgba(229,115,115,0.2); }

        .nc-action-link { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--nc-text-muted); transition: all 0.25s; border: 1px solid var(--nc-border); }
        .nc-action-link:hover { background: var(--nc-primary); color: #fff; transform: translateY(-2px); border-color: var(--nc-primary); }
        .nc-action-link.delete:hover { background: #e57373; border-color: #e57373; }
        .nc-action-link.enable:hover { background: #81c784; border-color: #81c784; }
    </style>
}

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';

        const table = new UpdatableTable('#customers-table-container', {
            label: 'Customers',
            request: {
                url: '@Url.Action("GetTableData", "Customers")',
                type: 'GET'
            },
            fieldDefinitions: {
                customer: {
                    label: 'Customer',
                    renderContent: (val, col, row) => `
                        <div class="d-flex align-items-center gap-2">
                            ${row.profilePicture ? `<img src="${row.profilePicture}" class="cust-avatar" />` : `<div class="cust-avatar-placeholder">${val.charAt(0).toUpperCase()}</div>`}
                            <div style="font-weight:600;">${val}</div>
                        </div>
                    `
                },
                username: {
                    label: 'Username',
                    renderContent: (val) => `<span style="color:var(--nc-text-muted); font-size:0.85rem;">${val}</span>`
                },
                email: {
                    label: 'Email',
                    renderContent: (val) => `<span style="color:var(--nc-text-secondary); font-size:0.9rem;">${val}</span>`
                },
                status: {
                    label: 'Status',
                    renderContent: (val) => {
                        const css = val === 'Active' ? 'active' : 'banned';
                        const icon = val === 'Active' ? 'fa-circle-check' : 'fa-ban';
                        return `<span class="cust-badge ${css}"><i class="fa ${icon} me-1"></i>${val}</span>`;
                    }
                },
                joined: {
                    label: 'Joined',
                    renderContent: (val) => `<span style="color:var(--nc-text-muted); font-size:0.8rem;">${val}</span>`
                },
                actions: {
                    label: 'Actions',
                    renderContent: (val, col, row) => `
                        <div class="d-flex gap-2 justify-content-end">
                            <a href="/Customers/Profile/${row.id}" class="nc-action-link" title="View Profile"><i class="fa fa-eye"></i></a>
                            <form action="/Customers/ToggleBan/${row.id}" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nc-action-link ${row.isDisabled ? 'enable' : 'delete'}" title="${row.isDisabled ? 'Unban' : 'Ban'}">
                                    <i class="fa ${row.isDisabled ? 'fa-circle-play' : 'fa-ban'}"></i>
                                </button>
                            </form>
                        </div>
                    `
                }
            }
        });
    </script>
}
