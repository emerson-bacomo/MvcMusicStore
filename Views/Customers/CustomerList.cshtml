@model List<MvcMusic.Models.ApplicationUser>

@{
    ViewData["Title"] = "Customer Management";
}

<div class="nc-page">
    <div class="container-fluid px-4">
        @if (TempData["Success"] != null)
        {
            <div class="nc-alert nc-alert-success"><i class="fa fa-circle-check"></i> @TempData["Success"]</div>
        }

        <div class="nc-page-header">
            <div>
                <div style="color:var(--nc-text-muted);font-size:0.8rem;margin-bottom:0.25rem;"><i class="fa fa-users me-1"></i> Admin Panel</div>
                <h1 class="nc-page-title">Customer Management</h1>
                <p style="color:var(--nc-text-muted);font-size:0.88rem;margin-top:0.25rem;">@Model.Count registered customer accounts</p>
            </div>
        </div>

        <div class="nc-card">
            <div class="nc-card-body p-0">
                @if (!Model.Any())
                {
                    <div style="text-align:center;padding:3rem;color:var(--nc-text-muted);">
                        <i class="fa fa-users-slash" style="font-size:2.5rem;display:block;margin-bottom:1rem;"></i>
                        <p>No customers registered yet.</p>
                    </div>
                }
                else
                {
                    <div class="nc-table-responsive">
                        <table class="nc-table">
                            <thead>
                                <tr>
                                    <th><i class="fa fa-user me-1"></i> Customer</th>
                                    <th><i class="fa fa-at me-1"></i> Username</th>
                                    <th><i class="fa fa-envelope me-1"></i> Email</th>
                                    <th><i class="fa fa-circle me-1"></i> Status</th>
                                    <th><i class="fa fa-calendar me-1"></i> Joined</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr class="@(c.IsDisabled ? "row-disabled" : "")">
                                        <td>
                                            <div class="emp-name-cell">
                                                @if (!string.IsNullOrEmpty(c.ProfilePicture))
                                                {
                                                    <img src="@c.ProfilePicture" class="emp-avatar" />
                                                }
                                                else
                                                {
                                                    <div class="emp-avatar-placeholder">@((c.FirstName?.FirstOrDefault() ?? c.UserName?.FirstOrDefault() ?? '?').ToString().ToUpper())</div>
                                                }
                                                <div>
                                                    <div style="font-weight:600;">@(string.IsNullOrWhiteSpace(c.FullName.Trim()) ? c.UserName : c.FullName)</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="color:var(--nc-text-muted);font-size:0.85rem;">@c.UserName</td>
                                        <td style="color:var(--nc-text-secondary);font-size:0.9rem;">@c.Email</td>
                                        <td>
                                            @if (c.IsDisabled)
                                            {
                                                <span class="cust-badge banned"><i class="fa fa-ban me-1"></i>Banned</span>
                                            }
                                            else
                                            {
                                                <span class="cust-badge active"><i class="fa fa-circle-check me-1"></i>Active</span>
                                            }
                                        </td>
                                        <td style="color:var(--nc-text-muted);font-size:0.8rem;">@c.DateCreated.ToString("MMM d, yyyy")</td>
                                        <td class="text-end">
                                            <div class="nc-action-group">
                                                <a asp-action="Profile" asp-route-id="@c.Id" class="nc-action-link" title="View Profile"><i class="fa fa-eye"></i></a>
                                                <form asp-action="ToggleBan" asp-route-id="@c.Id" method="post" style="display:inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="nc-action-link @(c.IsDisabled ? "enable" : "delete")" title="@(c.IsDisabled ? "Unban" : "Ban")">
                                                        <i class="fa @(c.IsDisabled ? "fa-circle-play" : "fa-ban")"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .nc-table-responsive { overflow-x: auto; }
    .nc-card-body.p-0 { padding: 0; }
    .emp-name-cell { display: flex; align-items: center; gap: 0.75rem; }
    .emp-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; border: 1.5px solid var(--nc-border); }
    .emp-avatar-placeholder { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,183,77,0.15); color: #ffb74d; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 800; border: 1.5px solid var(--nc-border); flex-shrink: 0; }
    .cust-badge { font-size: 0.73rem; padding: 0.2rem 0.7rem; border-radius: 100px; font-weight: 700; display: inline-block; }
    .cust-badge.active { background: rgba(129,199,132,0.1); color: #81c784; border: 1px solid rgba(129,199,132,0.2); }
    .cust-badge.banned { background: rgba(229,115,115,0.1); color: #e57373; border: 1px solid rgba(229,115,115,0.2); }
    .row-disabled td { opacity: 0.5; }
    .nc-action-group { display: flex; gap: 0.5rem; justify-content: flex-end; }
    .nc-action-link { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--nc-bg-secondary); color: var(--nc-text-secondary); transition: all 0.25s; border: 1px solid var(--nc-border); cursor: pointer; font-size: 0.85rem; }
    .nc-action-link:hover { background: var(--nc-primary); color: #fff; transform: translateY(-2px); border-color: var(--nc-primary); }
    .nc-action-link.delete { color: #e57373; }
    .nc-action-link.delete:hover { background: #e57373; border-color: #e57373; color: #fff; }
    .nc-action-link.enable:hover { background: #81c784; border-color: #81c784; color: #fff; }
</style>
