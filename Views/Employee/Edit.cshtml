@model MvcMusic.ViewModels.EmployeeEditViewModel

@{
    ViewData["Title"] = "Edit Employee";
    var isSuperAdmin = ViewBag.IsSuperAdmin == true;
    var allRoles = new[] { "Admin", "StockStaff", "ProductStaff", "SalesStaff", "CustomerStaff", "SuperAdmin" };
    var roles = isSuperAdmin ? allRoles : new[] { "StockStaff", "ProductStaff", "SalesStaff", "CustomerStaff" };
}

<div class="nc-page">
    <div class="nc-container">

        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">Edit Employee</h1>
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <span class="emp-code-display">@Model.UserName</span>
                }
            </div>
        </div>

        <div class="nc-card nc-form-card">
            <div class="nc-card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4" style="font-size:0.9rem; font-weight:600; padding:1rem; background:rgba(229,115,115,0.05); border:1px solid rgba(229,115,115,0.2); border-radius:8px;"></div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Account Identity (Read-only)</div>
                        <div class="nc-form-group">
                            <label class="nc-label">Username</label>
                            <input value="@Model.UserName" class="nc-input opacity-75" readonly style="cursor:not-allowed;" id="UsernamePreviewField" />
                            <small class="nc-text-muted" style="font-size:0.75rem;">Username cannot be changed directly. It will automatically update if the role changes.</small>
                        </div>
                    </div>

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Personal Information</div>
                        <div class="nc-form-grid">
                            <div class="mb-3">
                                <nc-floating-input label="First Name" icon="fa fa-user" bg="#11141aff">
                                    <input asp-for="FirstName" class="nc-floating-control" placeholder=" " />
                                </nc-floating-input>
                            </div>
                            <div class="mb-3">
                                <nc-floating-input label="Last Name" icon="fa fa-user" bg="#11141aff">
                                    <input asp-for="LastName" class="nc-floating-control" placeholder=" " />
                                </nc-floating-input>
                            </div>
                            <div class="mb-3" style="grid-column: 1 / -1;">
                                <nc-floating-input label="Email Address" icon="fa fa-envelope" bg="#11141aff">
                                    <input asp-for="Email" class="nc-floating-control" type="email" placeholder=" " />
                                </nc-floating-input>
                            </div>
                            <div class="nc-form-group">
                                <label asp-for="Role" class="nc-label"></label>
                                <select asp-for="Role" class="nc-input nc-select">
                                    @foreach (var r in roles)
                                    {
                                        if (r == Model.Role)
                                        {
                                            <option value="@r" selected>@r</option>
                                        }
                                        else
                                        {
                                            <option value="@r">@r</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Role" class="nc-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn-nc-primary" style="padding:0.75rem 2rem;border-radius:var(--nc-radius-sm);">
                            <i class="fa fa-floppy-disk me-2"></i> Save Changes
                        </button>
                        <a href="javascript:history.back()" class="btn-nc-outline" style="padding:0.75rem 1.5rem;border-radius:var(--nc-radius-sm);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .emp-code-display {
            font-size: 0.9rem;
            color: var(--nc-primary);
            background: rgba(123, 171, 221, 0.1);
            padding: 0.3rem 0.8rem;
            border-radius: 6px;
            font-weight: 700;
            display: inline-block;
            margin-top: 0.5rem;
        }

        .nc-select option {
            background: var(--nc-bg-card);
            color: var(--nc-text-primary);
        }
    </style>
}

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
    <script>
        document.getElementById('Role')?.addEventListener('change', async function() {
            const role = this.value;
            const res = await fetch(`/Employee/GetPreviewUsername?role=${encodeURIComponent(role)}`);
            const data = await res.json();
            if (data && data.username) {
                document.getElementById('UsernamePreviewField').value = data.username;
            }
        });
    </script>
}
