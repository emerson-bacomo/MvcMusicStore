@model MvcMusic.ViewModels.EmployeeCreateViewModel

@{
    ViewData["Title"] = "Add Employee";
    var roles = new[] { "Admin", "Staff" };
}

<div class="nc-page">
    <div class="nc-container">
        <div class="mb-4">
            <a href="javascript:history.back()" class="btn-nc-outline" style="padding:0.5rem 1rem;border-radius:var(--nc-radius-sm);">
                <i class="fa fa-arrow-left me-1"></i> Back
            </a>
        </div>

        <div class="nc-page-header">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-user-plus me-1"></i> SuperAdmin Panel</div>
                <h1 class="nc-page-title">Add Employee</h1>
            </div>
        </div>

        <div class="nc-card nc-form-card">
            <div class="nc-card-body">
                <asp-validation-summary class="nc-validation-summary" model-only="false"></asp-validation-summary>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Personal Information</div>
                        <div class="nc-form-grid">
                            <div class="nc-form-group">
                                <label asp-for="FirstName" class="nc-label"></label>
                                <input asp-for="FirstName" class="nc-input" placeholder="First name" />
                                <span asp-validation-for="FirstName" class="nc-validation-error"></span>
                            </div>
                            <div class="nc-form-group">
                                <label asp-for="LastName" class="nc-label"></label>
                                <input asp-for="LastName" class="nc-input" placeholder="Last name" />
                                <span asp-validation-for="LastName" class="nc-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Account Details</div>
                        <div class="nc-form-grid">
                            <div class="nc-form-group">
                                <label asp-for="Email" class="nc-label"></label>
                                <input asp-for="Email" type="email" class="nc-input" placeholder="email@example.com" />
                                <span asp-validation-for="Email" class="nc-validation-error"></span>
                            </div>
                            <div class="nc-form-group">
                                <label asp-for="Role" class="nc-label"></label>
                                <select asp-for="Role" class="nc-input nc-select">
                                    <option value="">— Select Role —</option>
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                                <div class="nc-text-muted mt-2" style="font-size:0.8rem;">
                                    <div id="role-desc-Admin" class="role-desc" style="display:none;">
                                        <i class="fa fa-shield-halved me-1 nc-text-primary"></i> <strong>Admin:</strong> Full CRUD authority (Create, Read, Update, Delete) for products and customer management.
                                    </div>
                                    <div id="role-desc-Staff" class="role-desc" style="display:none;">
                                        <i class="fa fa-user-pen me-1" style="color:#81c784;"></i> <strong>Staff:</strong> Update authority only (Restock, change prices, update descriptions, Manage banners). Cannot create or delete products.
                                    </div>
                                </div>
                                <span asp-validation-for="Role" class="nc-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Password</div>
                        <div class="nc-form-grid">
                            <div class="nc-form-group">
                                <label asp-for="Password" class="nc-label"></label>
                                <input asp-for="Password" type="password" class="nc-input" placeholder="Min. 6 characters" />
                                <span asp-validation-for="Password" class="nc-validation-error"></span>
                            </div>
                            <div class="nc-form-group">
                                <label asp-for="ConfirmPassword" class="nc-label"></label>
                                <input asp-for="ConfirmPassword" type="password" class="nc-input" placeholder="Repeat password" />
                                <span asp-validation-for="ConfirmPassword" class="nc-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn-nc-primary" style="padding:0.75rem 2rem;border-radius:var(--nc-radius-sm);">
                            <i class="fa fa-user-plus me-2"></i> Create Employee
                        </button>
                        <a href="javascript:history.back()" class="btn-nc-outline" style="padding:0.75rem 1.5rem;border-radius:var(--nc-radius-sm);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .nc-select option {
            background: var(--nc-bg-card);
            color: var(--nc-text-primary);
        }
    </style>
}

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
    <script>
        document.getElementById('Role').addEventListener('change', function() {
            var selectedRole = this.value;
            document.querySelectorAll('.role-desc').forEach(el => el.style.display = 'none');
            if (selectedRole) {
                var desc = document.getElementById('role-desc-' + selectedRole);
                if (desc) desc.style.display = 'block';
            }
        });
    </script>
}
