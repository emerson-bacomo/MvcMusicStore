@model MvcMusic.ViewModels.EmployeeCreateViewModel
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject IOptions<IdentityOptions> IdentityOptions

@{
    ViewData["Title"] = "Add Employee";
    var isSuperAdmin = ViewBag.IsSuperAdmin == true;
    var allRoles = new[] { "Admin", "StockStaff", "ProductStaff", "SalesStaff", "CustomerStaff", "SuperAdmin" };
    var roles = isSuperAdmin ? allRoles : new[] { "StockStaff", "ProductStaff", "SalesStaff", "CustomerStaff" };
}

<div class="nc-page">
    <div class="nc-container">

        <div class="nc-page-header">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-user-plus me-1"></i> SuperAdmin Panel</div>
                <h1 class="nc-page-title">Add Employee</h1>
            </div>
        </div>

        <div class="nc-card nc-form-card">
            <div class="nc-card-body">
                <div asp-validation-summary="All" class="nc-validation-summary" 
                     style="@(ViewData.ModelState.IsValid ? "display: none;" : "margin-bottom: 2rem;")"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Personal Information</div>
                        <div class="nc-form-grid">
                            <div class="mb-3">
                                <nc-floating-input label="First Name" icon="fa fa-user" bg="#11141aff">
                                    <input asp-for="FirstName" class="nc-floating-control" placeholder=" " />
                                </nc-floating-input>
                            </div>
                            <div class="mb-3">
                                <nc-floating-input label="Last Name" icon="fa fa-user" bg="#11141aff">
                                    <input asp-for="LastName" class="nc-floating-control" placeholder=" " />
                                </nc-floating-input>
                            </div>
                        </div>
                    </div>

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Account Details</div>
                        <div class="nc-form-grid">
                            <div class="nc-form-group">
                                <label class="nc-label" style="visibility: hidden;">Email</label>
                                <nc-floating-input label="Email Address" icon="fa fa-envelope" bg="#11141aff">
                                    <input asp-for="Email" type="email" class="nc-floating-control" placeholder=" " />
                                </nc-floating-input>
                            </div>
                            <div class="nc-form-group">
                                <label asp-for="Role" class="nc-label"></label>
                                <select asp-for="Role" class="nc-input nc-select">
                                    <option value="">— Select Role —</option>
                                    @foreach (var r in roles)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                                <div class="nc-text-muted mt-2" style="font-size:0.8rem;">
                                    <div id="role-desc-Admin" class="role-desc" style="display:none;">
                                        <i class="fa fa-shield-halved me-1 nc-text-primary"></i> <strong>Admin:</strong> Full access to all areas.
                                    </div>
                                    <div id="role-desc-StockStaff" class="role-desc" style="display:none;">
                                        <i class="fa fa-boxes-stacking me-1" style="color:#ffb74d;"></i> <strong>Stock Staff:</strong> Can only update stock quantities on the Products table.
                                    </div>
                                    <div id="role-desc-ProductStaff" class="role-desc" style="display:none;">
                                        <i class="fa fa-pen me-1" style="color:#4dd0e1;"></i> <strong>Product Staff:</strong> Can edit product name, brand, category, descriptions, and images. Also manages Brands and Categories tables.
                                    </div>
                                    <div id="role-desc-SalesStaff" class="role-desc" style="display:none;">
                                        <i class="fa fa-chart-line me-1" style="color:#ba68c8;"></i> <strong>Sales Staff:</strong> Access to Dashboard and Orders management only.
                                    </div>
                                    <div id="role-desc-CustomerStaff" class="role-desc" style="display:none;">
                                        <i class="fa fa-headset me-1" style="color:#e57373;"></i> <strong>Customer Staff:</strong> Access to Customer management and Support inbox only.
                                    </div>
                                </div>
                                <span asp-validation-for="Role" class="nc-validation-error"></span>
                            </div>
                        </div>
                    </div>

                    <div class="nc-form-section">
                        <div class="nc-form-section-title">Password Management</div>
                        <div class="nc-form-group">
                            <div class="d-flex gap-2 align-items-center">
                                <div class="flex-grow-1" style="position:relative;">
                                    <nc-floating-input label="Temporary Password" icon="fa fa-lock" class="nc-password-wrapper" bg="#11141aff">
                                        <input asp-for="Password" id="genPassword" class="nc-floating-control nc-password-strength" type="password" placeholder=" " autocomplete="new-password"
                                               data-val-password-min="@IdentityOptions.Value.Password.RequiredLength"
                                               data-val-password-uppercase="@IdentityOptions.Value.Password.RequireUppercase.ToString().ToLower()"
                                               data-val-password-lowercase="@IdentityOptions.Value.Password.RequireLowercase.ToString().ToLower()"
                                               data-val-password-digit="@IdentityOptions.Value.Password.RequireDigit.ToString().ToLower()"
                                               data-val-password-special="@IdentityOptions.Value.Password.RequireNonAlphanumeric.ToString().ToLower()" />
                                    </nc-floating-input>
                                </div>
                                <div class="d-flex gap-2" style="margin-top: 1.3rem;"> <!-- Offset for floating label height -->
                                    <button type="button" id="copyPassword" class="btn-nc-outline" style="padding:0; width:46px; height:46px; display:flex; align-items:center; justify-content:center; border-radius:var(--nc-radius-sm); flex-shrink:0;" title="Copy to Clipboard">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                    <button type="button" id="regeneratePassword" class="btn-nc-outline" style="padding:0; width:46px; height:46px; display:flex; align-items:center; justify-content:center; border-radius:var(--nc-radius-sm); flex-shrink:0;" title="Regenerate">
                                        <i class="fa fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="nc-text-muted mt-2" style="font-size:0.75rem;">
                                <i class="fa fa-info-circle me-1"></i> The user will be required to change this password upon their first login.
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn-nc-primary" style="padding:0.75rem 2rem;border-radius:var(--nc-radius-sm);">
                            <i class="fa fa-user-plus me-2"></i> Create Employee
                        </button>
                        <a asp-action="Index" class="btn-nc-outline" style="padding:0.75rem 1.5rem;border-radius:var(--nc-radius-sm);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .nc-select option {
            background: var(--nc-bg-card);
            color: var(--nc-text-primary);
        }
    </style>
}

@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
    <script>
        // Role descriptions
        document.getElementById('Role').addEventListener('change', function() {
            var selectedRole = this.value;
            document.querySelectorAll('.role-desc').forEach(el => el.style.display = 'none');
            if (selectedRole) {
                var desc = document.getElementById('role-desc-' + selectedRole);
                if (desc) desc.style.display = 'block';
            }
        });

        // Password generation
        function generateRandomPassword(length = 12) {
            // Using char code 64 for at-symbol to prevent Razor parsing issues
            const charset = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!" + String.fromCharCode(64) + "#$%^&*()_+";
            let retVal = "";
            for (let i = 0, n = charset.length; i < length; ++i) {
                retVal += charset.charAt(Math.floor(Math.random() * n));
            }
            // Ensure at least one special char and one number
            const specialChars = "!" + String.fromCharCode(64) + "#$%^&*()_+";
            const hasNumber = /[0-9]/.test(retVal);
            const hasSpecial = retVal.split('').some(c => specialChars.includes(c));

            if (!hasNumber || !hasSpecial) {
                return generateRandomPassword(length);
            }
            return retVal;
        }

        const passInput = document.getElementById('genPassword');
        const regenBtn = document.getElementById('regeneratePassword');
        const copyBtn = document.getElementById('copyPassword');

        function setPass() {
            passInput.value = generateRandomPassword();
            // Trigger input event for ValidationEngine
            passInput.dispatchEvent(new Event('input', { bubbles: true }));
        }

        setPass();
        regenBtn.addEventListener('click', setPass);

        copyBtn.addEventListener('click', function() {
            passInput.type = "text";
            passInput.select();
            passInput.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(passInput.value);
            passInput.type = "password";
            
            const icon = this.querySelector('i');
            icon.classList.remove('fa-copy');
            icon.classList.add('fa-check');
            icon.style.color = 'var(--nc-success)';
            
            setTimeout(() => {
                icon.classList.remove('fa-check');
                icon.classList.add('fa-copy');
                icon.style.color = '';
            }, 2000);
        });
    </script>
}
