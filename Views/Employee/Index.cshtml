@{
    ViewData["Title"] = "Employee Management";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="nc-page">
    <div class="container-fluid px-4">

        <div class="nc-page-header">
            <div>
                <div class="nc-breadcrumb"><i class="fa fa-user-shield"></i> SuperAdmin Panel</div>
                <h1 class="nc-page-title">Employee Management</h1>
                <p class="nc-page-subtitle">Manage Admin and Staff accounts</p>
            </div>
            <div class="d-flex gap-2 mb-2">
                <a asp-controller="ActivityLogs" asp-action="Index" asp-route-returnUrl="@currentUrl" class="btn-nc-outline" style="padding:0.6rem 1.2rem;border-radius:var(--nc-radius-sm);">
                    <i class="fa fa-list-check me-1"></i> All Logs
                </a>
                <a asp-action="Create" class="btn-nc-primary" style="padding:0.6rem 1.2rem;border-radius:var(--nc-radius-sm);">
                    <i class="fa fa-user-plus me-1"></i> Add Employee
                </a>
            </div>
        </div>

        <div id="employees-table-container"></div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
    <style>
        .emp-code {
            font-family: 'Orbitron', monospace;
            font-size: 0.7rem;
            color: var(--nc-primary);
            background: rgba(123, 171, 221, 0.1);
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-weight: 700;
            border: 1px solid rgba(123, 171, 221, 0.2);
        }

        .emp-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--nc-border);
        }

        .emp-avatar-placeholder {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(123, 171, 221, 0.15);
            color: var(--nc-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 800;
            border: 1.5px solid var(--nc-border);
        }

        .role-badge {
            font-size: 0.73rem;
            padding: 0.2rem 0.7rem;
            border-radius: 100px;
            font-weight: 700;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .role-admin {
            background: rgba(123, 171, 221, 0.15);
            color: var(--nc-primary);
            border: 1px solid rgba(123, 171, 221, 0.3);
        }

        .role-staff {
            background: rgba(129, 199, 132, 0.15);
            color: #81c784;
            border: 1px solid rgba(129, 199, 132, 0.3);
        }

        .role-superadmin {
            background: rgba(255, 183, 77, 0.15);
            color: #ffb74d;
            border: 1px solid rgba(255, 183, 77, 0.3);
        }

        .role-stockstaff {
            background: rgba(255, 183, 77, 0.1);
            color: #ffb74d;
            border: 1px solid rgba(255, 183, 77, 0.2);
        }

        .role-productstaff {
            background: rgba(77, 208, 225, 0.1);
            color: #4dd0e1;
            border: 1px solid rgba(77, 208, 225, 0.2);
        }

        .role-salesstaff {
            background: rgba(186, 104, 200, 0.1);
            color: #ba68c8;
            border: 1px solid rgba(186, 104, 200, 0.2);
        }

        .role-customerstaff {
            background: rgba(229, 115, 115, 0.1);
            color: #e57373;
            border: 1px solid rgba(229, 115, 115, 0.2);
        }

        .nc-action-link.reset:hover {
            background: var(--nc-primary);
            border-color: var(--nc-primary);
        }

        .nc-action-link {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            color: var(--nc-text-muted);
            transition: all 0.25s;
            border: 1px solid var(--nc-border);
        }

        .nc-action-link:hover {
            background: var(--nc-primary);
            color: #fff;
            transform: translateY(-2px);
            border-color: var(--nc-primary);
        }

        .nc-action-link.delete:hover {
            background: #e57373;
            border-color: #e57373;
        }

        .nc-action-link.ban:hover {
            background: #e57373;
            border-color: #e57373;
        }

        .nc-action-link.enable:hover {
            background: #81c784;
            border-color: #81c784;
        }
    </style>
}

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';

        const table = new UpdatableTable('#employees-table-container', {
            label: 'Employees',
            storagePrefix: 'employee',
            request: {
                url: '@Url.Action("GetTableData", "Employee")',
                type: 'GET'
            },
            fieldDefinitions: {
                code: {
                    label: 'Code',
                    widthPercentage: '10%',
                    renderContent: (val) => `<span class="emp-code">${val}</span>`
                },
                name: {
                    label: 'Name',
                    widthPercentage: '20%',
                    renderContent: (val, col, row) => {
                        const isYou = row.id === '@ViewBag.CurrentUserId';
                        return `
                            <div class="d-flex align-items-center gap-2">
                                ${row.profilePicture ? `<img src="${row.profilePicture}" class="emp-avatar" />` : `<div class="emp-avatar-placeholder">${row.firstName.charAt(0).toUpperCase()}</div>`}
                                <div style="font-weight:600;">
                                    ${val} ${isYou ? '<span style="color:var(--nc-primary); font-size:0.75rem; margin-left:0.25rem;">(you)</span>' : ''}
                                </div>
                            </div>
                        `;
                    }
                },
                username: {
                    label: 'Username',
                    widthPercentage: '15%',
                    renderContent: (val) => `<span style="color:var(--nc-text-muted); font-size:0.85rem;">${val}</span>`
                },
                email: {
                    label: 'Email',
                    widthPercentage: '20%',
                    renderContent: (val) => `<span style="color:var(--nc-text-secondary); font-size:0.9rem;">${val}</span>`
                },
                role: {
                    label: 'Role',
                    widthPercentage: '10%',
                    renderContent: (val) => `<span class="role-badge role-${val.toLowerCase()}">${val}</span>`
                },
                status: {
                    label: 'Status',
                    widthMinimum: '150px',
                    widthPercentage: '10%',
                    renderContent: (val) => {
                        const color = val === 'Active' ? '#81c784' : '#e57373';
                        const icon = val === 'Active' ? 'fa-circle-check' : 'fa-circle-dashed';
                        const label = val === 'Banned' ? 'Banned' : val;
                        return `<span style="color:${color}; font-size:0.8rem; font-weight:600;"><i class="fa ${icon} me-1"></i>${label}</span>`;
                    }
                },
                actions: {
                    label: 'Actions',
                    widthPercentage: '1%',
                    spanStyle: 'padding: 0; display: flex; justify-content: flex-start;',
                    renderContent: (val, col, row) => {
                        let links = `
                            <a href="/Employee/Edit/${row.id}" class="nc-action-link" title="Edit"><i class="fa fa-pen"></i></a>
                            <a href="/activity-logs?userId=${row.id}" class="nc-action-link" title="View Logs"><i class="fa fa-list-check"></i></a>
                        `;
                        
                        links += `
                            <form action="/Employee/ToggleBan/${row.id}" method="post" style="display:inline;" onsubmit="event.preventDefault(); window.confirmBan(this);" data-type="employee">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nc-action-link ${row.isBanned ? 'enable' : 'ban'}" title="${row.isBanned ? 'Unban' : 'Ban'}">
                                    <i class="fa ${row.isBanned ? 'fa-circle-check' : 'fa-ban'}"></i>
                                </button>
                            </form>
                        `;

                        if (row.id !== '@ViewBag.CurrentUserId') {
                            links += `
                                <button type="button" class="nc-action-link" title="Reset Password" onclick="window.resetStaffPassword('${row.id}', '${row.username}')" style="margin-left:0.5rem;">
                                    <i class="fa fa-key"></i>
                                </button>
                            `;
                        }

                        if (row.role !== 'SuperAdmin') {
                            if (row.recordStatus === 'Deleted') {
                                links += `
                                    <button type="button" class="nc-action-link restore border-0" title="Restore"
                                            onclick="window.updatableTables['employees-table-container'].confirmRestore('${row.id}', '@Url.Action("Restore", "Employee")', this)">
                                        <i class="fa fa-trash-restore"></i>
                                    </button>
                                `;
                            } else {
                                links += `
                                    <button type="button" class="nc-action-link delete border-0" title="Delete"
                                            onclick="window.updatableTables['employees-table-container'].confirmDelete('${row.id}', '@Url.Action("Delete", "Employee")', this)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                `;
                            }
                        }

                        return `<div class="d-flex gap-2 justify-content-start">${links}</div>`;
                    }
                }
            }
        });
    </script>

    <!-- Reset Password Result Modal -->
    <div class="modal fade" id="resetPassModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content nc-card" style="border:1px solid var(--nc-border);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title nc-page-title fs-5"><i class="fa fa-key me-2 text-primary"></i> Password Reset</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="nc-text-muted mb-4">A new temporary password has been generated for <strong id="resetTargetUser" class="text-white"></strong>.</p>
                    
                    <div class="nc-form-group mb-0">
                        <label class="nc-label">Temporary Password</label>
                        <div style="position:relative;">
                            <input type="text" id="newResetPass" class="nc-input" readonly style="letter-spacing:1px; font-family:'JetBrains Mono', monospace; background: rgba(122,171,221,0.05); padding-right:50px;" />
                            <button type="button" id="copyResetPass" class="btn border-0 py-0" style="position:absolute; right:12px; top:50%; transform:translateY(-50%); color:var(--nc-primary);" title="Copy to Clipboard">
                                <i class="fa fa-copy"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="mt-3 p-3 rounded" style="background: rgba(122,171,221,0.05); border: 1px dashed rgba(122,171,221,0.2);">
                        <div class="nc-text-muted" style="font-size:0.8rem; line-height:1.5;">
                            <i class="fa fa-info-circle me-1 text-primary"></i> This password will expire after the user's next login. They will be forced to create a new one.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn-nc-primary w-100" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.resetStaffPassword = function(userId, username) {
            if (!confirm('Are you sure you want to reset the password for ' + username + '?')) return;

            const formData = new FormData();
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            fetch('/Employee/ResetPassword/' + userId, {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('resetTargetUser').textContent = username;
                    document.getElementById('newResetPass').value = data.newPassword;
                    new bootstrap.Modal(document.getElementById('resetPassModal')).show();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('An error occurred while resetting the password.');
            });
        };

        document.getElementById('copyResetPass').addEventListener('click', function() {
            const input = document.getElementById('newResetPass');
            input.select();
            input.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(input.value);
            
            const icon = this.querySelector('i');
            icon.classList.remove('fa-copy');
            icon.classList.add('fa-check');
            icon.style.color = 'var(--nc-success)';
            
            setTimeout(() => {
                icon.classList.remove('fa-check');
                icon.classList.add('fa-copy');
                icon.style.color = '';
            }, 2000);
        });
    </script>
}
