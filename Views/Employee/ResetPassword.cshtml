@model MvcMusic.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="nc-page">
    <div class="nc-container">
        <div style="margin-bottom:2rem;">
            <a asp-action="Index" class="btn-nc-outline" style="padding:0.5rem 1rem;border-radius:var(--nc-radius-sm);">
                <i class="fa fa-arrow-left me-1"></i> Back to Employees
            </a>
        </div>

        <div class="nc-page-header">
            <div>
                <div style="color:var(--nc-text-muted);font-size:0.8rem;margin-bottom:0.25rem;"><i class="fa fa-key me-1"></i> SuperAdmin Panel</div>
                <h1 class="nc-page-title">Reset Password</h1>
                @if (!string.IsNullOrEmpty(Model.UserName))
                {
                    <div class="mb-4 text-center">
                        @Model.UserName
                    </div>
                }
            </div>
        </div>

        <div class="nc-card nc-form-card">
            <div class="nc-card-body">
                <asp-validation-summary class="nc-validation-summary" model-only="false"></asp-validation-summary>
                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="nc-form-grid">
                        <div class="nc-form-group">
                            <label asp-for="NewPassword" class="nc-label"></label>
                            <input asp-for="NewPassword" type="password" class="nc-input" placeholder="New password" />
                            <span asp-validation-for="NewPassword" class="nc-validation-error"></span>
                        </div>
                        <div class="nc-form-group">
                            <label asp-for="ConfirmPassword" class="nc-label"></label>
                            <input asp-for="ConfirmPassword" type="password" class="nc-input" placeholder="Confirm new password" />
                            <span asp-validation-for="ConfirmPassword" class="nc-validation-error"></span>
                        </div>
                    </div>
                    <div style="display:flex;gap:1rem;margin-top:1rem;">
                        <button type="submit" class="btn-nc-primary" style="padding:0.75rem 2rem;border-radius:var(--nc-radius-sm);">
                            <i class="fa fa-key me-2"></i> Reset Password
                        </button>
                        <a asp-action="Index" class="btn-nc-outline" style="padding:0.75rem 1.5rem;border-radius:var(--nc-radius-sm);">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
