@model List<MvcMusic.Models.ActivityLog>

@{
    ViewData["Title"] = "Employee Profile";
    var employee = ViewBag.Employee as MvcMusic.Models.ApplicationUser;
    var role = ViewBag.Role as string;
}

<div class="nc-page">
    <div class="container-fluid px-4">
        <div style="margin-bottom:1rem;"></div>

        <div class="row gx-4">
            <div class="col-lg-4 mb-4">
                <div class="nc-card">
                    <div class="nc-card-body p-4 text-center">
                        <div style="margin-bottom:1.5rem;">
                            @if (!string.IsNullOrEmpty(employee.ProfilePicture))
                            {
                                <img src="@employee.ProfilePicture" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid var(--nc-border);padding:4px;" />
                            }
                            else
                            {
                                <div style="width:120px;height:120px;border-radius:50%;background:rgba(123,171,221,0.15);color:var(--nc-primary);display:flex;align-items:center;justify-content:center;font-size:3rem;font-weight:800;border:3px solid var(--nc-border);margin:0 auto;">
                                    @((employee.FirstName?.FirstOrDefault() ?? employee.UserName?.FirstOrDefault() ?? '?').ToString().ToUpper())
                                </div>
                            }
                        </div>
                        <h2 style="font-size:1.5rem;font-weight:800;margin-bottom:0.25rem;">@(string.IsNullOrWhiteSpace(employee.FullName.Trim()) ? employee.UserName : employee.FullName)</h2>
                        <div class="nc-text-secondary mb-3" style="font-size:0.9rem;">@employee.Email</div>
                        
                        <div style="display:inline-block;padding:0.3rem 1rem;border-radius:100px;font-size:0.8rem;font-weight:700;margin-bottom:2rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);">
                            Role: @role
                        </div>

                        <div style="text-align:left;border-top:1px solid var(--nc-border);padding-top:1.5rem;">
                            <div style="margin-bottom:1rem;font-size:0.85rem;">
                                <span class="nc-text-muted d-block" style="margin-bottom:0.2rem;text-transform:uppercase;letter-spacing:0.05em;">Status</span>
                                @if (employee.RecordStatus == MvcMusic.Models.RecordStatus.Deleted)
                                {
                                    <span style="color:#e57373;font-weight:700;"><i class="fa fa-trash me-1"></i> Deleted Account</span>
                                }
                                else
                                {
                                    <span style="color:#81c784;font-weight:700;"><i class="fa fa-circle-check me-1"></i> Active Account</span>
                                }
                            </div>
                            <div style="margin-bottom:1rem;font-size:0.85rem;">
                                <span class="nc-text-muted d-block" style="margin-bottom:0.2rem;text-transform:uppercase;letter-spacing:0.05em;">Total Actions</span>
                                <span class="nc-text-primary fw-bold" style="font-size:1.1rem;">@Model.Count</span>
                            </div>
                        </div>

                        <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--nc-border);">
                            <div class="d-flex flex-column gap-2">


                                @if (employee.RecordStatus == MvcMusic.Models.RecordStatus.Deleted)
                                {
                                    <form asp-action="Restore" asp-route-id="@employee.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success w-100" style="font-size:0.9rem;font-weight:600;padding:0.75rem;">
                                            <i class="fa fa-trash-restore me-2"></i> Restore Account
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Delete" asp-route-id="@employee.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this employee?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger w-100" style="font-size:0.9rem;font-weight:600;padding:0.75rem;">
                                            <i class="fa fa-trash me-2"></i> Delete Employee
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="nc-card">
                    <div class="nc-card-header" style="padding:1.5rem 1.5rem 1rem;border-bottom:1px solid var(--nc-border);">
                        <h3 style="font-size:1.1rem;font-weight:700;margin:0;"><i class="fa fa-list-check me-2 text-primary"></i> Activity Log</h3>
                    </div>
                    <div class="nc-card-body p-0">
                        @if (!Model.Any())
                        {
                            <div class="text-center nc-text-muted" style="padding:4rem 2rem;">
                                <i class="fa fa-history" style="font-size:3rem;margin-bottom:1rem;opacity:0.5;"></i>
                                <p>No activity logs found for this employee.</p>
                            </div>
                        }
                        else
                        {
                            <div class="nc-table-responsive" style="max-height: 600px; overflow-y: auto;">
                                <table class="nc-table align-middle">
                                    <thead style="position: sticky; top: 0; background: var(--nc-bg-card); z-index: 10;">
                                        <tr>
                                            <th>Timestamp</th>
                                            <th>Action</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var log in Model)
                                        {
                                            <tr>
                                                <td class="nc-text-muted text-nowrap" style="font-size:0.85rem;">@log.Timestamp.ToString("MMM d, yyyy HH:mm:ss")</td>
                                                <td style="font-weight:700;">
                                                    <span class="badge" style="background: rgba(123, 171, 221, 0.15); color: var(--nc-primary); border: 1px solid rgba(123, 171, 221, 0.3);">
                                                        @log.Action
                                                    </span>
                                                </td>
                                                <td class="nc-text-secondary" style="font-size:0.9rem;">
                                                    @Html.Raw(log.Details)
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .nc-profile-layout { display: grid; grid-template-columns: 350px 1fr; gap: 2rem; }
        .nc-profile-card { background: var(--nc-bg-card); border: 1px solid var(--nc-border); border-radius: var(--nc-radius); overflow: hidden; }
        .nc-profile-header { position: relative; padding: 2.5rem 2rem; text-align: center; border-bottom: 1px solid var(--nc-border); }
        .nc-profile-avatar-wrapper { width: 120px; height: 120px; margin: 0 auto 1.5rem; position: relative; border-radius: 50%; padding: 4px; background: linear-gradient(135deg, var(--nc-primary), transparent); }
        .nc-profile-avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: var(--nc-bg-secondary); border: 3px solid var(--nc-bg-card); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; font-weight: 800; color: var(--nc-primary); }
        .nc-status-badge { position: absolute; bottom: 5px; right: 5px; width: 20px; height: 20px; border-radius: 50%; border: 3px solid var(--nc-bg-card); }
        .status-active { background: #81c784; } .status-banned { background: #e57373; box-shadow: 0 0 10px rgba(229, 115, 115, 0.5); }
        .nc-profile-name { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.25rem; }
        .nc-profile-role { color: var(--nc-primary); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; }
        
        @@media (max-width: 992px) {
            .nc-profile-layout { grid-template-columns: 1fr; }
        }
    </style>
}
