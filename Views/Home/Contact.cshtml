@{
    ViewData["Title"] = "Contact Us";
}

<div class="nc-page nc-contact-page">
    <!-- Hero Section -->
    <div class="nc-contact-hero">
        <div class="nc-container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <div class="d-flex align-items-center gap-3" style="color: rgba(255, 255, 255, 0.68);">
                        <i class="fa fa-headset"></i>
                        Support Center
                    </div>
                    <h1 class="display-4 fw-bold mb-4">How can we <span class="nc-text-gradient">help you?</span></h1>
                    <p class="lead mb-5" style="color: rgba(255, 255, 255, 0.68);">
                        Whether you're looking for technical support, order inquiries, or just want to chat about gear, our team is ready to assist.
                    </p>
                    @{
                        if (User.IsInRole("Customer"))
                        {
                            <div class="d-flex flex-wrap gap-3">
                                <a asp-controller="Chat" asp-action="Index" class="btn-nc-primary px-5 py-3 fs-5">
                                    <i class="fa fa-comments me-2"></i> Start Live Chat
                                </a>
                            </div>
                        }
                    }
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="nc-hero-visual">
                        <div class="nc-glow-circle"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Cards -->
    <div id="contact-details" class="nc-contact-cards py-5">
        <div class="nc-container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="nc-card h-100 text-center p-4">
                        <div class="nc-card-icon-wrapper mb-4">
                            <i class="fa fa-phone"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Call Us</h4>
                        <p style="color: rgba(255, 255, 255, 0.68);">Available 24/7 for urgent matters</p>
                        <a href="tel:+639123456789" class="nc-link fs-5 fw-bold">+63 912 345 6789</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="nc-card h-100 text-center p-4">
                        <div class="nc-card-icon-wrapper mb-4">
                            <i class="fa fa-envelope"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Email Us</h4>
                        <p style="color: rgba(255, 255, 255, 0.68);">We typically reply within 2 hours</p>
                        <a href="mailto:support@nightcord.com" class="nc-link fs-5 fw-bold">support@nightcord.com</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="nc-card h-100 text-center p-4">
                        <div class="nc-card-icon-wrapper mb-4">
                            <i class="fa fa-location-dot"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Visit Us</h4>
                        <p style="color: rgba(255, 255, 255, 0.68);">Stop by our flagship store</p>
                        <address class="nc-text-primary fs-5 fw-bold m-0">Manila, Philippines</address>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .contact-hero {
            text-align: center;
            padding: 4rem 1rem 5rem;
            background: radial-gradient(circle at top, rgba(123, 171, 221, 0.05) 0%, transparent 60%);
        }

        .contact-title {
            font-size: 3.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, #fff 0%, #7babdd 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
            letter-spacing: -1px;
        }

        .contact-subtitle {
            color: rgba(255, 255, 255, 0.68);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

        .contact-info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
            margin-top: -3rem;
            position: relative;
            z-index: 10;
            padding-bottom: 4rem;
        }

        .contact-info-card {
            background: rgba(21, 26, 38, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 1.5rem;
            padding: 2.5rem 2rem;
            text-align: center;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .contact-info-card:hover {
            transform: translateY(-10px);
            border-color: rgba(123, 171, 221, 0.2);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(123, 171, 221, 0.1);
        }

        .contact-icon-wrapper {
            width: 64px;
            height: 64px;
            margin: 0 auto 1.5rem;
            background: rgba(123, 171, 221, 0.1);
            border: 1px solid rgba(123, 171, 221, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--nc-primary);
            font-size: 1.5rem;
            transition: all 0.3s;
        }

        .contact-info-card:hover .contact-icon-wrapper {
            background: var(--nc-primary);
            color: #fff;
            transform: scale(1.1);
            box-shadow: 0 10px 20px rgba(123, 171, 221, 0.3);
        }

        .contact-card-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: #fff;
        }

        .contact-card-text {
            color: var(--nc-text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 0;
        }

        .contact-card-link {
            display: inline-block;
            margin-top: 1.5rem;
            color: var(--nc-primary);
            font-weight: 600;
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .contact-card-link:hover {
            color: #fff;
        }

        .contact-card-link i {
            transition: transform 0.2s;
        }

        .contact-card-link:hover i {
            transform: translateX(5px);
        }

        .faq-section {
            background: rgba(0, 0, 0, 0.2);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding: 5rem 0;
        }

        .faq-title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .faq-subtitle {
            text-align: center;
            color: rgba(255, 255, 255, 0.68);
            margin-bottom: 3rem;
        }

        .faq-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .faq-card {
            background: var(--nc-bg-card);
            border: 1px solid var(--nc-border);
            border-radius: 1rem;
            padding: 2rem;
            transition: all 0.3s;
        }

        .faq-card:hover {
            border-color: rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.02);
        }

        .faq-question {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
            margin-bottom: 1rem;
        }

        .faq-icon {
            color: var(--nc-primary);
            font-size: 1.25rem;
            margin-top: 0.2rem;
        }

        .faq-q-text {
            font-size: 1.1rem;
            font-weight: 700;
            line-height: 1.4;
            color: #fff;
            margin: 0;
        }

        .faq-answer {
            color: var(--nc-text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
            margin: 0;
        }

        .cta-section {
            text-align: center;
            padding: 5rem 1rem;
        }

        .cta-box {
            background: linear-gradient(145deg, rgba(21, 26, 38, 0.9), rgba(10, 12, 16, 0.9));
            border: 1px solid rgba(123, 171, 221, 0.2);
            border-radius: 2rem;
            padding: 4rem 2rem;
            max-width: 800px;
            margin: 0 auto;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
        }

        .cta-title {
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 1rem;
        }

        .cta-text {
            color: rgba(255, 255, 255, 0.68);
            font-size: 1.1rem;
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
    </style>
}
