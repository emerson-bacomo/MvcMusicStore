@{
    ViewData["Title"] = "About Us";
}

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">About NightCord</h1>
            </div>
        </div>

        <div class="nc-card">
            <div class="nc-card-body" style="padding: 3rem;">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <h2 style="color:var(--nc-primary); 
                                   margin-bottom:1.5rem;">Your Premium Music Partner</h2>
                        <p style="font-size:1.1rem; 
                                  line-height:1.8; 
                                  color:var(--nc-text-secondary);">
                            NightCord is a shop for high-quality musical instruments. 
                            We started with the goal of helping every musician get the best sound. 
                            We offer a great selection of guitars, keyboards, and audio gear.
                        </p>
                        <p style="font-size:1.1rem; 
                                  line-height:1.8; 
                                  color:var(--nc-text-secondary); 
                                  margin-bottom:2rem;">
                            Whether you are a pro or just starting, we have the tools 
                            for you to play your music with style.
                        </p>
                    </div>
                    <div class="col-md-5 text-center d-none d-md-block">
                        <div style="font-size:8rem; 
                                    color:var(--nc-primary); 
                                    opacity:0.1;">
                            <i class="fa fa-music"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="nc-container my-5">
        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">The Developer</h1>
            </div>
        </div>

        <div class="nc-card">
            <div class="nc-card-body" style="padding: 3rem;">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center mb-4 mb-md-0">
                        <img src="~/images/about/1x1.png" alt="Emerson C. Bacomo" 
                             style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 4px solid var(--nc-primary-soft);">
                    </div>
                    <div class="col-md-9">
                        <h2 style="color:var(--nc-primary); margin-bottom:0.5rem;">Emerson C. Bacomo</h2>
                        <div style="color:var(--nc-text-muted); font-size:0.9rem; margin-bottom:1.5rem;">
                            <i class="fa fa-envelope me-1"></i> ccs.emersonb@gmail.com
                        </div>
                        <p style="font-size:1.1rem; line-height:1.8; color:var(--nc-text-secondary);">
                            Hi, I'm Emerson. I built this site to help musicians find the gear they need 
                            in a simple and efficient way. I aimed to create a clean, straightforward 
                            space where quality instruments are easy to find. I've dedicated my time to 
                            crafting an experience that is both simple and powerful, ensuring it works 
                            beautifully for every artist. I hope you find exactly what you're looking 
                            for on your musical journey!
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
