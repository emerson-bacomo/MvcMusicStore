@{
    ViewData["Title"] = "About Us";
}

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <div style="color:var(--nc-text-muted); 
                            font-size:0.8rem; 
                            margin-bottom:0.25rem;">
                    <i class="fa fa-info-circle me-1"></i> NightCord
                </div>
                <h1 class="nc-page-title">About NightCord</h1>
            </div>
        </div>

        <div class="nc-card">
            <div class="nc-card-body" style="padding: 3rem;">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <h2 style="color:var(--nc-primary); 
                                   margin-bottom:1.5rem;">Your Premium Music Partner</h2>
                        <p style="font-size:1.1rem; 
                                  line-height:1.8; 
                                  color:var(--nc-text-secondary);">
                            NightCord is a specialized boutique for high-end musical instruments and equipment. 
                            Founded on the principle of bringing the best sound to every musician, we curate 
                            a selection of world-class guitars, keyboards, and audio gear.
                        </p>
                        <p style="font-size:1.1rem; 
                                  line-height:1.8; 
                                  color:var(--nc-text-secondary); 
                                  margin-bottom:2rem;">
                            Whether you are a seasoned professional or just starting your musical journey, 
                            NightCord provides the tools you need to express your creativity with clarity and style.
                        </p>
                    </div>
                    <div class="col-md-5 text-center d-none d-md-block">
                        <div style="font-size:8rem; 
                                    color:var(--nc-primary); 
                                    opacity:0.1;">
                            <i class="fa fa-music"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
