@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <div style="color:var(--nc-text-muted); 
                            font-size:0.8rem; 
                            margin-bottom:0.25rem;">
                    <i class="fa fa-shield-halved me-1"></i> Security
                </div>
                <h1 class="nc-page-title">Privacy Policy</h1>
                <p style="color:var(--nc-text-muted); 
                          font-size:0.88rem; 
                          margin-top:0.25rem;">Last updated: March 14, 2026</p>
            </div>
        </div>

        <div class="nc-card">
            <div class="nc-card-body" 
                 style="padding: 2.5rem; 
                        color:var(--nc-text-secondary); 
                        line-height:1.8;">
                <section class="mb-5">
                    <h3 style="color:var(--nc-text-primary); 
                               margin-bottom:1.2rem;">1. Information Collection</h3>
                    <p>We collect information you provide directly to us when you create an account, make a purchase, or communicate with us. This includes your name, email address, shipping address, and payment information.</p>
                </section>

                <section class="mb-5">
                    <h3 style="color:var(--nc-text-primary); 
                               margin-bottom:1.2rem;">2. Use of Information</h3>
                    <p>We use the information we collect to process your orders, maintain your account, and improve our services. We may also use your information to communicate with you about promotions and updates, provided you have opted in to such communications.</p>
                </section>

                <section class="mb-5">
                    <h3 style="color:var(--nc-text-primary); 
                               margin-bottom:1.2rem;">3. Data Security</h3>
                    <p>We implement industry-standard security measures to protect your personal information. Your payment data is processed through secure, encrypted gateways and is never stored on our servers.</p>
                </section>

                <section>
                    <h3 style="color:var(--nc-text-primary); 
                               margin-bottom:1.2rem;">4. Your Rights</h3>
                    <p>You have the right to access, correct, or delete your personal information at any time. You can manage your data through your account settings or by contacting us at <a href="mailto:info@nightcord.store" 
                                                                                                                                                                                            style="color:var(--nc-primary); 
                                                                                                                                                                                                   font-weight:600;">info@nightcord.store</a>.</p>
                </section>
            </div>
        </div>
    </div>
</div>
