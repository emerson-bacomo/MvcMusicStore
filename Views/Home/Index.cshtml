@model IEnumerable<MvcMusic.Models.Product>

@{
    ViewData["Title"] = "Home — NightCord";
    var categories = ViewData["Categories"] as List<string> ?? new List<string>();
    var currentCategory = ViewData["CurrentCategory"]?.ToString();
    var currentSearch = ViewData["CurrentSearch"]?.ToString();
    var bannerProducts = ViewData["BannerProducts"] as List<MvcMusic.Models.Product> ?? new List<MvcMusic.Models.Product>();
}

@section Styles {
    @* Home Carousel Overrides *@
    <style>
        #homeCarousel {
            aspect-ratio: 21/9;
            margin-bottom: 3rem;
        }
        #homeCarousel .nc-carousel-inner-content {
            padding: 3rem;
        }

        #homeCarousel .nc-carousel-name {
            font-size: 2rem;
        }

        #homeCarousel .nc-carousel-desc {
            font-size: 1rem;
        }

        #homeCarousel .nc-carousel-price {
            font-size: 1.3rem;
        }
        #homeCarousel .nc-carousel-overlay {
            background: linear-gradient(
                to top,
                rgba(10, 12, 16, 0.95) 0%,
                rgba(10, 12, 16, 0.3) 60%,
                transparent 100%
            );
        }

        /* Home Mobile Overrides */
        @@media (max-width: 768px) {
            #homeCarousel {
                aspect-ratio: 4/3;
                margin-bottom: 2rem;
            }
            #homeCarousel .nc-carousel-name { font-size: 1.5rem; }
            #homeCarousel .nc-carousel-desc { font-size: 0.85rem; }
            #homeCarousel .nc-carousel-price { font-size: 1.1rem; }
        }
    </style>
}

<div class="nc-page">
    @* Content starts here *@
    <div class="container-fluid px-4 mx-auto" style="max-width: 1600px;">
        <!-- Banner Carousel -->
        @if (bannerProducts.Any())
        {
            <div class="home-carousel-wrapper">
                <partial name="Components/_Carousel" model="bannerProducts" 
                         view-data='new ViewDataDictionary(ViewData) { 
                            { "CarouselId", "homeCarousel" }, 
                            { "TagLabel", "Featured" },
                            { "UseBanner", true }
                         }' />
            </div>
        }

        <div class="nc-page-header" id="catalog-section">
            <div>
                <div style="color:var(--nc-text-muted); 
                            font-size:0.8rem; 
                            margin-bottom:0.25rem;">
                    <i class="fa fa-fire me-1"></i> Handpicked for Musicians Like You
                </div>
                <h1 class="nc-page-title">Explore Featured Instruments</h1>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" asp-action="Index">
            <div style="display: flex; 
                        gap: 1rem; 
                        align-items: center; 
                        margin-bottom: 2rem; 
                        flex-wrap: wrap;">
                <div style="position: relative; 
                            flex: 1; 
                            min-width: 250px;">
                    <i class="fa fa-search" 
                       style="position: absolute; 
                              left: 0.75rem; 
                              top: 50%; 
                              transform: translateY(-50%); 
                              color: var(--nc-text-muted); 
                              font-size: 0.9rem;"></i>
                    <input type="text" 
                           name="search" 
                           value="@currentSearch" 
                           class="nc-input" 
                           style="padding-left: 2.5rem;
                                  width: 100%;" 
                           placeholder="Search by name or brand..." />
                </div>
                <div class="d-flex gap-2 flex-grow-1 flex-sm-grow-0">
                    <select name="category" 
                            onchange="this.form.submit()" 
                            style="background: rgba(255, 255, 255, 0.05); 
                                   border: 1.5px solid var(--nc-border); 
                                   border-radius: var(--nc-radius-sm); 
                                   color: var(--nc-text-primary); 
                                   padding: 0.7rem 1rem; 
                                   font-family: inherit; 
                                   font-size: 0.9rem; 
                                   outline: none; 
                                   cursor: pointer; 
                                   transition: var(--transition);
                                   flex: 1;">
                        <option value="" style="background: var(--nc-bg-card);">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            if (cat == currentCategory)
                            {
                                <option value="@cat" selected="selected" style="background: var(--nc-bg-card);">@cat</option>
                            }
                            else
                            {
                                <option value="@cat" style="background: var(--nc-bg-card);">@cat</option>
                            }
                        }
                    </select>
                    <button type="submit" 
                            class="btn-nc-primary" 
                            style="white-space: nowrap; 
                                   padding: 0.7rem 1.5rem; 
                                   border-radius: var(--nc-radius-sm);">
                        <i class="fa fa-search me-1"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentCategory))
                    {
                        <a asp-action="UserHome" 
                           class="btn-nc-outline" 
                           style="white-space: nowrap; 
                                  padding: 0.7rem 1.2rem; 
                                  border-radius: var(--nc-radius-sm);
                                  display: flex;
                                  align-items: center;
                                  justify-content: center;">
                            <i class="fa fa-xmark"></i>
                        </a>
                    }
                </div>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div style="text-align: center; 
                        padding: 4rem 0; 
                        color: var(--nc-text-muted);">
                <i class="fa fa-guitar" 
                   style="font-size: 3rem; 
                          margin-bottom: 1rem; 
                          display: block;"></i>
                <p style="font-size: 1rem;">No instruments found matching your criteria.</p>
                <a asp-action="UserHome" 
                   class="btn-nc-outline" 
                   style="margin-top: 1rem; 
                          display: inline-block; 
                          padding: 0.6rem 1.2rem; 
                          border-radius: var(--nc-radius-sm);">View All</a>
            </div>
        }
        else
        {
            <div style="display: grid; 
                        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); 
                        gap: 1.5rem;">
                @foreach (var product in Model)
                {
                    <partial name="Components/_ProductCard" model="product" />
                }
            </div>
        }
    </div>
</div>
