@model MvcMusic.ViewModels.SettingsViewModel

@{
    ViewData["Title"] = "Account Settings";
    var isCustomer = User.IsInRole("User");
}

<div class="nc-page">
    <div class="nc-container" style="max-width: 650px;">
        <div class="nc-page-header">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-cog me-1"></i> Account Preferences</div>
                <h1 class="nc-page-title">Settings</h1>
                <p class="nc-page-subtitle">Manage your account credentials and security preferences.</p>
            </div>
        </div>

        <div class="nc-card">
            <div class="nc-card-body p-4 p-md-5">
                <form asp-action="Settings" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="nc-validation-summary mb-4"></div>

                    <!-- Account Info Section -->
                    <div class="mb-5">
                        <h5 class="mb-4" style="font-weight: 700; color: var(--nc-primary); border-bottom: 1px solid var(--nc-border); padding-bottom: 0.75rem;">
                            <i class="fa fa-envelope me-2"></i> Contact Information
                        </h5>
                        
                        <div class="nc-floating-group">
                            <input asp-for="Email" class="nc-floating-control" placeholder=" " data-label="Email Address" required data-ajax-url="@Url.Action("IsEmailAvailable", "Account")" />
                            <label class="nc-floating-label" asp-for="Email">Email Address</label>
                        </div>

                        @if (isCustomer)
                        {
                            <div class="nc-floating-group">
                                <input asp-for="Username" class="nc-floating-control" placeholder=" " data-label="Username" />
                                <label class="nc-floating-label" asp-for="Username">Username</label>
                            </div>
                        }
                        else
                        {
                            <div class="nc-floating-group opacity-75">
                                <input asp-for="Username" class="nc-floating-control" readonly style="cursor: not-allowed; background: rgba(255,255,255,0.02);" />
                                <label class="nc-floating-label" asp-for="Username">Username (Employees cannot change)</label>
                            </div>
                        }
                    </div>

                    <!-- Security Section -->
                    <div class="mb-5">
                        <h5 class="mb-4" style="font-weight: 700; color: var(--nc-secondary); border-bottom: 1px solid var(--nc-border); padding-bottom: 0.75rem;">
                            <i class="fa fa-shield-alt me-2"></i> Security & Password
                        </h5>
                        <p class="mb-4" style="font-size: 0.85rem; color: var(--nc-text-muted);">
                            Leave these fields blank if you do not wish to change your password.
                        </p>

                        <div class="nc-floating-group nc-password-wrapper">
                            <input asp-for="CurrentPassword" class="nc-floating-control" type="password" placeholder=" " data-label="Current Password" autocomplete="current-password" />
                            <label class="nc-floating-label" asp-for="CurrentPassword">Current Password</label>
                        </div>

                        <div class="nc-floating-group nc-password-wrapper">
                            <input asp-for="NewPassword" class="nc-floating-control nc-password-strength" type="password" placeholder=" " data-label="New Password" autocomplete="new-password" />
                            <label class="nc-floating-label" asp-for="NewPassword">New Password</label>
                        </div>

                        <div class="nc-floating-group nc-password-wrapper">
                            <input asp-for="ConfirmPassword" class="nc-floating-control" type="password" placeholder=" " data-label="Confirm Password" autocomplete="new-password" />
                            <label class="nc-floating-label" asp-for="ConfirmPassword">Confirm Password</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3 border-top" style="border-color: var(--nc-border) !important;">
                        <a asp-action="Index" class="btn-nc-outline px-4">Cancel</a>
                        <button type="submit" class="btn-nc-primary px-5" id="btnSaveSettings">
                            <i class="fa fa-save me-2"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const newPass = document.getElementById('NewPassword');
            const confirmPass = document.getElementById('ConfirmPassword');
            const currentPass = document.getElementById('CurrentPassword');
            const btnSave = document.getElementById('btnSaveSettings');

            function validatePasswords() {
                const val = newPass.value;
                const confirmVal = confirmPass.value;
                
                if (val.length > 0) {
                    currentPass.setAttribute('required', 'required');
                    confirmPass.setAttribute('required', 'required');
                    
                    if (val.length < 6) {
                        window.ValidationEngine.setError(newPass, "New password must be at least 6 characters.");
                    } else {
                        window.ValidationEngine.setError(newPass, "");
                    }

                    if (val !== confirmVal) {
                        window.ValidationEngine.setError(confirmPass, "Passwords do not match.");
                        btnSave.disabled = true;
                    } else {
                        window.ValidationEngine.setError(confirmPass, "");
                        btnSave.disabled = val.length < 6;
                    }
                } else {
                    currentPass.removeAttribute('required');
                    confirmPass.removeAttribute('required');
                    window.ValidationEngine.setError(newPass, "");
                    window.ValidationEngine.setError(confirmPass, "");
                    btnSave.disabled = false;
                }
            }

            newPass.addEventListener('input', validatePasswords);
            confirmPass.addEventListener('input', validatePasswords);
        });
    </script>
}
