@{
    ViewData["Title"] = "Brand Management";
}

<div class="nc-page">
    <div class="container-fluid px-4">
        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">Brand Management</h1>
                <p class="nc-page-subtitle">Manage manufacturers and instrument brands.</p>
            </div>
            <div class="nc-page-actions">
                <button type="button" class="btn-nc-primary nc-btn-featured" data-bs-toggle="modal" data-bs-target="#createBrandModal">
                    <i class="fa fa-plus me-2"></i> New Brand
                </button>
            </div>
        </div>

        <div id="brands-table"></div>
    </div>
</div>

<!-- Create Brand Modal -->
<div class="modal fade" id="createBrandModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-nc-card border-nc">
            <div class="modal-header border-bottom-nc">
                <h5 class="modal-title nc-text-primary fw-bold">Create New Brand</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label nc-label-sm">Brand Name</label>
                        <input type="text" name="name" class="form-control nc-input-dark" required placeholder="e.g., Fender">
                    </div>
                </div>
                <div class="modal-footer border-top-nc">
                    <button type="button" class="btn-nc-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-nc-primary">Create Brand</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .nc-page-header { 
        display: flex; 
        justify-content: space-between; 
        align-items: flex-end; 
        margin-bottom: 2.5rem; 
        flex-wrap: wrap; 
        gap: 1rem; 
    }

    .nc-btn-featured { 
        padding: 0.9rem 2rem; 
        font-size: 1rem; 
        box-shadow: 0 0 20px rgba(123, 171, 221, 0.2); 
    }

    .nc-btn-featured:hover { 
        box-shadow: 0 0 30px rgba(123, 171, 221, 0.4); 
    }
    
    .nc-action-group { 
        display: flex; 
        gap: 0.6rem; 
    }

    .nc-action-link {
        width: 36px; 
        height: 36px; 
        display: flex; 
        flex-shrink: 0;
        align-items: center; 
        justify-content: center;
        border-radius: 8px; 
        background: var(--nc-bg-secondary); 
        color: var(--nc-text-secondary);
        transition: all 0.25s; 
        border: 1px solid var(--nc-border);
    }

    .nc-action-link i {
        width: auto !important;
        height: auto !important;
        display: inline-block;
    }

    .nc-action-link:hover { 
        background: var(--nc-primary); 
        color: #fff; 
        transform: translateY(-3px); 
        border-color: var(--nc-primary); 
    }

    .nc-action-link.delete { 
        color: #e57373; 
    }

    .nc-action-link.delete:hover { 
        background: #e57373; 
        border-color: #e57373; 
        color: #fff !important; 
    }

    .nc-input-dark { 
        background: rgba(255,255,255,0.05); 
        border: 1px solid var(--nc-border); 
        color: #fff; 
        border-radius: 8px; 
    }

    .nc-input-dark:focus { 
        background: rgba(255,255,255,0.08); 
        border-color: var(--nc-primary); 
        color: #fff; 
        box-shadow: none; 
    }

    .nc-label-sm { 
        font-size: 0.75rem; 
        text-transform: uppercase; 
        letter-spacing: 0.05em; 
        color: var(--nc-text-muted); 
        font-weight: 700; 
    }

    .modal-content.bg-nc-card { 
        background: var(--nc-bg-card); 
        backdrop-filter: blur(20px); 
    }

    .border-bottom-nc { 
        border-bottom: 1px solid var(--nc-border) !important; 
    }

    .border-top-nc { 
        border-top: 1px solid var(--nc-border) !important; 
    }

    .border-nc { 
        border: 1px solid var(--nc-border) !important; 
    }
</style>

@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
}

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';
        
        document.addEventListener('DOMContentLoaded', function() {
            const table = new UpdatableTable('#brands-table', {
                label: '',
                storagePrefix: 'brand',
                request: {
                    url: '@Url.Action("GetTableData", "Brands")',
                    type: 'GET'
                },
                fieldDefinitions: {
                    name: { label: 'Brand Name' },
                    productCount: { 
                        label: 'Products',
                        renderContent: (val, col, rowData) => `
                            <div class="d-flex align-items-center gap-3">
                                <span class="fw-bold nc-text-primary" style="font-size: 1.1rem; min-width: 20px;">${val}</span>
                                <a href="/Products/Index?brandId=${rowData.id}" class="btn-nc-outline d-inline-flex align-items-center" style="font-size:0.75rem; padding: 0 0.8rem; height: 32px; white-space: nowrap;">
                                    <i class="fa fa-eye me-1" style="font-size: 0.75rem;"></i> View Products
                                </a>
                            </div>
                        `
                    },
                    actions: {
                        label: 'Actions',
                        renderContent: function(value, col, rowData) {
                            return `
                                <div class="nc-action-group">
                                    <button type="button" class="nc-action-link delete border-0" title="Archive" 
                                            onclick="window.confirmDelete('${rowData.id}', '@Url.Action("Delete", "Brands")', () => table.fetchData())">
                                        <i class="fa fa-archive"></i>
                                    </button>
                                </div>
                            `;
                        }
                    }
                }
            });
        });
    </script>
}
