<style>
    /* ── Why NightCord Scoped Styles ─────────────────────────────── */
    .nc-why {
        padding: 4rem 2rem;
        background: var(--nc-bg-primary);
        border-top: 1px solid var(--nc-border);
    }
    .nc-why-inner {
        max-width: 1400px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .nc-section-header {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .nc-section-title {
        font-size: clamp(2rem, 4vw, 2.8rem);
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: var(--nc-text-primary);
        letter-spacing: -0.02em;
    }
    .nc-section-subtitle {
        font-size: 1.1rem;
        color: var(--nc-text-secondary);
        max-width: 600px;
        line-height: 1.6;
        margin-left: auto;
        margin-right: auto;
    }
    .nc-features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
    }
    .nc-feature-card {
        text-align: left;
        padding: 2.5rem 2rem;
        background: var(--nc-bg-card);
        border: 1px solid var(--nc-border);
        border-radius: var(--nc-radius);
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    @@media (max-width: 991px) {
        .nc-feature-card {
            text-align: center;
        }
    }
    .nc-feature-card:hover {
        transform: translateY(-8px);
        border-color: var(--nc-primary);
        box-shadow: var(--nc-shadow-glow);
    }
    .nc-feature-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--nc-text-primary);
    }
    .nc-feature-desc {
        font-size: 0.95rem;
        color: var(--nc-text-secondary);
        line-height: 1.6;
    }
    @@media (max-width: 768px) {
        .nc-features-grid {
            display: none !important;
        }
        .nc-features-carousel {
            display: block !important;
            margin-top: 2rem;
        }
    }
    .nc-features-carousel {
        display: none;
    }
    .carousel-indicators [data-bs-target] {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--nc-primary);
        opacity: 0.3;
        margin: 0 5px;
        border: none;
    }
    .carousel-indicators .active {
        opacity: 1;
        transform: scale(1.2);
    }
    .nc-why .carousel-inner {
        padding-bottom: 3rem;
    }
</style>

<section class="nc-why">
    <div class="nc-why-inner">
        <div class="nc-section-header">
            <h2 class="nc-section-title">Why NightCord?</h2>
            <p class="nc-section-subtitle">A professional ecosystem for modern musicians.</p>
        </div>

        @* Desktop Grid *@
        <div class="nc-features-grid">
            <div class="nc-feature-card">
                <div class="nc-feature-title">Premium Brands</div>
                <p class="nc-feature-desc">From Fender Squier to Roland - we carry trusted names that define your sound.</p>
            </div>
            <div class="nc-feature-card">
                <div class="nc-feature-title">Premium Dark Design</div>
                <p class="nc-feature-desc">Our meticulously crafted interface ensures a distraction-free creative experience.</p>
            </div>
            <div class="nc-feature-card">
                <div class="nc-feature-title">Vetted by Professionals</div>
                <p class="nc-feature-desc">Every instrument is reviewed by industry experts to ensure quality and reliability.</p>
            </div>
            <div class="nc-feature-card">
                <div class="nc-feature-title">For Every Journey</div>
                <p class="nc-feature-desc">Whether starting out or going pro - we provide the gear you need to succeed.</p>
            </div>
        </div>

        @* Mobile Carousel *@
        <div id="ncWhyCarousel" class="carousel slide nc-features-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators" 
                 style="
                     bottom: -10px;
                 ">
                <button type="button" data-bs-target="#ncWhyCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#ncWhyCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#ncWhyCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                <button type="button" data-bs-target="#ncWhyCarousel" data-bs-slide-to="3" aria-label="Slide 4"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="nc-feature-card">
                        <div class="nc-feature-title">Premium Brands</div>
                        <p class="nc-feature-desc">From Fender Squier to Roland - we carry trusted names that define your sound.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="nc-feature-card">
                        <div class="nc-feature-title">Premium Dark Design</div>
                        <p class="nc-feature-desc">Our meticulously crafted interface ensures a distraction-free creative experience.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="nc-feature-card">
                        <div class="nc-feature-title">Vetted by Professionals</div>
                        <p class="nc-feature-desc">Every instrument is reviewed by industry experts to ensure quality and reliability.</p>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="nc-feature-card">
                        <div class="nc-feature-title">For Every Journey</div>
                        <p class="nc-feature-desc">Whether starting out or going pro - we provide the gear you need to succeed.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
