@model MvcMusic.Models.Product

<style>
    /* ── Product Card Scoped Styles ────────────────────────────────── */
    .nc-product-card {
        background: var(--nc-bg-card);
        border: 1px solid var(--nc-border);
        border-radius: var(--nc-radius);
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none !important;
        color: inherit !important;
        overflow: hidden;
    }
    .nc-product-card:hover {
        transform: translateY(-5px);
        border-color: var(--nc-primary);
        box-shadow: var(--nc-shadow-glow);
    }

    .nc-product-img-wrap {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4/3;
        background: var(--nc-bg-secondary);
    }
    .nc-product-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .nc-product-card:hover .nc-product-img-wrap img {
        transform: scale(1.05);
    }

    .nc-product-img-wrap img.nc-img-loading {
        opacity: 0;
    }

    .nc-product-img-wrap img.nc-img-loaded {
        opacity: 1;
    }

    .nc-product-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: rgba(10, 12, 16, 0.7);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(123, 171, 221, 0.4);
        border-radius: 100px;
        padding: 0.15rem 0.8rem 0 0.8rem;
        height: 1.6rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 800;
        line-height: 1;
        color: #fff;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        z-index: 2;
    }

    .nc-product-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .nc-product-brand {
        font-size: 0.7rem;
        color: var(--nc-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .nc-product-name {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--nc-text-primary);
        line-height: 1.3;
    }

    .nc-product-price {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--nc-accent);
        margin-top: auto;
    }

    .nc-stars {
        color: #8c9cb1;
        font-size: 0.8rem;
    }

    .nc-stars .filled {
        color: var(--nc-primary);
    }

    .nc-product-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--nc-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .nc-product-stock {
        font-size: 0.7rem;
        color: var(--nc-text-muted);
    }

    /* ── Product Card Mobile Overrides ───────────────────────────── */
    @@media (max-width: 768px) {
        .nc-product-body {
            padding: 1rem;
        }

        .nc-product-name {
            font-size: 0.85rem;
        }

        .nc-product-price {
            font-size: 1rem;
        }

        .nc-product-footer {
            padding: 0.75rem 1rem;
        }
    }
</style>

<a class="nc-product-card" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
    <div class="nc-product-img-wrap">
        <img src="@(Model.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.ProductImages?.FirstOrDefault()?.Url)"
             alt="@Model.Name"
             width="400"
             height="300"
             class="nc-img-loading"
             onload="this.classList.remove('nc-img-loading');this.classList.add('nc-img-loaded')"
             onerror="this.classList.remove('nc-img-loading');this.classList.add('nc-img-loaded');this.src='https://placehold.co/400x300/1a1f2c/7babdd?text=NightCord'" />
        <span class="nc-product-badge" 
              style="
                  cursor: pointer;
              " 
              onclick="event.preventDefault(); event.stopPropagation(); window.location='/Products/Index?categoryId=@Model.CategoryId';">@(Model.Category?.Name ?? "Uncategorized")</span>
    </div>
    <div class="nc-product-body">
        <span class="nc-product-brand" 
              style="
                  cursor: pointer;
              " 
              onclick="event.preventDefault(); event.stopPropagation(); window.location='/Products/Index?brandId=@Model.BrandId';">@(Model.Brand?.Name ?? "No Brand")</span>
        <div class="nc-product-name">@Model.Name</div>
        <div class="nc-stars d-flex align-items-center gap-1">
            <span class="nc-product-rating" 
                  style="
                      color: var(--nc-primary); 
                      font-weight: 700; 
                      font-size: 0.85rem;
                  ">@(Model.SoldAmount > 0 ? Model.Rating.ToString("F1") : "-")</span>
            <div>
                @if (Model.SoldAmount > 0)
                {
                    @for (int i = 0; i < (int)Math.Floor(Model.Rating); i++) { <span class="filled">★</span> }
                    @for (int i = (int)Math.Floor(Model.Rating); i < 5; i++) { 
                        <span style="
                                  opacity: 0.2;
                              ">★</span> 
                    }
                }
                else
                {
                    @for (int i = 0; i < 5; i++) { <span style="
                            opacity: 0.1;
                        ">★</span> }
                }
            </div>
            <span class="nc-product-ratings-count" 
                  style="
                      color: var(--nc-text-muted);
                      font-size: 0.7rem;
                      margin-left: 0.25rem;
                  ">(@Model.RatingsCount)</span>
            <span class="nc-product-sold" 
                  style="
                      color: var(--nc-text-muted);
                      font-size: 0.7rem;
                      margin-left: auto;
                  ">@Model.SoldAmount sold</span>
        </div>
        <div class="nc-product-price">₱ @Model.Price.ToString("N2")</div>
    </div>
    <div class="nc-product-footer">
        <span class="nc-product-stock"><i class="fa fa-box me-1"></i> @Model.Stock in stock</span>
    </div>
</a>
