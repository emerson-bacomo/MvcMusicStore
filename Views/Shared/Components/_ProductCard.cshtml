@model MvcMusic.Models.Product

<style>
    /* ── Product Card Scoped Styles ────────────────────────────────── */
    .nc-product-card {
        background: var(--nc-bg-card);
        border: 1px solid var(--nc-border);
        border-radius: var(--nc-radius);
        overflow: hidden;
        transition: var(--transition);
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    .nc-product-card:hover {
        transform: translateY(-5px);
        border-color: var(--nc-primary);
        box-shadow: var(--nc-shadow-glow);
    }

    .nc-product-img-wrap {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4/3;
        background: var(--nc-bg-secondary);
    }
    .nc-product-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .nc-product-card:hover .nc-product-img-wrap img { transform: scale(1.05); }

    .nc-product-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: rgba(10, 12, 16, 0.7);
        backdrop-filter: blur(8px); /* Premium separation */
        border: 1px solid rgba(123, 171, 221, 0.4); /* Primary color border */
        border-radius: 100px;
        padding: 0.35rem 0.85rem;
        font-size: 0.7rem;
        font-weight: 800;
        color: #fff; /* White text for better contrast */
        text-transform: uppercase;
        letter-spacing: 0.1em;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
        z-index: 2;
    }

    .nc-product-body {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }
    .nc-product-brand { font-size: 0.7rem; color: var(--nc-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .nc-product-name { font-size: 0.95rem; font-weight: 700; color: var(--nc-text-primary); line-height: 1.3; }
    .nc-product-price { font-size: 1.1rem; font-weight: 800; color: var(--nc-accent); margin-top: auto; }

    .nc-stars { color: #8c9cb1; font-size: 0.8rem; }
    .nc-stars .filled { color: var(--nc-primary); }

    .nc-product-footer {
        padding: 1rem 1.25rem;
        border-top: 1px solid var(--nc-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .nc-product-stock { font-size: 0.7rem; color: var(--nc-text-muted); }
</style>

<div class="nc-product-card">
    <div class="nc-product-img-wrap">
        <img src="@(Model.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.ProductImages?.FirstOrDefault()?.Url)" alt="@Model.Name" onerror="this.src='https://placehold.co/400x300/1a1f2c/7babdd?text=NightCord'" />
        <span class="nc-product-badge">@Model.Category</span>
    </div>
    <div class="nc-product-body">
        <div class="nc-product-brand">@Model.Brand</div>
        <div class="nc-product-name">@Model.Name</div>
        <div class="nc-stars">
            @for (int i = 0; i < (int)Model.Rating; i++) { <span class="filled">★</span> }
            @for (int i = (int)Model.Rating; i < 5; i++) { 
                <span style="opacity: 0.2;">★</span> 
            }
            <span style="color: var(--nc-text-muted);
                         font-size: 0.7rem;
                         margin-left: 0.25rem;">@Model.SoldAmount sold</span>
        </div>
        <div class="nc-product-price">₱ @Model.Price.ToString("N2")</div>
    </div>
    <div class="nc-product-footer">
        <span class="nc-product-stock"><i class="fa fa-box me-1"></i> @Model.Stock in stock</span>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-nc-primary" 
           style="font-size: 0.8rem;
                  padding: 0.4rem 0.9rem;">
            View
        </a>
    </div>
</div>
