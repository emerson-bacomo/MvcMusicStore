@model MvcMusic.Models.Product
@{
    var categories = ViewBag.Categories as List<MvcMusic.Models.Category> ?? new List<MvcMusic.Models.Category>();
    var brands = ViewBag.Brands as List<MvcMusic.Models.Brand> ?? new List<MvcMusic.Models.Brand>();
    var primaryUrl = Model.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.ProductImages?.FirstOrDefault()?.Url;
}

<div class="nc-detail-container" id="productDetailContainer" data-product-id="@Model.Id">
    <form id="inPlaceEditForm" enctype="multipart/form-data">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="primaryImage" id="primaryImageInput" value="@(Model.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.ProductImages?.FirstOrDefault()?.Url)" />
        <input type="hidden" name="imageOrder" id="imageOrderInput" value="@string.Join(",", (Model.ProductImages ?? new List<MvcMusic.Models.ProductImage>()).OrderBy(p => p.SortOrder).Select(p => p.Url))" />
        <input type="hidden" name="deletedImages" id="deletedImagesInput" value="[]" />

        <div class="nc-detail-card">
            <!-- Visual Section -->
            <div class="d-flex flex-column gap-2">
                <div class="w-100 position-relative overflow-hidden" style="aspect-ratio: 1; border-radius: 2rem; box-shadow: 0 20px 60px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                    <div class="nc-main-image-wrapper" id="mainImageCarousel">
                        <div class="nc-carousel-track" id="carouselTrack">
                            @if (Model.ProductImages != null && Model.ProductImages.Count > 0)
                            {
                                foreach (var img in Model.ProductImages.OrderBy(p => p.SortOrder))
                                {
                                    <div class="nc-carousel-slide" data-url="@img.Url">
                                        <img src="@img.Url" alt="@Model.Name" class="nc-main-image" onclick="openFullscreen(this.src)" onerror="this.src='https://placehold.co/800x600/1a1f2c/7babdd?text=NightCord'" />
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="nc-carousel-slide">
                                    <img src="https://placehold.co/800x600/1a1f2c/7babdd?text=No+Image" class="nc-main-image" />
                                </div>
                            }
                        </div>
                        
                        <a href="@Url.Action("Index", "Home", new { category = Model.Category?.Name })#catalog-section" class="nc-image-badge nc-read-only-hide" style="text-decoration:none;">@(Model.Category?.Name ?? "Uncategorized")</a>
                        
                        <div class="nc-editable" style="z-index: 21;">
                            <select name="CategoryId" class="nc-input-badge" onchange="editor.trackFieldChange('CategoryId', this.value)">
                                @foreach(var c in categories) {
                                    <option value="@c.Id" selected="@(c.Id == Model.CategoryId ? "selected" : null)">@c.Name</option>
                                }
                            </select>
                        </div>

                        @if (Model.ProductImages != null && Model.ProductImages.Count > 1)
                        {
                            <button type="button" class="nc-img-nav prev" onclick="editor.carouselPrev(event)" aria-label="Previous Image">
                                <i class="fa fa-chevron-left"></i>
                            </button>
                            <button type="button" class="nc-img-nav next" onclick="editor.carouselNext(event)" aria-label="Next Image">
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        }
                    </div>

                    <div class="nc-editable w-100 h-100 d-flex flex-column justify-content-center position-absolute" style="background: #0f141e; inset: 0; z-index: 30; padding: 5rem 2rem 2rem 2rem; gap: 1rem;">
                        <div class="nc-upload-zone" onclick="document.getElementById('fileInput').click()" id="dropZone">
                            <i class="fa fa-upload"></i>
                            <span>Drag & Drop or Click to Upload</span>
                            <input type="file" name="productImages" id="fileInput" multiple accept="image/*" style="display: none;" onchange="editor.handleFileSelect(event)" />
                        </div>
                        <div class="nc-url-input-group mt-2">
                            <input type="url" id="newImageUrlInput" class="nc-input" placeholder="Paste Image URL..." />
                            <button type="button" class="btn-nc-primary" style="width: 48px; height: auto; flex-shrink: 0; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: var(--nc-primary); color: #fff; border: none; box-shadow: 0 8px 20px rgba(123, 171, 221, 0.3);" onclick="editor.addImageUrl()"><i class="fa fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                
                <div class="@(Model.ProductImages != null && Model.ProductImages.Count > 0 ? "" : "d-none")" id="galleryContainer">
                    <div class="nc-image-gallery" id="imageGallery">
                        @if (Model.ProductImages != null)
                        {
                            foreach (var img in Model.ProductImages.OrderBy(p => p.SortOrder))
                            {
                                var isPrimary = img.IsPrimary || (Model.ProductImages.FirstOrDefault(p => p.IsPrimary) == null && img == Model.ProductImages.OrderBy(x => x.SortOrder).First());
                                    <div class="nc-gallery-item @(img.Url == primaryUrl ? "active" : "")" 
                                         data-url="@img.Url" 
                                         onclick="if(!document.getElementById('productDetailContainer').classList.contains('nc-edit-mode')) updateMainImage('@img.Url', this)">
                                        <img src="@img.Url" alt="Thumbnail" />
                                        <input type="hidden" name="existingImages" value="@img.Url" />
                                        
                                        <div class="nc-editable nc-item-actions">
                                            <button type="button" class="nc-item-btn btn-thumbnail @(isPrimary ? "active" : "")" onclick="editor.setPrimaryImage(this)" title="Set as Thumbnail"><i class="fa fa-image"></i></button>
                                            <button type="button" class="nc-item-btn btn-edit" onclick="editor.editImageUrl(this)" title="Edit URL"><i class="fa fa-link"></i></button>
                                            <button type="button" class="nc-item-btn btn-danger" onclick="editor.toggleRemoveImage(this)" title="Remove"><i class="fa fa-trash"></i></button>
                                        </div>
                                    </div>
                            }
                        }
                    </div>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
                {
                    <div class="mt-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.75rem;">
                        <div class="nc-meta-stat">
                            <div class="nc-meta-stat-icon"><i class="fa fa-box"></i></div>
                            <div class="nc-meta-stat-content">
                                <span class="nc-meta-stat-label">Stock Status</span>
                                <div class="nc-editable-wrapper" data-field="Stock">
                                    <div class="nc-read-only">
                                        <span class="nc-meta-stat-value nc-editable-span" style="color: @(Model.Stock > 10 ? "#81c784" : Model.Stock > 0 ? "#ffb74d" : "#e57373"); padding: 0.2rem 0.6rem; margin: -0.2rem -0.6rem;">
                                            @Model.Stock units available
                                        </span>
                                    </div>
                                    <div class="nc-input-edit">
                                        <input type="number" name="Stock" value="@Model.Stock" class="nc-input nc-input-sm" style="width: 100px; padding: 0.2rem 0.6rem;" oninput="editor.trackFieldChange('Stock', this.value)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="nc-meta-stat">
                            <div class="nc-meta-stat-icon"><i class="fa fa-star"></i></div>
                            <div class="nc-meta-stat-content">
                                <span class="nc-meta-stat-label">Product Rating</span>
                                <span class="nc-meta-stat-value">
                                    @(Model.SoldAmount > 0 ? Model.Rating.ToString("0.0") : "0.0") <span class="nc-review-count">(@Model.RatingsCount)</span>
                                </span>
                            </div>
                        </div>
                        <div class="nc-meta-stat">
                            <div class="nc-meta-stat-icon"><i class="fa fa-shopping-cart"></i></div>
                            <div class="nc-meta-stat-content">
                                <span class="nc-meta-stat-label">Sales Performance</span>
                                <span class="nc-meta-stat-value">@Model.SoldAmount units sold</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Gutter Admin Actions -->
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
            {
                <div class="nc-gutter-actions">
                    <!-- Read-only Mode Button -->
                    <button type="button" id="enterEditMode" class="nc-gutter-btn btn-edit nc-read-only-hide" title="Edit Product">
                        <i class="fa fa-pen"></i>
                    </button>
                    
                    <!-- Edit Mode Buttons (Cancel replaces Edit position) -->
                    <button type="button" id="exitEditMode" class="nc-gutter-btn nc-btn-cancel-edit nc-editable" style="display:none;" title="Cancel Editing">
                        <i class="fa fa-times"></i>
                    </button>

                    <button type="button" class="nc-gutter-btn btn-delete nc-read-only-hide" onclick="window.confirmDelete('@Model.Id', '@Url.Action("Delete", "Products")', null, this)" title="Delete Product">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            }

            <!-- Info Section -->
            <div>
                <div>
                    <div class="nc-editable-wrapper" data-field="BrandId">
                        <div class="nc-read-only">
                            <a href="@Url.Action("Index", "Home", new { brand = Model.Brand?.Name })#catalog-section" class="nc-detail-brand nc-editable-span" style="text-decoration:none;">@(Model.Brand?.Name ?? "No Brand")</a>
                        </div>
                        <div class="nc-input-edit">
                            <select name="BrandId" class="nc-detail-brand" onchange="editor.trackFieldChange('BrandId', this.value)">
                                @foreach(var b in brands) {
                                    <option value="@b.Id" selected="@(b.Id == Model.BrandId ? "selected" : null)">@b.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="nc-editable-wrapper mt-2" data-field="Name">
                        <div class="nc-read-only">
                            <h1 class="nc-detail-name nc-editable-span">@Model.Name</h1>
                        </div>
                        <div class="nc-input-edit">
                            <textarea name="Name" class="nc-input nc-detail-name-edit" rows="1" oninput="editor.autoSize(this); editor.trackFieldChange('Name', this.value)">@Model.Name</textarea>
                        </div>
                    </div>

                    <div class="nc-editable-wrapper mt-3" data-field="Price">
                        <div class="position-relative flex-grow-1">
                            <div class="nc-read-only" style="position: relative;">
                                <span class="nc-currency-sign" style="position: absolute; left: 0; top: 0rem; pointer-events: none;">₱</span>
                                <span class="nc-detail-price nc-editable-span" style="padding: 0.2rem 0.75rem 0.2rem 2.25rem; margin: -0.2rem -0.25rem;">@Model.Price.ToString("N2")</span>
                            </div>
                            <div class="nc-input-edit position-relative">
                                <span class="nc-currency-sign" style="position: absolute; left: 0.75rem; top: 0.2rem; z-index: 5; pointer-events: none; opacity: 0.8;">₱</span>
                                <input type="number" step="0.01" name="Price" value="@Model.Price" class="nc-price-input" style="padding-left: 2.25rem;" oninput="editor.trackFieldChange('Price', this.value)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 3rem;"></div> <!-- Price gap to description -->

                <div>
                    <h3>About this product</h3>
                    <div class="nc-editable-wrapper" data-field="Description">
                        <div class="nc-read-only">
                            <p class="nc-description nc-editable-span">@(string.IsNullOrEmpty(Model.Description) ? "No description provided for this product." : Model.Description)</p>
                        </div>
                        <div class="nc-input-edit">
                            <textarea name="Description" class="nc-input" rows="5" oninput="editor.trackFieldChange('Description', this.value)">@Model.Description</textarea>
                        </div>
                    </div>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
                {
                    <div>
                        <h3>Banner Data</h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; background: rgba(255,255,255,0.02); padding: 2rem; border-radius: 1.5rem; border: 1px solid rgba(255,255,255,0.05);">
                            <div>
                                <span class="nc-spec-label">Banner Status</span>
                                <div class="nc-editable-wrapper" data-field="IsBanner">
                                    <div class="nc-read-only">
                                        <span class="badge-nc @(Model.IsBanner ? "bg-success" : "bg-secondary") nc-editable-span" style="color: white !important;">@(Model.IsBanner ? "Featured" : "Not Featured")</span>
                                    </div>
                                    <div class="nc-input-edit">
                                        <label class="d-flex align-items-center" style="gap: 0.75rem; cursor: pointer; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.75rem 1rem; border-radius: 0.75rem; width: max-content;">
                                            <input type="checkbox" name="IsBanner" value="true" @(Model.IsBanner ? "checked" : "") onchange="editor.trackFieldChange('IsBanner', this.checked)" style="width: 1.25rem; height: 1.25rem; accent-color: var(--nc-primary); cursor: pointer;" />
                                            <span style="margin: 0; white-space: nowrap; font-size: 0.85rem; font-weight: 600; color: #fff; text-transform: uppercase; letter-spacing: 0.05em;">Active as Banner</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div style="grid-column: span 2;">
                                <span class="nc-spec-label">Banner Text</span>
                                <div class="nc-editable-wrapper" data-field="BannerDescription">
                                    <div class="nc-read-only">
                                        <p class="nc-spec-value nc-editable-span">@(Model.BannerDescription ?? "None")</p>
                                    </div>
                                    <div class="nc-input-edit">
                                        <textarea name="BannerDescription" class="nc-input nc-input-sm" rows="2" oninput="editor.trackFieldChange('BannerDescription', this.value)">@Model.BannerDescription</textarea>
                                    </div>
                                </div>
                            </div>
                            <div style="grid-column: span 2;">
                                <span class="nc-spec-label">Banner Image</span>
                                <div class="nc-read-only-hide mb-2">
                                    @if(!string.IsNullOrEmpty(Model.BannerImageUrl)) {
                                        <div>
                                            <img src="@Model.BannerImageUrl" class="nc-banner-preview" id="currentBannerPreview" onclick="openFullscreen(this.src)" />
                                        </div>
                                    } else {
                                        <span class="nc-spec-value" id="currentBannerPreviewEmpty">None</span>
                                    }
                                </div>
                                <div class="nc-editable nc-editable-block" style="margin-top: 0.5rem;">
                                    @if(!string.IsNullOrEmpty(Model.BannerImageUrl)) {
                                        <div class="mb-2" id="bannerPreviewContainerEdit">
                                            <img src="@Model.BannerImageUrl" class="nc-banner-preview" id="currentBannerPreviewEdit" onclick="openFullscreen(this.src)" />
                                        </div>
                                    } else {
                                        <div class="mb-2" id="bannerPreviewContainerEdit" style="display:none;">
                                            <img src="" class="nc-banner-preview" id="currentBannerPreviewEdit" onclick="openFullscreen(this.src)" />
                                        </div>
                                    }
                                    <div class="nc-upload-zone" onclick="document.getElementById('bannerFileInput').click()" id="bannerDropZone" style="padding: 1rem 0;">
                                        <i class="fa fa-upload"></i>
                                        <span>Drop/Click Banner</span>
                                        <input type="file" name="bannerImage" id="bannerFileInput" accept="image/*" style="display:none;" onchange="editor.handleBannerSelect(event)" />
                                    </div>
                                    <div class="nc-url-input-group mt-2">
                                        <input type="url" name="BannerImageUrl" id="bannerUrlInput" value="@Model.BannerImageUrl" class="nc-input" placeholder="Banner URL..." oninput="editor.trackFieldChange('BannerImageUrl', this.value); if(this.value) { document.getElementById('bannerPreviewContainerEdit').style.display='block'; document.getElementById('currentBannerPreviewEdit').src = this.value; }" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </form>

    <!-- Save Bar (Hidden by default) -->
    <div id="editorSaveBar" class="nc-save-bar" style="display: none;">
        <div class="d-flex align-items-center" style="gap: 2rem;">
            <span class="text-white fw-medium"><i class="fa fa-info-circle me-2"></i> Unsaved changes detected</span>
            <div class="d-flex" style="gap: 0.75rem;">
                <button type="button" id="clearEditorChanges" class="btn-nc-outline btn-sm"><i class="fa fa-undo"></i> Clear</button>
                <button type="button" id="saveEditorChanges" class="btn-nc-primary btn-sm"><i class="fa fa-save"></i> Review & Save</button>
            </div>
        </div>
    </div>
</div>

<div id="fullscreenOverlay" class="nc-fullscreen-overlay" onclick="closeFullscreen()">
    <span class="nc-close-btn">&times;</span>
    <img id="fullscreenImg" src="" />
</div>

<script>
    const editor = {
        originalValues: {},
        currentValues: {},
        changedFields: new Set(),
        images: [],
        currentImgIndex: 0,
        isInfiniteScrolling: false,
        dragSrcGalleryEl: null,

        init: function() {
            console.log("Product Editor Initializing...");
            this.images = Array.from(document.querySelectorAll('.nc-carousel-slide'))
                               .map(s => s.dataset.url)
                               .filter(url => url && !url.includes('placehold.co'));
            
            // Capture initial values
            const form = document.getElementById('inPlaceEditForm');
            if (form) {
                const formData = new FormData(form);
                for (let [key, value] of formData.entries()) {
                    if (key !== '__RequestVerificationToken') {
                        this.originalValues[key] = value;
                        this.currentValues[key] = value;
                    }
                }
            }

            this.setupClickToEdit();
            this.setupCarousel();
            this.setupRevertIndicators();
            this.setupDragDrop();
        },

        setupDragDrop: function() {
            ['dropZone', 'bannerDropZone'].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('dragover', (e) => { e.preventDefault(); el.classList.add('drag-over'); });
                ['dragleave', 'drop'].forEach(ev => el.addEventListener(ev, () => el.classList.remove('drag-over')));
                el.addEventListener('drop', (e) => {
                    e.preventDefault();
                    if (id === 'dropZone') this.handleFileSelect({ target: { files: e.dataTransfer.files } });
                    else this.handleBannerSelect({ target: { files: e.dataTransfer.files } });
                });
            });
        },

        setupClickToEdit: function() {
            document.querySelectorAll('.nc-editable-span').forEach(span => {
                span.addEventListener('click', (e) => {
                    const wrapper = span.closest('.nc-editable-wrapper');
                    if (!wrapper) return;
                    
                    // Only enter edit mode if we are actually in global edit mode
                    const container = document.getElementById('productDetailContainer');
                    if (!container.classList.contains('nc-edit-mode')) return;

                    wrapper.classList.add('nc-is-editing');
                    const input = wrapper.querySelector('input, select, textarea');
                    if (input) {
                        input.focus();
                        if (input.tagName === 'TEXTAREA') this.autoSize(input);
                    }
                });
            });

            // Initialize drag and drop
            document.querySelectorAll('.nc-gallery-item').forEach(el => editor.setupGalleryDragAndDrop(el));

            // Blur to exit field edit mode (but keep global edit mode)
            document.addEventListener('focusout', (e) => {
                if (e.target.matches('.nc-input, .nc-price-input, select, textarea')) {
                    const wrapper = e.target.closest('.nc-editable-wrapper');
                    if (wrapper) {
                        // Small delay to allow clicking buttons if any
                        setTimeout(() => {
                            if (!wrapper.contains(document.activeElement)) {
                                wrapper.classList.remove('nc-is-editing');
                                this.updateSpans(wrapper);
                            }
                        }, 150);
                    }
                }
            });
        },

        updateSpans: function(wrapper) {
            const span = wrapper.querySelector('.nc-editable-span');
            const input = wrapper.querySelector('input, select, textarea');
            if (span && input) {
                if (input.tagName === 'SELECT') {
                    span.textContent = input.options[input.selectedIndex]?.text || "None";
                } else if (input.type === 'checkbox') {
                    span.textContent = input.checked ? "Featured" : "Not Featured";
                    span.className = `badge-nc ${input.checked ? 'bg-success' : 'bg-secondary'} nc-editable-span`;
                } else {
                    span.textContent = input.value || (wrapper.dataset.field === 'Description' ? "No description" : "None");
                }
            }
        },

        setupRevertIndicators: function() {
            document.addEventListener('mousedown', (e) => {
                const wrapper = e.target.closest('.nc-editable-wrapper');
                if (!wrapper || !wrapper.classList.contains('nc-changed')) return;

                // Detect click on the left border (indicator)
                const rect = wrapper.getBoundingClientRect();
                const clickX = e.clientX - rect.left;
                
                if (clickX >= 0 && clickX <= 15) {
                    this.showRevertPopup(wrapper, e.clientX, e.clientY);
                }
            });
        },

        showRevertPopup: function(wrapper, x, y) {
            const field = wrapper.dataset.field;
            const original = this.originalValues[field];
            const current = this.currentValues[field];
            
            // Remove existing popups
            document.querySelectorAll('.nc-revert-popup').forEach(p => p.remove());

            const popup = document.createElement('div');
            popup.className = 'nc-revert-popup';
            popup.style.left = `${x}px`;
            popup.style.top = `${y + 10}px`;

            let originalDisplay = original;
            if (field === 'IsBanner') originalDisplay = original === 'true' ? "Featured" : "Not Featured";
            if (field === 'BrandId') {
                const select = wrapper.querySelector('select');
                const opt = select.querySelector(`option[value="${original}"]`);
                originalDisplay = opt ? opt.text : original;
            }

            popup.innerHTML = `
                <div style="font-size: 0.75rem; color: var(--nc-text-muted); margin-bottom: 0.5rem; text-transform: uppercase;">Original Value</div>
                <div style="font-weight: 600; color: #fff; margin-bottom: 1rem; word-break: break-all;">${originalDisplay}</div>
                <button type="button" class="btn-nc-primary btn-sm w-100" onclick="editor.revertField('${field}')">
                    <i class="fa fa-undo me-2"></i> Revert Change
                </button>
            `;

            document.body.appendChild(popup);

            // Close popup on click outside
            const closeHandler = (e) => {
                if (!popup.contains(e.target)) {
                    popup.remove();
                    document.removeEventListener('mousedown', closeHandler);
                }
            };
            setTimeout(() => document.addEventListener('mousedown', closeHandler), 10);
        },

        trackFieldChange: function(field, value) {
            const wrapper = document.querySelector(`.nc-editable-wrapper[data-field="${field}"]`);
            const original = this.originalValues[field];
            
            // Normalize for comparison
            const isChanged = String(value) !== String(original);
            
            if (isChanged) {
                if (wrapper) wrapper.classList.add('nc-changed');
                this.changedFields.add(field);
                this.currentValues[field] = value;
            } else {
                if (wrapper) wrapper.classList.remove('nc-changed');
                this.changedFields.delete(field);
                this.currentValues[field] = original;
            }

            this.updateSaveBar();
        },

        revertField: function(field) {
            const wrapper = document.querySelector(`.nc-editable-wrapper[data-field="${field}"]`);
            const input = wrapper?.querySelector('input, select, textarea');
            if (!input) return;

            const original = this.originalValues[field];
            if (input.type === 'checkbox') {
                input.checked = original === 'true' || original === true;
            } else {
                input.value = original;
            }

            this.trackFieldChange(field, original);
            this.updateSpans(wrapper);
            document.querySelectorAll('.nc-revert-popup').forEach(p => p.remove());
        },

        autoSize: function(el) {
            if (!el || el.tagName !== 'TEXTAREA') return;
            el.style.height = 'auto';
            el.style.height = (el.scrollHeight) + 'px';
        },

        // ── Carousel Logic (Infinite) ──────────────────────────
        setupCarousel: function() {
            const track = document.getElementById('carouselTrack');
            if (!track || this.images.length <= 1) return;

            // Clone first and last for infinite effect
            const slides = Array.from(track.querySelectorAll('.nc-carousel-slide'));
            const firstClone = slides[0].cloneNode(true);
            const lastClone = slides[slides.length - 1].cloneNode(true);
            
            track.appendChild(firstClone);
            track.insertBefore(lastClone, slides[0]);

            this.currentImgIndex = 1; // Start at the real first slide
            this.updateCarouselPos(false);
        },

        updateCarouselPos: function(smooth = true) {
            const track = document.getElementById('carouselTrack');
            if (!track) return;
            track.style.transition = smooth ? 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)' : 'none';
            track.style.transform = `translateX(-${this.currentImgIndex * 100}%)`;

            // Update gallery highlights
            const realIdx = this.getRealIndex();
            document.querySelectorAll('.nc-image-gallery .nc-gallery-item').forEach((item, i) => {
                item.classList.toggle('active', i === realIdx);
            });
        },

        getRealIndex: function() {
            if (this.images.length === 0) return 0;
            let idx = this.currentImgIndex - 1;
            if (idx < 0) idx = this.images.length - 1;
            if (idx >= this.images.length) idx = 0;
            return idx;
        },

        carouselNext: function(e) {
            if (e) e.stopPropagation();
            if (this.isInfiniteScrolling) return;
            this.currentImgIndex++;
            this.updateCarouselPos();

            if (this.currentImgIndex > this.images.length) {
                this.isInfiniteScrolling = true;
                setTimeout(() => {
                    this.currentImgIndex = 1;
                    this.updateCarouselPos(false);
                    this.isInfiniteScrolling = false;
                }, 600);
            }
        },

        carouselPrev: function(e) {
            if (e) e.stopPropagation();
            if (this.isInfiniteScrolling) return;
            this.currentImgIndex--;
            this.updateCarouselPos();

            if (this.currentImgIndex < 1) {
                this.isInfiniteScrolling = true;
                setTimeout(() => {
                    this.currentImgIndex = this.images.length;
                    this.updateCarouselPos(false);
                    this.isInfiniteScrolling = false;
                }, 600);
            }
        },

        toImage: function(index) {
            this.currentImgIndex = index + 1;
            this.updateCarouselPos();
        },

        // ── Image Management ──────────────────────────────────
        handleFileSelect: function(e) {
            const files = e.target.files;
            if (!files || files.length === 0) return;

            for (let file of files) {
                const reader = new FileReader();
                reader.onload = (event) => {
                    this.appendTempImage(event.target.result);
                };
                reader.readAsDataURL(file);
            }
        },

        appendTempImage: function(src) {
            const gallery = document.getElementById('imageGallery');
            const container = document.getElementById('galleryContainer');
            container.classList.remove('d-none');

            const item = document.createElement('div');
            item.className = 'nc-gallery-item';
            item.dataset.url = src;
            item.innerHTML = `
                <img src="${src}" alt="New Image" />
                <div class="nc-editable nc-item-actions">
                    <button type="button" class="nc-item-btn btn-thumbnail" onclick="editor.setPrimaryImage(this)"><i class="fa fa-image"></i></button>
                    <button type="button" class="nc-item-btn btn-danger" onclick="this.closest('.nc-gallery-item').remove(); editor.refreshCarousel();"><i class="fa fa-trash"></i></button>
                </div>
            `;
            gallery.appendChild(item);
            this.setupGalleryDragAndDrop(item);
            this.refreshCarousel();
            this.changedFields.add('Images');
            this.updateSaveBar();
        },

        setupGalleryDragAndDrop: function(item) {
            item.setAttribute('draggable', 'true');
            item.addEventListener('dragstart', function(e) {
                if (!document.getElementById('productDetailContainer').classList.contains('nc-edit-mode')) {
                    e.preventDefault();
                    return;
                }
                if (e.target.tagName.toLowerCase() === 'input' || e.target.tagName.toLowerCase() === 'button' || e.target.closest('.nc-item-btn')) {
                    e.preventDefault();
                    return;
                }
                editor.dragSrcGalleryEl = this;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/html', this.innerHTML);
                this.style.opacity = '0.4';
            });

            item.addEventListener('dragover', function(e) {
                if (e.preventDefault) e.preventDefault();
                e.dataTransfer.dropEffect = 'move';

                if (editor.dragSrcGalleryEl && editor.dragSrcGalleryEl !== this) {
                    const container = this.parentNode;
                    const items = Array.from(container.querySelectorAll('.nc-gallery-item'));
                    const srcIndex = items.indexOf(editor.dragSrcGalleryEl);
                    const targetIndex = items.indexOf(this);

                    if (srcIndex < targetIndex) {
                        container.insertBefore(editor.dragSrcGalleryEl, this.nextSibling);
                    } else {
                        container.insertBefore(editor.dragSrcGalleryEl, this);
                    }
                }
                return false;
            });

            item.addEventListener('dragenter', function(e) {
                if (editor.dragSrcGalleryEl && editor.dragSrcGalleryEl !== this) {
                    this.style.border = '2px dashed var(--nc-primary)';
                }
            });

            item.addEventListener('dragleave', function(e) {
                this.style.border = '2px solid transparent';
            });

            item.addEventListener('drop', function(e) {
                if (e.stopPropagation) e.stopPropagation();
                return false;
            });

            item.addEventListener('dragend', function(e) {
                this.style.opacity = '1';
                document.querySelectorAll('.nc-gallery-item').forEach(el => {
                    el.style.border = '2px solid transparent';
                });
                editor.updateImageOrder();
                editor.refreshCarousel();
                editor.changedFields.add('Images');
                editor.updateSaveBar();
            });
        },

        addImageUrl: function() {
            const input = document.getElementById('newImageUrlInput');
            const url = input.value.trim();
            if (!url) return;
            this.appendTempImage(url);
            input.value = '';
        },

        handleBannerSelect: function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (event) => {
                const wrapper = document.querySelector('.nc-editable-wrapper[data-field="BannerImageUrl"]');
                const previewImgEdit = document.getElementById('currentBannerPreviewEdit');
                if (previewImgEdit) {
                    document.getElementById('bannerPreviewContainerEdit').style.display = 'block';
                    previewImgEdit.src = event.target.result;
                }
                this.trackFieldChange('BannerImageUrl', event.target.result);
            };
            reader.readAsDataURL(file);
        },

        refreshCarousel: function() {
            const track = document.getElementById('carouselTrack');
            if (!track) return;
            
            this.images = Array.from(document.querySelectorAll('.nc-gallery-item:not(.nc-to-delete)'))
                               .map(it => it.dataset.url);
            
            track.innerHTML = '';
            if (this.images.length === 0) {
                track.innerHTML = `<div class="nc-carousel-slide"><img src="https://placehold.co/800x600/1a1f2c/7babdd?text=No+Image" class="nc-main-image" /></div>`;
            } else {
                this.images.forEach(url => {
                    const slide = document.createElement('div');
                    slide.className = 'nc-carousel-slide';
                    slide.dataset.url = url;
                    slide.innerHTML = `<img src="${url}" class="nc-main-image" onclick="openFullscreen(this.src)" />`;
                    track.appendChild(slide);
                });
            }
            this.setupCarousel(); // Re-clone for infinite
            this.updateImageOrder();
        },

        setPrimaryImage: function(btn) {
            const item = btn.closest('.nc-gallery-item');
            document.querySelectorAll('.btn-thumbnail').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            
            document.getElementById('primaryImageInput').value = item.dataset.url;
            this.changedFields.add('PrimaryImage');
            this.updateSaveBar();
        },

        editImageUrl: function(btn) {
            const item = btn.closest('.nc-gallery-item');
            const oldUrl = item.dataset.url;
            const newUrl = prompt("Enter new Image URL:", oldUrl);
            if (newUrl && newUrl !== oldUrl) {
                item.dataset.url = newUrl;
                item.querySelector('img').src = newUrl;
                this.refreshCarousel();
                this.changedFields.add('Images');
                this.updateSaveBar();
            }
        },

        toggleRemoveImage: function(btn) {
            const item = btn.closest('.nc-gallery-item');
            const url = item.dataset.url;
            item.classList.toggle('nc-to-delete');
            
            const deletedInput = document.getElementById('deletedImagesInput');
            const deleted = JSON.parse(deletedInput.value || "[]");
            
            if (item.classList.contains('nc-to-delete')) {
                item.style.opacity = '0.3';
                deleted.push(url);
            } else {
                item.style.opacity = '1';
                const idx = deleted.indexOf(url);
                if (idx !== -1) deleted.splice(idx, 1);
            }
            
            deletedInput.value = JSON.stringify(deleted);
            this.refreshCarousel();
            this.changedFields.add('Images');
            this.updateSaveBar();
        },

        updateImageOrder: function() {
            const urls = Array.from(document.querySelectorAll('.nc-gallery-item')).map(it => it.dataset.url);
            document.getElementById('imageOrderInput').value = urls.join(',');
        },

        updateSaveBar: function() {
            const bar = document.getElementById('editorSaveBar');
            if (bar) bar.style.display = (this.changedFields.size > 0) ? 'block' : 'none';
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        editor.init();
        document.getElementById('enterEditMode')?.addEventListener('click', enterEditMode);
        document.getElementById('exitEditMode')?.addEventListener('click', cancelEditMode);
        
        document.getElementById('clearEditorChanges')?.addEventListener('click', () => {
            if (confirm("Clear all unsaved changes?")) location.reload();
        });

        document.getElementById('saveEditorChanges')?.addEventListener('click', () => {
            document.getElementById('inPlaceEditForm').submit();
        });
    });

    function enterEditMode() {
        document.getElementById('productDetailContainer').classList.add('nc-edit-mode');
        document.getElementById('enterEditMode').style.display = 'none';
        document.getElementById('exitEditMode').style.display = 'flex';
        document.querySelectorAll('textarea.nc-input').forEach(ta => editor.autoSize(ta));
    }

    function cancelEditMode() {
        if (editor.changedFields.size > 0 && !confirm("Discard unsaved changes?")) return;
        Array.from(editor.changedFields).forEach(field => editor.revertField(field));
        document.getElementById('productDetailContainer').classList.remove('nc-edit-mode');
        document.getElementById('enterEditMode').style.display = 'flex';
        document.getElementById('exitEditMode').style.display = 'none';
        editor.changedFields.clear();
        editor.updateSaveBar();
    }

    function updateMainImage(url, el) {
        const idx = editor.images.indexOf(url);
        if (idx !== -1) editor.toImage(idx);
    }

    function openFullscreen(url) {
        document.getElementById('fullscreenImg').src = url;
        document.getElementById('fullscreenOverlay').style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }

    function closeFullscreen() {
        document.getElementById('fullscreenOverlay').style.display = 'none';
        document.body.style.overflow = '';
    }
</script>

