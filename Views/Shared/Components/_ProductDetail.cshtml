@model MvcMusic.Models.Product

<style>
    /* ── Product Detail Scoped Styles ─────────────────────────────── */
    .nc-detail-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        background: var(--nc-bg-card);
        border: 1px solid var(--nc-border);
        border-radius: var(--nc-radius);
        overflow: hidden;
        padding: 2.5rem;
    }
    @@media (max-width: 768px) {
        .nc-detail-card { grid-template-columns: 1fr; gap: 2rem; }
    }

    .nc-detail-img {
        border-radius: var(--nc-radius-sm);
        overflow: hidden;
        aspect-ratio: 4/3;
        background: var(--nc-bg-secondary);
        border: 1px solid var(--nc-border);
    }
    .nc-detail-img img { width: 100%; height: 100%; object-fit: cover; }

    .nc-detail-brand {
        color: var(--nc-text-muted);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
    }
    .nc-detail-name { font-size: 2rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--nc-text-primary); }
    
    .nc-detail-category {
        display: inline-block;
        background: rgba(123, 171, 221, 0.1);
        border: 1px solid var(--nc-primary);
        color: var(--nc-primary);
        border-radius: 100px;
        padding: 0.2rem 0.8rem;
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
    }

    .nc-detail-price {
        font-size: 2.5rem;
        font-weight: 900;
        color: var(--nc-accent);
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    .nc-detail-desc {
        color: var(--nc-text-secondary);
        line-height: 1.8;
        font-size: 0.95rem;
        margin-bottom: 2rem;
    }

    .nc-detail-meta {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.02);
        border-radius: var(--nc-radius-sm);
        border: 1px solid var(--nc-border);
    }
    .nc-detail-meta-row { display: flex; align-items: center; gap: 1rem; font-size: 0.9rem; }
    .nc-detail-meta-label { color: var(--nc-text-muted); min-width: 100px; }
    .nc-detail-meta-value { color: var(--nc-text-primary); font-weight: 600; }

    .btn-action-primary {
        background: linear-gradient(135deg, #4a5d8a, #374a76);
        color: #fff !important;
        padding: 0.8rem 1.8rem;
        border-radius: var(--nc-radius-sm);
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
    .btn-action-danger {
        background: linear-gradient(135deg, #c62828, #e53935);
        color: #fff !important;
        padding: 0.8rem 1.8rem;
        border-radius: var(--nc-radius-sm);
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>

<div class="nc-detail-card">
    <div class="nc-detail-img">
        <img src="@Model.Image" alt="@Model.Name" onerror="this.src='https://placehold.co/800x600/1a1f2c/7babdd?text=NightCord'" />
    </div>

    <div>
        <div class="nc-detail-brand">@Model.Brand</div>
        <h1 class="nc-detail-name">@Model.Name</h1>
        <span class="nc-detail-category">@Model.Category</span>

        <div class="nc-detail-price">₱ @Model.Price.ToString("N2")</div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="nc-detail-desc">@Model.Description</p>
        }

        <div class="nc-detail-meta">
            <div class="nc-detail-meta-row">
                <span class="nc-detail-meta-label"><i class="fa fa-box me-1"></i> Availability</span>
                <span class="nc-detail-meta-value" style="color:@(Model.Stock > 10 ? "#81c784" : Model.Stock > 0 ? "#ffb74d" : "#e57373")">
                    @Model.Stock units in stock
                </span>
            </div>
            <div class="nc-detail-meta-row">
                <span class="nc-detail-meta-label"><i class="fa fa-star me-1"></i> Rating</span>
                <span class="nc-detail-meta-value">@Model.Rating / 5.0 (@Model.SoldAmount sold)</span>
            </div>
        </div>

        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
        {
            <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-action-primary">
                    <i class="fa fa-pen"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-action-danger">
                    <i class="fa fa-trash"></i> Delete
                </a>
            </div>
        }
    </div>
</div>
