@model MvcMusic.Models.Product
@{
    var categories = ViewBag.Categories as List<MvcMusic.Models.Category> ?? new List<MvcMusic.Models.Category>();
    var brands = ViewBag.Brands as List<MvcMusic.Models.Brand> ?? new List<MvcMusic.Models.Brand>();
    var primaryUrl = Model.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.ProductImages?.FirstOrDefault()?.Url;
}

<div class="nc-detail-container" id="productDetailContainer" data-product-id="@Model.Id">
    <form id="inPlaceEditForm" enctype="multipart/form-data">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="primaryImage" id="primaryImageInput" value="@(Model.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.ProductImages?.FirstOrDefault()?.Url)" />
        <input type="hidden" name="imageOrder" id="imageOrderInput" value="@string.Join(",", (Model.ProductImages ?? new List<MvcMusic.Models.ProductImage>()).OrderBy(p => p.SortOrder).Select(p => p.Url))" />
        <input type="hidden" name="deletedImages" id="deletedImagesInput" value="[]" />

        <div class="nc-detail-card">
            <!-- Visual Section -->
            <div class="d-flex flex-column gap-2">
                <div class="w-100 position-relative overflow-hidden" style="aspect-ratio: 1; border-radius: 2rem; box-shadow: 0 20px 60px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.05);">
                    <div id="productCarousel" class="carousel slide h-100 nc-main-image-wrapper">
                        <div class="carousel-inner h-100" id="carouselTrack">
                            @if (Model.ProductImages != null && Model.ProductImages.Count > 0)
                            {
                                var first = true;
                                foreach (var img in Model.ProductImages.OrderBy(p => p.SortOrder))
                                {
                                    <div class="carousel-item h-100 @(first ? "active" : "")" data-url="@img.Url">
                                        <div class="d-flex align-items-center justify-content-center h-100">
                                            <img src="@img.Url" alt="@Model.Name" class="nc-main-image h-100 w-100" style="object-fit: cover;" onclick="openFullscreen(this.src)" onerror="this.src='https://placehold.co/800x600/1a1f2c/7babdd?text=NightCord'" />
                                        </div>
                                    </div>
                                    first = false;
                                }
                            }
                            else
                            {
                                <div class="carousel-item active h-100">
                                    <img src="https://placehold.co/800x600/1a1f2c/7babdd?text=No+Image" class="nc-main-image h-100 w-100" style="object-fit: cover;" />
                                </div>
                            }
                        </div>
                        
                        <a href="@Url.Action("Index", "Home", new { category = Model.Category?.Name })#catalog-section" class="nc-image-badge nc-read-only-hide" style="text-decoration:none;">@(Model.Category?.Name ?? "Uncategorized")</a>
                        
                        <div class="nc-editable" style="z-index: 21;">
                            <select name="CategoryId" class="nc-input-badge" onchange="editor.trackFieldChange('CategoryId', this.value)">
                                @foreach(var c in categories) {
                                    <option value="@c.Id" selected="@(c.Id == Model.CategoryId ? "selected" : null)">@c.Name</option>
                                }
                            </select>
                        </div>

                        @if (Model.ProductImages != null && Model.ProductImages.Count > 1)
                        {
                            <button class="carousel-control-prev nc-img-nav" type="button" data-bs-target="#productCarousel" data-bs-slide="prev" style="left: 1.5rem; opacity: 1;">
                                <i class="fa fa-chevron-left"></i>
                            </button>
                            <button class="carousel-control-next nc-img-nav" type="button" data-bs-target="#productCarousel" data-bs-slide="next" style="right: 1.5rem; opacity: 1;">
                                <i class="fa fa-chevron-right"></i>
                            </button>
                        }
                    </div>

                    <div class="nc-editable w-100 h-100 d-flex flex-column justify-content-center position-absolute" style="background: #0f141e; inset: 0; z-index: 30; padding: 5rem 2rem 2rem 2rem; gap: 1rem;">
                        <div class="nc-upload-zone" onclick="document.getElementById('fileInput').click()" id="dropZone">
                            <i class="fa fa-upload"></i>
                            <span>Drag & Drop or Click to Upload</span>
                            <input type="file" name="productImages" id="fileInput" multiple accept="image/*" style="display: none;" onchange="editor.handleFileSelect(event)" />
                        </div>
                        <div class="nc-url-input-group mt-2">
                            <input type="url" id="newImageUrlInput" class="nc-input" placeholder="Paste Image URL..." />
                            <button type="button" class="btn-nc-primary" style="width: 48px; height: auto; flex-shrink: 0; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: var(--nc-primary); color: #fff; border: none; box-shadow: 0 8px 20px rgba(123, 171, 221, 0.3);" onclick="editor.addImageUrl()"><i class="fa fa-plus"></i></button>
                        </div>
                    </div>
                </div>
                
                <div class="@(Model.ProductImages != null && Model.ProductImages.Count > 0 ? "" : "d-none")" id="galleryContainer">
                    <div class="nc-image-gallery" id="imageGallery">
                        @if (Model.ProductImages != null)
                        {
                            foreach (var img in Model.ProductImages.OrderBy(p => p.SortOrder))
                            {
                                var isPrimary = img.IsPrimary || (Model.ProductImages.FirstOrDefault(p => p.IsPrimary) == null && img == Model.ProductImages.OrderBy(x => x.SortOrder).First());
                                    <div class="nc-gallery-item @(img.Url == primaryUrl ? "active" : "")" 
                                         data-url="@img.Url" 
                                         onclick="if(!document.getElementById('productDetailContainer').classList.contains('nc-edit-mode')) updateMainImage('@img.Url', this)">
                                        <img src="@img.Url" alt="Thumbnail" />
                                        <input type="hidden" name="existingImages" value="@img.Url" />
                                        
                                        <div class="nc-editable nc-item-actions">
                                            <button type="button" class="nc-item-btn btn-thumbnail @(isPrimary ? "active" : "")" onclick="editor.setPrimaryImage(this)" title="Set as Thumbnail"><i class="fa fa-image"></i></button>
                                            <button type="button" class="nc-item-btn btn-edit" onclick="editor.editImageUrl(this)" title="Edit URL"><i class="fa fa-link"></i></button>
                                            <button type="button" class="nc-item-btn btn-danger" onclick="editor.toggleRemoveImage(this)" title="Remove"><i class="fa fa-trash"></i></button>
                                        </div>
                                    </div>
                            }
                        }
                    </div>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
                {
                    <div class="mt-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 1.75rem;">
                        <div class="nc-meta-stat">
                            <div class="nc-meta-stat-icon"><i class="fa fa-box"></i></div>
                            <div class="nc-meta-stat-content">
                                <span class="nc-meta-stat-label">Stock Status</span>
                                <div class="nc-editable-wrapper" style="margin-bottom: 0;" data-field="Stock">
                                    <div class="nc-read-only">
                                        <span class="nc-meta-stat-value nc-editable-span nc-pd-sync-span-plain" style="color: @(Model.Stock > 10 ? "#81c784" : Model.Stock > 0 ? "#ffb74d" : "#e57373");">
                                            @Model.Stock units available
                                        </span>
                                    </div>
                                    <div class="nc-input-edit">
                                        <input type="number" name="Stock" value="@Model.Stock" class="nc-pd-select" style="width: 100%; padding: 0.15rem 0.5rem;" oninput="editor.trackFieldChange('Stock', this.value)" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="nc-meta-stat">
                            <div class="nc-meta-stat-icon"><i class="fa fa-star"></i></div>
                            <div class="nc-meta-stat-content">
                                <span class="nc-meta-stat-label">Product Rating</span>
                                <span class="nc-meta-stat-value">
                                    @(Model.SoldAmount > 0 ? Model.Rating.ToString("0.0") : "0.0") <span class="nc-review-count">(@Model.RatingsCount)</span>
                                </span>
                            </div>
                        </div>
                        <div class="nc-meta-stat">
                            <div class="nc-meta-stat-icon"><i class="fa fa-shopping-cart"></i></div>
                            <div class="nc-meta-stat-content">
                                <span class="nc-meta-stat-label">Sales Performance</span>
                                <span class="nc-meta-stat-value">@Model.SoldAmount units sold</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Gutter Admin Actions -->
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
            {
                <div class="nc-gutter-actions">
                    <!-- Read-only Mode Button -->
                    <button type="button" id="enterEditMode" class="nc-gutter-btn btn-edit nc-read-only-hide" title="Edit Product">
                        <i class="fa fa-pen"></i>
                    </button>
                    
                    <!-- Edit Mode Buttons -->
                    <div class="nc-editable-actions flex-column gap-3">
                        <button type="button" id="exitEditMode" class="nc-gutter-btn nc-btn-cancel-edit" title="Exit Cancel">
                            <i class="fa fa-times"></i>
                        </button>

                        <div class="nc-action-wrapper position-relative">
                            <div id="changesIndicator" class="nc-changes-badge" style="display: none;" title="Unsaved Changes">0</div>
                            <button type="button" id="saveEditorChangesGutter" class="nc-gutter-btn btn-save" style="background: var(--nc-primary); color: white;" title="Save Changes">
                                <i class="fa fa-save"></i>
                            </button>
                            <div id="localizedSavePopup" class="ut-diff-modal nc-localized-popup" style="display:none; right: calc(100% + 15px); top: 0;"></div>
                        </div>

                        <div class="nc-action-wrapper position-relative">
                            <button type="button" id="clearEditorChangesGutter" class="nc-gutter-btn btn-clear" style="background: rgba(255,255,255,0.05); color: #ffb74d;" title="Clear Changes">
                                <i class="fa fa-undo"></i>
                            </button>
                            <div id="localizedClearPopup" class="ut-diff-modal nc-localized-popup" style="display:none; right: calc(100% + 15px); top: 0;"></div>
                        </div>
                    </div>

                    <button type="button" class="nc-gutter-btn btn-delete nc-read-only-hide" onclick="window.confirmDelete('@Model.Id', '@Url.Action("Delete", "Products")', null, this)" title="Delete Product">
                        <i class="fa fa-trash"></i>
                    </button>
                </div>
            }

            <!-- Info Section -->
            <div>
                <div>
                    <div class="nc-editable-wrapper" data-field="BrandId">
                        <div class="nc-read-only">
                            <a href="@Url.Action("Index", "Home", new { brand = Model.Brand?.Name })#catalog-section" class="nc-detail-brand nc-editable-span nc-pd-sync-span-plain d-inline-block" style="text-decoration:none; padding-left: 0.5rem; margin-left: -0.5rem;">@(Model.Brand?.Name ?? "No Brand")</a>
                        </div>
                        <div class="nc-input-edit">
                            <select name="BrandId" id="edit-brand" class="nc-detail-brand nc-pd-select">
                                @foreach(var b in brands) {
                                    <option value="@b.Id" selected="@(b.Id == Model.BrandId ? "selected" : null)">@b.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="nc-editable-wrapper" style="margin-bottom: 2rem;" data-field="Name">
                        <div class="nc-read-only">
                            <h1 class="nc-detail-name nc-editable-span nc-pd-sync-span" style="margin:0;">@Model.Name</h1>
                        </div>
                        <div class="nc-input-edit">
                            <div class="nc-pd-floating-group nc-static-placeholder">
                                <textarea name="Name" id="edit-name" class="nc-pd-floating-control nc-detail-name-edit" rows="1" placeholder=" ">@Model.Name</textarea>
                                <label for="edit-name" class="nc-pd-floating-label">Product Name</label>
                            </div>
                        </div>
                    </div>

                    <div class="nc-editable-wrapper" data-field="Price">
                        <div class="position-relative flex-grow-1">
                            <div class="nc-read-only position-relative">
                                <div style="display: flex; align-items: center; width: 100%;">
                                    <span class="nc-currency-sign" style="position: absolute; left: 1rem; z-index: 5; margin: 0; padding: 0;">₱</span>
                                    <span class="nc-detail-price nc-editable-span nc-pd-sync-span-plain" style="padding-left: 2.75rem; width: 100%;">@Model.Price.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="nc-input-edit position-relative">
                                <div style="display: flex; align-items: center; width: 100%;">
                                    <span class="nc-currency-sign" style="position: absolute; left: 1rem; z-index: 5; margin: 0; padding: 0;">₱</span>
                                    <input type="number" step="0.01" name="Price" id="edit-price" value="@Model.Price" class="nc-pd-select nc-price-input" style="padding-left: 2.75rem; width: 100%;" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div style="margin-top: 3rem;"></div> <!-- Price gap to description -->

                <div class="mt-4">
                    <h3 class="nc-section-title">About this product</h3>
                    <div class="nc-editable-wrapper" data-field="Description">
                        <div class="nc-read-only">
                            <p class="nc-description nc-editable-span nc-pd-sync-span" style="margin:0;">@(string.IsNullOrEmpty(Model.Description) ? "No description provided for this product." : Model.Description)</p>
                        </div>
                        <div class="nc-input-edit">
                            <div class="nc-pd-floating-group">
                                <textarea name="Description" id="edit-description" class="nc-pd-floating-control nc-description-edit" rows="5" placeholder=" ">@Model.Description</textarea>
                                <label for="edit-description" class="nc-pd-floating-label">Description</label>
                            </div>
                        </div>
                    </div>
                </div>

                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("Staff"))
                {
                    <div>
                        <h3>Banner Data</h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; background: rgba(255,255,255,0.02); padding: 2rem; border-radius: 1.5rem; border: 1px solid rgba(255,255,255,0.05);">
                            <div>
                                <span class="nc-spec-label">Banner Status</span>
                                <div class="nc-editable-wrapper" data-field="IsBanner">
                                    <div class="nc-read-only">
                                        <span class="badge-nc @(Model.IsBanner ? "bg-success" : "bg-secondary") nc-editable-span" style="color: white !important;">@(Model.IsBanner ? "Featured" : "Not Featured")</span>
                                    </div>
                                    <div class="nc-input-edit">
                                        <label class="d-flex align-items-center" style="gap: 0.75rem; cursor: pointer; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.75rem 1rem; border-radius: 0.75rem; width: max-content;">
                                            <input type="checkbox" name="IsBanner" value="true" @(Model.IsBanner ? "checked" : "") style="width: 1.25rem; height: 1.25rem; accent-color: var(--nc-primary); cursor: pointer;" />
                                            <span style="margin: 0; white-space: nowrap; font-size: 0.85rem; font-weight: 600; color: #fff; text-transform: uppercase; letter-spacing: 0.05em;">Active as Banner</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div style="grid-column: span 2;">
                                <span class="nc-spec-label">Banner Text</span>
                                <div class="nc-editable-wrapper" data-field="BannerDescription">
                                    <div class="nc-read-only">
                                        <p class="nc-spec-value nc-editable-span nc-pd-sync-span" style="margin:0;">@(Model.BannerDescription ?? "None")</p>
                                    </div>
                                    <div class="nc-input-edit">
                                        <textarea name="BannerDescription" id="edit-banner-desc" class="nc-description-edit" rows="2" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 0.75rem; padding: 0.75rem 1rem; color: #fff; width: 100%; font-family: inherit;">@Model.BannerDescription</textarea>
                                    </div>
                                </div>
                            </div>
                            <div style="grid-column: span 2;">
                                <span class="nc-spec-label">Banner Image</span>
                                <div class="nc-read-only-hide mb-2">
                                    @if(!string.IsNullOrEmpty(Model.BannerImageUrl)) {
                                        <div>
                                            <img src="@Model.BannerImageUrl" class="nc-banner-preview" id="currentBannerPreview" onclick="openFullscreen(this.src)" />
                                        </div>
                                    } else {
                                        <span class="nc-spec-value" id="currentBannerPreviewEmpty">None</span>
                                    }
                                </div>
                                <div class="nc-editable nc-editable-block" style="margin-top: 0.5rem;">
                                    @if(!string.IsNullOrEmpty(Model.BannerImageUrl)) {
                                        <div class="mb-2" id="bannerPreviewContainerEdit">
                                            <img src="@Model.BannerImageUrl" class="nc-banner-preview" id="currentBannerPreviewEdit" onclick="openFullscreen(this.src)" />
                                        </div>
                                    } else {
                                        <div class="mb-2" id="bannerPreviewContainerEdit" style="display:none;">
                                            <img src="" class="nc-banner-preview" id="currentBannerPreviewEdit" onclick="openFullscreen(this.src)" />
                                        </div>
                                    }
                                    <div class="nc-upload-zone" onclick="document.getElementById('bannerFileInput').click()" id="bannerDropZone" style="padding: 1rem 0;">
                                        <i class="fa fa-upload"></i>
                                        <span>Drop/Click Banner</span>
                                        <input type="file" name="bannerImage" id="bannerFileInput" accept="image/*" style="display:none;" />
                                    </div>
                                    <div class="nc-url-input-group mt-2">
                                        <input type="url" name="BannerImageUrl" id="bannerUrlInput" value="@Model.BannerImageUrl" class="nc-pd-select" placeholder="Banner URL..." />
                                        <label for="bannerUrlInput" class="nc-pd-floating-label" style="display:none;">Banner Image URL</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </form>

    <!-- Save Changes Modal -->
    <div class="modal fade" id="saveDiffModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content nc-card" style="border:1px solid var(--nc-border); background: #131822 !important;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title nc-page-title fs-5">Confirm Changes</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="padding: 0.8rem;"></button>
                </div>
                <div class="modal-body py-4" id="saveDiffModalBody">
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn-nc-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-nc-primary px-4" onclick="document.getElementById('inPlaceEditForm').submit()">
                        <i class="fa fa-save me-1"></i> Apply Changes
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<div id="fullscreenOverlay" class="nc-fullscreen-overlay" onclick="closeFullscreen()">
    <span class="nc-close-btn">&times;</span>
    <img id="fullscreenImg" src="" />
</div>



<style>
    /* ── Details Container & Card ──────────────────────────────── */
    .nc-detail-container {
        padding: 4rem 0; /* Reduced top padding, relying more on card margins */
        animation: fadeIn 0.6s ease-out;
        position: relative;
        max-width: 1400px;
        margin: 2rem auto; /* Added margin for better centering */
    }

    .nc-detail-card {
        display: grid;
        grid-template-columns: 1.25fr 1fr; /* Slightly wider left side */
        gap: 5rem;
        background: rgba(30, 35, 45, 0.4);
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 2.5rem;
        padding: 4.5rem;
        box-shadow: 0 50px 120px rgba(0,0,0,0.6);
        position: relative;
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Gutter Admin Actions */
    .nc-gutter-actions {
        position: absolute;
        left: calc(100% + 1.5rem);
        top: 2rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        z-index: 100;
    }

    .nc-gutter-btn {
        width: 52px; height: 52px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(30, 35, 45, 0.85);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        font-size: 1.25rem;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }
    
    .nc-gutter-btn.btn-save:hover { background: #4caf50; transform: translateY(-4px); box-shadow: 0 10px 20px rgba(76, 175, 80, 0.4); }
    .nc-gutter-btn.btn-delete:hover { background: #ef5350; transform: translateY(-4px); box-shadow: 0 10px 20px rgba(239, 83, 80, 0.4); }
    .nc-gutter-btn.btn-clear:hover, .nc-gutter-btn.nc-btn-cancel-edit:hover { transform: translateY(-4px); }

    .nc-changes-badge {
        width: 52px;
        height: 52px;
        background: #ffb74d;
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.2rem;
        border: 4px solid var(--nc-bg-card);
        margin-bottom: -0.5rem;
        animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes popIn {
        from { transform: scale(0); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    @@media (max-width: 1550px) {
        .nc-gutter-actions {
            left: auto; right: 1.5rem;
            top: -4.5rem;
            flex-direction: row;
        }
    }

    @@media (max-width: 992px) {
        .nc-detail-card {
            grid-template-columns: 1fr;
            gap: 4rem;
            padding: 2.5rem;
            margin: 0 1rem;
        }
        .nc-gutter-actions {
            position: relative;
            top: 0; right: 0;
            margin-bottom: 2.5rem;
            justify-content: center;
            flex-direction: row;
        }
        .nc-gutter-btn.btn-edit, .nc-gutter-btn.nc-btn-cancel-edit { order: 2; }
        .nc-gutter-btn.btn-delete { order: 1; }
    }

    /* ── Typography & Zero-Shift Stacking ─────────────────────── */
    :root {
        --nc-font-name: 4rem;
        --nc-font-name-mobile: 2.5rem;
        --nc-font-price: 2.5rem;
        --nc-font-brand: 1.1rem;
    }

    .nc-stack-grid {
        display: grid;
        grid-template-areas: "stack";
        align-items: center;
        position: relative;
    }
    .nc-stack-grid > * {
        grid-area: stack;
        transition: opacity 0.4s ease, transform 0.4s ease;
    }

    /* Global Visibility for fixed Actions */
    .nc-editable { opacity: 0; visibility: hidden; pointer-events: none; }
    .nc-editable-block { display: none; }
    .nc-editable-actions { display: none; }
    
    .nc-edit-mode .nc-editable { opacity: 1; visibility: visible; pointer-events: all; }
    .nc-edit-mode .nc-editable-block { display: block; opacity: 1; visibility: visible; pointer-events: all; }
    .nc-edit-mode .nc-editable-actions { display: flex; opacity: 1; pointer-events: all; }
    
    .nc-edit-mode .nc-read-only-hide { opacity: 0; visibility: hidden; pointer-events: none; display: none !important; }

    /* ── Click-To-Edit Dynamic Styling ──────────────────────── */
    /* State: Read Only */
    .nc-editable-wrapper .nc-input-edit {
        display: none;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    /* State: Being Edited */
