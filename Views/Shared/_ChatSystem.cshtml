@using MvcMusic.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model MvcMusic.Models.ChatSystemViewModel

@{
    var currentUserId = UserManager.GetUserId(User);
    var isAdmin = Model.IsAdmin;
}

<div class="nc-chat-system" id="ncChatSystem" data-mode="@(isAdmin ? "admin" : "customer")">
    <div class="chat-layout @(isAdmin ? "support-layout" : "")" id="messenger">
        <!-- Sidebar -->
        <div class="nc-messenger-sidebar">
            <div class="nc-messenger-sidebar-header">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 id="sidebarTitle" class="m-0 fw-bold nc-text-primary">@(isAdmin ? "Support Inbox" : "Messages")</h5>
                    @if (!isAdmin)
                    {
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary border-0" onclick="chatSystem.showNewChatDialog()" id="newChatBtn" title="New Message">
                                <i class="fa fa-plus"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary border-0" onclick="chatSystem.toggleArchiveView()" id="archiveToggleBtn" title="View Archived">
                                <i class="fa fa-clock-rotate-left"></i>
                            </button>
                        </div>
                    }
                </div>
                <div class="nc-search-wrapper mb-2">
                    <i class="fa fa-magnifying-glass nc-search-icon"></i>
                    <input type="text" id="inboxSearch" class="nc-search-input" placeholder="Search conversations...">
                </div>
            </div>
            <div id="inboxList" class="nc-messenger-inbox">
                <div class="p-4 text-center nc-text-lighter">
                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                    <p class="small mb-0">Loading conversations...</p>
                </div>
            </div>
        </div>

        <!-- Main Chat Area -->
        <div class="nc-messenger-main" id="chatArea">
            <div class="nc-messenger-empty" id="chatEmptyState" style="display:none;">
                <i class="fa fa-comments"></i>
                <h3>Select a conversation</h3>
                <p>Choose a chat from the inbox to start messaging @(isAdmin ? "." : Html.Raw("or <a href=\"#\" onclick=\"chatSystem.showNewChatDialog()\" class=\"nc-link-primary\">start a new message</a>."))</p>
            </div>

            <div id="newChatDialog" class="nc-messenger-empty" style="display:none;">
                <i class="fa fa-plus-circle"></i>
                <h2 class="nc-text-gradient mb-3">Start a New Conversation</h2>
                <p class="nc-text-lighter small mb-4">What do you need help with?</p>
                <form id="newChatFormInside" onsubmit="chatSystem.createNewChat(event)" style="width: 100%; max-width: 400px; margin: 0 auto;">
                    @Html.AntiForgeryToken()
                    <div class="mb-4 text-start">
                        <nc-select name="subject" placeholder="Select a topic..." required>
                            <div slot="options">
                                <div class="nc-option" data-value="Order Status">Order Status</div>
                                <div class="nc-option" data-value="Technical Support">Technical Support</div>
                                <div class="nc-option" data-value="Billing Issue">Billing Issue</div>
                                <div class="nc-option" data-value="General Feedback">General Feedback</div>
                            </div>
                        </nc-select>
                    </div>
                    <button type="submit" class="btn btn-primary nc-btn-primary w-100 nc-chat-btn-large">Start Conversation</button>
                </form>
            </div>

            <div id="chatContent" style="display:none; flex:1; flex-direction:column; overflow:hidden;">
                <div class="nc-messenger-header">
                    <div class="d-flex align-items-center justify-content-between w-100">
                        <div class="d-flex align-items-center">
                            <button class="btn-back d-lg-none me-3" onclick="chatSystem.toggleMobileSidebar()">
                                <i class="fa fa-arrow-left"></i>
                            </button>
                            <div>
                                <h4 id="activeRoomSubject" class="nc-room-subject mb-0">Subject</h4>
                                <div id="activeRecipientName" class="nc-room-last-msg">Recipient</div>
                            </div>
                        </div>
                        
                        <div class="dropdown">
                            <button class="btn btn-link text-white p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end nc-dark-dropdown">
                                @if (!isAdmin) {
                                    <li><a class="dropdown-item" href="#" onclick="chatSystem.archiveCurrentRoom()" id="archiveMenuBtn"><i class="fa fa-box-archive me-2"></i>Archive</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="chatSystem.unarchiveCurrentRoom()" id="unarchiveMenuBtn" style="display:none;"><i class="fa fa-undo me-2"></i>Unarchive</a></li>
                                } else {
                                     <li><a class="dropdown-item text-danger" href="#" onclick="chatSystem.deleteCurrentRoom(this)"><i class="fa fa-trash-can me-2"></i>Discard (Draft)</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="nc-messenger-body" id="messageList">
                    <!-- Messages loaded here -->
                </div>

                <div id="typingIndicator" class="nc-typing-indicator mx-3" style="display:none;">
                    <span id="typingName">Someone</span> is typing
                    <div class="nc-typing-dots"><span></span><span></span><span></span></div>
                </div>

                <div class="nc-messenger-footer">
                    <div class="nc-chat-input-wrapper">
                        <input type="text" id="messageInput" class="nc-chat-input" placeholder="Type a message..." autocomplete="off">
                        <button id="sendButton" class="btn-chat-send" onclick="chatSystem.sendMessage()">
                            <i class="fa fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const chatSystem = {
        connection: null,
        currentRoomId: null,
        isDraftMode: false,
        viewingArchived: false,
        isAdmin: @Json.Serialize(Model.IsAdmin),
        currentUserId: '@currentUserId',
        typingTimeout: null,

        init: async function() {
            this.connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            this.setupHandlers();
            await this.startConnection();
            this.setupUIListeners();
        },

        setupHandlers: function() {
            this.connection.on("ReceiveMessage", (msg) => {
                if (msg.roomId === this.currentRoomId) {
                    this.appendMessage(msg);
                    this.scrollToBottom();
                    if (msg.senderId !== this.currentUserId) {
                        this.connection.invoke("MarkAsSeen", msg.roomId);
                        this.markAsReadApi(msg.roomId);
                    }
                }
                this.updateInboxPreview(msg);
            });

            this.connection.on("MessageSeen", (data) => {
                const roomEl = document.getElementById(`room-${data.roomId}`);
                if (roomEl) {
                    roomEl.classList.remove('unread');
                    roomEl.querySelector('.nc-unread-indicator')?.remove();
                }
            });

            this.connection.on("UpdateInbox", (data) => {
                this.updateInboxPreview(data, data.roomId !== this.currentRoomId);
            });

            this.connection.on("ReceiveTypingStatus", (data) => {
                if (data.roomId === this.currentRoomId && data.senderId !== this.currentUserId) {
                    const indicator = document.getElementById('typingIndicator');
                    const nameSpan = document.getElementById('typingName');
                    if (data.isTyping) {
                        nameSpan.innerText = data.senderName;
                        indicator.style.display = 'block';
                        this.scrollToBottom();
                    } else {
                        indicator.style.display = 'none';
                    }
                }
            });
        },

        startConnection: async function() {
            try {
                await this.connection.start();
                const group = this.isAdmin ? "JoinSupportGroup" : "JoinPersonalGroup";
                await this.connection.invoke(group);
                await this.loadRooms();
            } catch (err) {
                console.error("SignalR Connection Error:", err);
                setTimeout(() => this.startConnection(), 5000);
            }
        },

        loadRooms: async function() {
            const url = this.isAdmin ? "/Support/GetMyRooms" : `/Chat/GetMyRooms?archived=${this.viewingArchived}`;
            const resp = await fetch(url);
            const rooms = await resp.json();
            const list = document.getElementById('inboxList');
            
            // Check URL parameters for initial state (handles refresh)
            const params = new URLSearchParams(window.location.search);
            const rid = params.get('roomId');
            const isNew = params.get('new') === 'true';
            const isArchivedView = params.get('view') === 'archive';

            if (isArchivedView && !this.viewingArchived) {
                this.viewingArchived = true;
                document.getElementById('sidebarTitle').innerText = 'Archive';
                document.getElementById('archiveToggleBtn').innerHTML = '<i class="fa fa-arrow-left"></i>';
                // Recursive call with flag set correctly
                return this.loadRooms();
            }

            if (isNew && !this.isAdmin) {
                this.showNewChatDialog(false); // transition immediately
            } else if (rid) {
                const room = rooms.find(x => x.id == rid);
                if (room) {
                    this.loadChat(room.id, room.subject, this.isAdmin ? (room.customerName || room.customer?.fullName) : "Customer Support");
                } else {
                    this.updateEmptyState();
                }
            } else {
                this.updateEmptyState();
            }

            if (rooms.length === 0) {
                list.innerHTML = `<div class="p-4 text-center nc-text-lighter small">No conversations yet</div>`;
                return;
            }

            list.innerHTML = rooms.map(r => this.renderRoomItem(r)).join('');
            
            // Re-apply search filter if term exists
            const term = document.getElementById('inboxSearch')?.value.toLowerCase().trim();
            if (term) {
                this.applySearchFilter(term);
            }
        },

        renderRoomItem: function(r) {
            const recipient = this.isAdmin ? (r.customerName || r.customer?.fullName || "User") : "Customer Support";
            const avatar = recipient[0].toUpperCase();
            return `
                <div class="nc-inbox-item ${this.currentRoomId === r.id ? 'active' : ''} ${r.unreadCount > 0 ? 'unread' : ''}" 
                     onclick="chatSystem.loadChat(${r.id}, '${r.subject}', '${recipient}')" id="room-${r.id}">
                    <div class="nc-inbox-avatar">${avatar}</div>
                    <div class="nc-inbox-info">
                        <div class="nc-inbox-subject">${r.subject}</div>
                        <div class="nc-inbox-customer">${recipient}</div>
                        <div class="nc-inbox-preview italic">${r.messages?.[0]?.content || r.lastMessage || 'No messages yet'}</div>
                    </div>
                    ${r.unreadCount > 0 ? '<div class="nc-unread-indicator"></div>' : ''}
                </div>
            `;
        },

        loadChat: async function(roomId, subject, recipient) {
            this.currentRoomId = roomId;
            this.isDraftMode = false;
            document.getElementById('messenger').classList.add('show-chat');

            // Clear 'new' param if exists
            const currUrl = new URL(window.location);
            if (currUrl.searchParams.has('new')) {
                currUrl.searchParams.delete('new');
                window.history.pushState({}, '', currUrl);
            }
            
            document.getElementById('chatEmptyState').style.display = 'none';
            document.getElementById('newChatDialog').style.display = 'none';
            document.getElementById('chatContent').style.display = 'flex';
            document.getElementById('activeRoomSubject').innerText = subject;
            document.getElementById('activeRecipientName').innerText = recipient;

            // Toggle Archive/Unarchive buttons
            const archiveBtn = document.getElementById('archiveMenuBtn');
            const unarchiveBtn = document.getElementById('unarchiveMenuBtn');
            if (archiveBtn && unarchiveBtn) {
                archiveBtn.style.display = this.viewingArchived ? 'none' : 'flex';
                unarchiveBtn.style.display = this.viewingArchived ? 'flex' : 'none';
            }

            document.querySelectorAll('.nc-inbox-item').forEach(el => el.classList.remove('active'));
            const activeRoom = document.getElementById(`room-${roomId}`);
            if (activeRoom) {
                activeRoom.classList.add('active');
                if (activeRoom.classList.contains('unread')) {
                    activeRoom.classList.remove('unread');
                    activeRoom.querySelector('.nc-unread-indicator')?.remove();
                    this.connection.invoke("MarkAsSeen", roomId);
                    this.markAsReadApi(roomId);
                }
            }

            const url = this.isAdmin ? `/Support/GetMessages?roomId=${roomId}` : `/Chat/GetMessages?roomId=${roomId}`;
            const resp = await fetch(url);
            const messages = await resp.json();
            
            const list = document.getElementById('messageList');
            list.innerHTML = '';
            messages.forEach(m => this.appendMessage(m));
            this.scrollToBottom();

            await this.connection.invoke("JoinRoom", roomId);
            
            // Update URL without reload
            const newUrl = new URL(window.location);
            newUrl.searchParams.set('roomId', roomId);
            window.history.pushState({}, '', newUrl);
        },

        appendMessage: function(msg) {
            const list = document.getElementById('messageList');
            const div = document.createElement('div');
            const isMe = msg.senderId === this.currentUserId;
            
            div.className = `nc-message ${isMe ? 'sent' : 'received'}`;
            const time = new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            div.innerHTML = `
                <div class="nc-message-sender">${isMe ? 'You' : (msg.senderName || 'Staff')}</div>
                <div class="nc-message-bubble">
                    ${msg.content}
                    <div class="nc-message-time">${time}</div>
                </div>
            `;
            list.appendChild(div);
        },

        sendMessage: async function() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            if (!content || !this.currentRoomId) return;

            input.value = '';
            this.sendTypingStatus(false);
            try {
                await this.connection.invoke("SendMessage", this.currentRoomId, content);
            } catch (err) {
                console.error("Send Error:", err);
            }
        },

        sendTypingStatus: function(isTyping) {
            if (this.currentRoomId) {
                this.connection.invoke("SendTypingStatus", this.currentRoomId, isTyping);
            }
        },

        updateInboxPreview: function(msg, showUnread = false) {
            const roomEl = document.getElementById(`room-${msg.roomId}`);
            const list = document.getElementById('inboxList');
            if (roomEl) {
                roomEl.querySelector('.nc-inbox-preview').innerText = msg.content;
                if (showUnread && msg.senderId !== this.currentUserId) {
                    roomEl.classList.add('unread');
                    if (!roomEl.querySelector('.nc-unread-indicator')) {
                        const ind = document.createElement('div');
                        ind.className = 'nc-unread-indicator';
                        roomEl.appendChild(ind);
                    }
                }
                list.prepend(roomEl);
            } else {
                this.loadRooms();
            }
        },

        markAsReadApi: function(roomId) {
            const url = this.isAdmin ? `/Support/MarkAsRead?roomId=${roomId}` : `/Chat/MarkAsRead?roomId=${roomId}`;
            fetch(url, { 
                method: 'POST', 
                headers: { 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value,
                    'X-Requested-With': 'XMLHttpRequest'
                } 
            });
        },

        archiveCurrentRoom: async function() {
            if (!this.currentRoomId) return;
            const resp = await fetch(`/Chat/ArchiveRoom?roomId=${this.currentRoomId}`, {
                method: 'POST',
                headers: { 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            if (resp.ok) {
                document.getElementById('chatContent').style.display = 'none';
                this.updateEmptyState();
                await this.loadRooms();
            }
        },

        unarchiveCurrentRoom: async function() {
            if (!this.currentRoomId) return;
            const resp = await fetch(`/Chat/UnarchiveRoom?roomId=${this.currentRoomId}`, {
                method: 'POST',
                headers: { 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            if (resp.ok) {
                document.getElementById('chatContent').style.display = 'none';
                this.updateEmptyState();
                await this.loadRooms();
            }
        },

        deleteCurrentRoom: async function(el) {
            if (!this.currentRoomId) {
                // Draft mode - just clear URL
                window.location.href = this.isAdmin ? '/Support' : '/Chat';
                return;
            }

            if (!confirm('Are you sure you want to delete this conversation?')) return;

            const url = this.isAdmin ? `/Support/DeleteRoom?roomId=${this.currentRoomId}` : `/Chat/DeleteRoom?roomId=${this.currentRoomId}`;
            const resp = await fetch(url, {
                method: 'POST',
                headers: { 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value,
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            if (resp.ok) {
                document.getElementById('chatContent').style.display = 'none';
                this.updateEmptyState();
                await this.loadRooms();
            }
        },

        setupUIListeners: function() {
            document.getElementById('messageInput').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') this.sendMessage();
            });

            document.getElementById('messageInput').addEventListener('input', () => {
                this.sendTypingStatus(true);
                clearTimeout(this.typingTimeout);
                this.typingTimeout = setTimeout(() => this.sendTypingStatus(false), 3000);
            });

            document.getElementById('inboxSearch').addEventListener('input', (e) => {
                this.applySearchFilter(e.target.value);
            });
        },

        applySearchFilter: function(query) {
            const term = query.toLowerCase().trim();
            document.querySelectorAll('.nc-inbox-item').forEach(item => {
                const subjectEl = item.querySelector('.nc-inbox-subject');
                const customerEl = item.querySelector('.nc-inbox-customer');
                const previewEl = item.querySelector('.nc-inbox-preview');
                
                if (item.dataset.originalSubject) subjectEl.textContent = item.dataset.originalSubject;
                if (item.dataset.originalCustomer) customerEl.textContent = item.dataset.originalCustomer;
                if (item.dataset.originalPreview) previewEl.textContent = item.dataset.originalPreview;

                const text = item.innerText.toLowerCase();
                const isMatch = text.includes(term);
                item.style.display = isMatch ? 'flex' : 'none';

                if (term && isMatch) {
                    if (!item.dataset.originalSubject) item.dataset.originalSubject = subjectEl.textContent;
                    if (!item.dataset.originalCustomer) item.dataset.originalCustomer = customerEl.textContent;
                    if (!item.dataset.originalPreview) item.dataset.originalPreview = previewEl.textContent;

                    window.ncHighlightElement(subjectEl, term);
                    window.ncHighlightElement(customerEl, term);
                    window.ncHighlightElement(previewEl, term);
                }
            });
        },

        showNewChatDialog: function(shouldPushState = true) {
            document.getElementById('messenger').classList.add('show-chat');
            document.getElementById('chatEmptyState').style.display = 'none';
            document.getElementById('chatContent').style.display = 'none';
            document.getElementById('newChatDialog').style.display = 'flex';
            document.querySelectorAll('.nc-inbox-item').forEach(el => el.classList.remove('active'));
            this.currentRoomId = null;

            if (shouldPushState) {
                const url = new URL(window.location);
                url.searchParams.set('new', 'true');
                url.searchParams.delete('roomId');
                window.history.pushState({}, '', url);
            }
        },

        hideNewChatDialog: function() {
            document.getElementById('newChatDialog').style.display = 'none';
            document.getElementById('chatEmptyState').style.display = 'flex';
            
            const url = new URL(window.location);
            url.searchParams.delete('new');
            window.history.pushState({}, '', url);
        },

        // Ported logic for creating new chat
        createNewChat: async function(e) {
            e.preventDefault();
            const form = e.target;
            const formData = new FormData(form);

            try {
                const resp = await fetch('/Chat/StartChat', {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const room = await resp.json();
                
                await this.loadRooms();
                await this.loadChat(room.id, room.subject, "Customer Support");
                
                // Reset form
                form.reset();
                const ncSelect = form.querySelector('nc-select');
                if (ncSelect) ncSelect.value = "";
            } catch (err) {
                console.error("Error creating chat:", err);
            }
        },

        scrollToBottom: function() {
            const list = document.getElementById('messageList');
            list.scrollTop = list.scrollHeight;
        },

        toggleMobileSidebar: function() {
            document.getElementById('messenger').classList.toggle('show-chat');
        },

        toggleArchiveView: function() {
            this.viewingArchived = !this.viewingArchived;
            document.getElementById('sidebarTitle').innerText = this.viewingArchived ? 'Archive' : 'Messages';
            document.getElementById('archiveToggleBtn').innerHTML = this.viewingArchived ? '<i class="fa fa-arrow-left"></i>' : '<i class="fa fa-clock-rotate-left"></i>';
            
            // Sync URL
            const url = new URL(window.location);
            if (this.viewingArchived) url.searchParams.set('view', 'archive');
            else url.searchParams.delete('view');
            window.history.pushState({}, '', url);

            document.getElementById('chatContent').style.display = 'none';
            this.updateEmptyState();
            this.loadRooms();
        },

        updateEmptyState: function() {
            const emptyState = document.getElementById('chatEmptyState');
            const title = emptyState.querySelector('h3');
            const text = emptyState.querySelector('p');

            if (this.viewingArchived) {
                title.innerText = "Viewing Archive";
                text.innerHTML = "Select an archived conversation to view its history.";
            } else {
                title.innerText = "Select a conversation";
                text.innerHTML = this.isAdmin 
                    ? "Choose a chat from the inbox to start messaging." 
                    : 'Choose a chat from the inbox to start messaging or <a href="#" onclick="chatSystem.showNewChatDialog()" class="nc-link-primary">start a new message</a>.';
            }
            emptyState.style.display = 'flex';
        }
    };

    chatSystem.init();
</script>
