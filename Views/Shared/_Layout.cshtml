<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NightCord</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcMusic.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <nav class="nc-navbar navbar navbar-expand-lg">
        <div class="container-fluid px-0 mx-auto" 
             style="max-width: 1280px;
                    padding: 0 1.5rem;">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                &#9835; NightCord
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fa fa-home me-1"></i> Home
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Products" asp-action="Index">
                                    <i class="fa fa-layer-group me-1"></i> Manage Products
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <i class="fa fa-user-shield me-1"></i> Manage Admins
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Products" asp-action="UserIndex">
                                    <i class="fa fa-music me-1"></i> Browse
                                </a>
                            </li>
                        }
                    }
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @using MvcMusic.Models
                        @using Microsoft.AspNetCore.Identity
                        @inject UserManager<ApplicationUser> UserManager
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = User.Identity.Name;
                            if (currentUser != null && !string.IsNullOrEmpty(currentUser.FirstName) && !string.IsNullOrEmpty(currentUser.LastName))
                            {
                                displayName = $"{currentUser.FirstName} {currentUser.LastName}";
                            }
                            <li class="nav-item">
                                <span class="nav-link" 
                                      style="color: var(--nc-text-primary);
                                             font-weight: 600;
                                             font-size: 0.85rem;">
                                    <i class="fa fa-circle-user me-1" 
                                       style="color: var(--nc-primary);"></i> @displayName
                                </span>
                            </li>
                        }
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-nc-outline" 
                                        style="font-size: 0.82rem;
                                               padding: 0.35rem 1rem;">
                                    <i class="fa fa-right-to-bracket me-1"></i> Sign Out
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn-nc-outline" asp-area="" asp-controller="Account" asp-action="Login" 
                               style="margin-right: 0.75rem; 
                                      padding: 0.4rem 1.25rem; 
                                      border-radius: var(--nc-radius-sm); 
                                      font-size: 0.85rem;">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn-nc-primary text-white" asp-area="" asp-controller="Account" asp-action="Register" 
                               style="padding: 0.4rem 1.25rem; 
                                      border-radius: var(--nc-radius-sm); 
                                      font-size: 0.85rem;">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="nc-footer">
        <div class="nc-footer-brand">&#9835; NightCord</div>
        <div class="nc-footer-text">&copy; 2026 NightCord. All rights reserved.</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
