    <script>
        window.showToast = function(message, type = 'success') {
            let bgColor = 'var(--nc-primary)';
            let iconHtml = '<i class="fa fa-info-circle me-2" style="font-size: 1.1rem;"></i>';
            
            if (type === 'success') {
                bgColor = 'var(--nc-primary)';
                iconHtml = '<i class="fa fa-check-circle me-2" style="font-size: 1.1rem;"></i>';
            } else if (type === 'error') {
                bgColor = 'var(--nc-error)';
                iconHtml = '<i class="fa fa-exclamation-circle me-2" style="font-size: 1.1rem;"></i>';
            } else if (type === 'info') {
                bgColor = '#1a1f2c';
            }

            Toastify({
                text: `<div style="display: flex; align-items: center;">${iconHtml}<span>${message}</span></div>`,
                duration: 4000,
                close: true,
                gravity: "top", 
                position: "right",
                escapeMarkup: false,
                style: {
                    background: bgColor,
                    borderRadius: "12px",
                    boxShadow: "0 8px 16px rgba(0,0,0,0.2)",
                    padding: "12px 20px",
                    color: "white",
                    fontFamily: "var(--nc-font-family)",
                    fontSize: "0.9rem",
                    fontWeight: "500",
                    border: "1px solid rgba(255,255,255,0.1)"
                }
            }).showToast();
        };

        // Handle TempData notifications
        $(document).ready(function() {
            const success = '@TempData["Success"]';
            const error = '@TempData["Error"]';
            if (success) window.showToast(success, 'success');
            if (error) window.showToast(error, 'error');
        });
    </script>
    <script src="~/js/state-preservation.js" asp-append-version="true"></script>
    <script src="~/js/components/NcFloatingInput.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
