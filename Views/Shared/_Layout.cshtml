<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NightCord</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcMusic.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <nav class="nc-navbar navbar navbar-expand-lg">
        <div class="container-fluid px-4 mx-auto">
            <a class="navbar-brand" asp-controller="Landing" asp-action="Index">
                &#9835; NightCord
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fa fa-home me-1"></i> Home
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">
                                    <i class="fa fa-chart-line me-1"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Products" asp-action="AdminProducts">
                                    <i class="fa fa-box me-1"></i> Products
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customers" asp-action="CustomerList">
                                    <i class="fa fa-users me-1"></i> Customers
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminDashboard" asp-action="Index">
                                    <i class="fa fa-chart-line me-1"></i> Dashboard
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employee" asp-action="EmployeeList">
                                    <i class="fa fa-user-shield me-1"></i> Employees
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employee" asp-action="ActivityLogs">
                                    <i class="fa fa-list-alt me-1"></i> Logs
                                </a>
                            </li>
                        }

                    }
                </ul>
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-2 align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @using MvcMusic.Models
                        @using Microsoft.AspNetCore.Identity
                        @inject UserManager<ApplicationUser> UserManager
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = User.Identity.Name;
                            if (currentUser != null && !string.IsNullOrEmpty(currentUser.FirstName) && !string.IsNullOrEmpty(currentUser.LastName))
                            {
                                displayName = $"{currentUser.FirstName} {currentUser.LastName}";
                            }
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   style="color: var(--nc-text-primary); font-weight: 600; font-size: 0.85rem; padding: 0.5rem 0.8rem !important; border-radius:100px; background: rgba(255,255,255,0.03); border: 1px solid var(--nc-border);">
                                    @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                                    {
                                        <img src="@currentUser.ProfilePicture" alt="Profile" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:8px; border: 1.5px solid var(--nc-primary);" />
                                    }
                                    else
                                    {
                                        <i class="fa fa-circle-user me-2" style="color: var(--nc-primary); font-size: 1.2rem;"></i>
                                    }
                                    @displayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="profileDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Profile" asp-action="Index">
                                            <i class="fa fa-user-circle me-2"></i> View Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center w-100 border-0 background-none">
                                                <i class="fa fa-right-from-bracket me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>

                            </li>
                        }

                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn-nc-outline" asp-area="" asp-controller="Account" asp-action="Login" 
                               style="margin-right: 0.75rem; 
                                      padding: 0.4rem 1.25rem; 
                                      border-radius: var(--nc-radius-sm); 
                                      font-size: 0.85rem;">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn-nc-primary text-white" asp-area="" asp-controller="Account" asp-action="Register" 
                               style="padding: 0.4rem 1.25rem; 
                                      border-radius: var(--nc-radius-sm); 
                                      font-size: 0.85rem;">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="nc-footer">
        <div class="nc-footer-brand">&#9835; NightCord</div>
        <div class="nc-footer-text">&copy; 2026 NightCord. All rights reserved.</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
