@{
    var rawPath = Context.Request.Path.ToString().ToLower();
    var isHomeHeroRoute = rawPath == "/" || rawPath.StartsWith("/home") || rawPath.StartsWith("/landing/hero");
    var returnUrl = isHomeHeroRoute ? null : Context.Request.Path + Context.Request.QueryString;

    // Centralized Role Checks to avoid CS0136 scoping errors
    var isAdmin = User.IsInRole("Admin");
    var isSuper = User.IsInRole("SuperAdmin");
    var isStaff = User.IsInRole("Staff") || User.IsInRole("StockStaff") || User.IsInRole("ProductStaff") || User.IsInRole("SalesStaff") || User.IsInRole("CustomerStaff");
    var isEmployee = isAdmin || isSuper || isStaff;
    var isAdminOrSuper = isAdmin || isSuper;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NightCord</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MvcMusic.styles.css" asp-append-version="true" />
