@using MvcMusic.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Messages";
    Layout = "_Layout";
}

<div class="nc-chat-page">
    <div class="nc-messenger-full">
        <!-- Sidebar -->
        <div class="nc-messenger-sidebar">
            <div class="nc-messenger-sidebar-header">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0 fw-bold nc-text-primary">Messages</h5>
                </div>
                <div class="nc-search-wrapper mb-2">
                    <i class="fa fa-search nc-search-icon"></i>
                    <input type="text" class="form-control nc-input-dark ps-5" placeholder="Search conversations...">
                </div>
            </div>
            <div id="roomList" class="nc-messenger-rooms">
                <!-- Rooms will be loaded here -->
                <div class="p-4 text-center text-muted">
                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                    <p class="small mb-0">Loading conversations...</p>
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="nc-messenger-main">
            <!-- Empty State -->
            <div id="chatEmptyState" class="nc-messenger-empty">
                <div class="text-center">
                    <div class="nc-empty-icon-wrapper mb-4">
                        <i class="fa fa-comments"></i>
                    </div>
                    <h3 class="fw-bold mb-2">Your Inbox</h3>
                    <p class="text-muted mb-4">Select a conversation or start a new one to begin chatting.</p>
                    <div class="nc-topic-selector mx-auto" style="max-width: 400px;">
                        <label class="form-label small text-muted text-uppercase fw-bold mb-3">Choose a context to start</label>
                        <select id="chatTopicDropdown" class="form-select nc-input-dark mb-4 p-3 text-center">
                            <option value="" selected disabled>Select an inquiry topic...</option>
                            <option value="General Inquiry">General Inquiry</option>
                            <option value="Technical Support">Technical Support</option>
                            <option value="Order Tracking">Order Tracking</option>
                            <option value="Billing & Payments">Billing & Payments</option>
                            <option value="Returns & Refunds">Returns & Refunds</option>
                            <option value="Account Issues">Account Issues</option>
                        </select>
                        <div class="d-grid">
                            <button id="startChatBtn" class="btn-nc-primary p-3" onclick="startNewChat()">
                                Start Support Chat
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Chat -->
            <div id="chatContent" class="nc-messenger-content" style="display: none;">
                <div class="nc-messenger-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="nc-avatar-sm">
                            <i class="fa fa-headset"></i>
                        </div>
                        <div>
                            <h6 id="chatRoomTitle" class="m-0 fw-bold">Support Session</h6>
                            <span class="nc-status-indicator online"></span>
                            <small class="text-muted ms-1">Customer Support</small>
                        </div>
                    </div>
                </div>

                <div id="messageList" class="nc-messenger-messages">
                    <!-- Messages will be loaded here -->
                </div>

                <div id="typingIndicator" class="nc-typing-indicator" style="display: none;">
                    <span id="typingName">Customer Support</span> is typing
                    <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>
                </div>

                <div class="nc-messenger-footer">
                    <div class="nc-input-group">
                        <input type="text" id="messageInput" class="form-control nc-input-dark" placeholder="Write a message..." autocomplete="off">
                        <button id="sendButton" class="btn-nc-primary">
                            <i class="fa fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .nc-page {
            padding-top: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .chat-layout {
            display: flex;
            flex: 1;
            height: calc(100vh - var(--nc-nav-height));
            overflow: hidden;
            margin-top: var(--nc-nav-height);
        }

        .chat-sidebar {
            width: 350px;
            background: var(--nc-bg-card);
            border-right: 1px solid var(--nc-border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .chat-sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid var(--nc-border);
        }

        .nc-search-wrapper {
            position: relative;
        }

        .nc-search-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--nc-text-muted);
        }

        .nc-messenger-rooms {
            flex: 1;
            overflow-y: auto;
            padding: 1rem;
        }

        .nc-room-item {
            padding: 1rem;
            border-radius: var(--nc-radius-sm);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 1rem;
            transition: var(--transition);
            border: 1px solid transparent;
            margin-bottom: 0.5rem;
        }

        .nc-room-item:hover {
            background: rgba(123, 171, 221, 0.05);
            border-color: rgba(123, 171, 221, 0.1);
        }

        .nc-room-item.active {
            background: rgba(123, 171, 221, 0.1);
            border-color: rgba(123, 171, 221, 0.2);
        }

        .nc-room-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: rgba(123, 171, 221, 0.15);
            color: var(--nc-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .nc-room-details {
            flex: 1;
            min-width: 0;
        }

        .nc-room-subject {
            font-weight: 700;
            color: #fff;
            margin-bottom: 0.25rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 0.95rem;
        }

        .nc-room-last-msg {
            color: var(--nc-text-muted);
            font-size: 0.85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .nc-messenger-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--nc-bg-primary);
            position: relative;
        }

        .nc-messenger-empty {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nc-empty-icon-wrapper {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(123, 171, 221, 0.1);
            color: var(--nc-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto;
        }

        .nc-messenger-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .nc-messenger-header {
            padding: 1.25rem 2rem;
            border-bottom: 1px solid var(--nc-border);
            background: var(--nc-bg-card);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nc-avatar-sm {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--nc-primary);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .nc-status-indicator {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .nc-status-indicator.online {
            background: var(--nc-success);
            box-shadow: 0 0 8px var(--nc-success);
        }

        .nc-messenger-messages {
            flex: 1;
            overflow-y: auto;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .nc-message {
            display: flex;
            flex-direction: column;
            max-width: 70%;
        }

        .nc-message.sent {
            align-self: flex-end;
            align-items: flex-end;
        }

        .nc-message.received {
            align-self: flex-start;
            align-items: flex-start;
        }

        .nc-message-bubble {
            padding: 1rem 1.25rem;
            border-radius: 1.25rem;
            font-size: 0.95rem;
            line-height: 1.5;
            position: relative;
        }

        .nc-message.sent .nc-message-bubble {
            background: linear-gradient(135deg, var(--nc-primary), #5b71a8);
            color: #fff;
            border-bottom-right-radius: 4px;
            box-shadow: 0 4px 15px rgba(123, 171, 221, 0.2);
        }

        .nc-message.received .nc-message-bubble {
            background: var(--nc-bg-card);
            color: var(--nc-text-primary);
            border: 1px solid var(--nc-border);
            border-bottom-left-radius: 4px;
        }

        .nc-message-info {
            font-size: 0.75rem;
            color: var(--nc-text-muted);
            margin-top: 0.5rem;
            display: flex;
            gap: 0.5rem;
        }

        .nc-messenger-footer {
            padding: 1.5rem 2rem;
            background: var(--nc-bg-card);
            border-top: 1px solid var(--nc-border);
        }

        .nc-input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }

        .nc-input-group .form-control {
            border-radius: 1.5rem;
            padding: 1rem 1.5rem;
            background: rgba(0, 0, 0, 0.2);
            resize: none;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .nc-input-group .form-control:focus {
            background: rgba(0, 0, 0, 0.4);
            border-color: var(--nc-primary);
        }

        .nc-input-group .btn-nc-primary {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .nc-typing-indicator {
            padding: 0.5rem 2rem;
            color: var(--nc-text-muted);
            font-size: 0.85rem;
            font-style: italic;
            background: var(--nc-bg-primary);
            border-top: 1px solid rgba(255, 255, 255, 0.02);
        }

        .dot {
            animation: blink 1.4s infinite both;
        }

        .dot:nth-child(1) {
            animation-delay: 0.2s;
        }

        .dot:nth-child(2) {
            animation-delay: 0.4s;
        }

        .dot:nth-child(3) {
            animation-delay: 0.6s;
        }

        @@keyframes blink {
            0% {
                opacity: 0.2;
            }
            20% {
                opacity: 1;
            }
            100% {
                opacity: 0.2;
            }
        }

        .nc-topic-selector .form-select {
            border-radius: 1rem;
            font-weight: 600;
            cursor: pointer;
        }

        .nc-topic-selector .btn-nc-primary {
            border-radius: 1rem;
            font-size: 1.1rem;
        }

        @@media (max-width: 992px) {
            .chat-sidebar {
                width: 300px;
            }
        }

        @@media (max-width: 768px) {
            .chat-layout {
                flex-direction: column;
            }
            .chat-sidebar {
                width: 100%;
                height: 40vh;
                border-right: none;
                border-bottom: 1px solid var(--nc-border);
                flex: none;
            }
            .nc-messenger-main {
                height: 60vh;
                flex: none;
            }
        }
    </style>
}

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        let connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        let currentRoomId = null;
        const currentUserId = '@UserManager.GetUserId(User)';

        async function startConnection() {
            try {
                await connection.start();
                console.log("SignalR Connected.");
                await loadRooms();
            } catch (err) {
                console.log(err);
                setTimeout(startConnection, 5000);
            }
        }

        connection.on("ReceiveMessage", function (msg) {
            if (msg.roomId === currentRoomId) {
                appendMessage(msg);
                scrollToBottom();
            }
            updateRoomListPreview(msg);
        });

        connection.on("ReceiveTypingStatus", function (data) {
            if (data.roomId === currentRoomId && data.senderId !== currentUserId) {
                const indicator = document.getElementById('typingIndicator');
                const nameSpan = document.getElementById('typingName');
                
                if (data.isTyping && data.senderName === 'Customer Support') {
                    nameSpan.innerText = data.senderName;
                    indicator.style.display = 'block';
                    scrollToBottom();
                } else if (!data.isTyping) {
                    indicator.style.display = 'none';
                }
            }
        });

        async function loadRooms(selectFirst = true) {
            const resp = await fetch('/Chat/GetMyRooms');
            const rooms = await resp.json();
            const list = document.getElementById('roomList');
            
            if (rooms.length === 0) {
                list.innerHTML = '<div class="p-4 text-center text-muted small">No conversations yet</div>';
                return;
            }

            list.innerHTML = rooms.map(r => `
                <div class="nc-room-item ${currentRoomId === r.id ? 'active' : ''}" onclick="loadChat(${r.id}, '${r.subject}')" id="room-${r.id}">
                    <div class="nc-room-icon">
                        <i class="fa fa-envelope"></i>
                    </div>
                    <div class="nc-room-details">
                        <div class="nc-room-subject">${r.subject}</div>
                        <div class="nc-room-last-msg" id="last-msg-${r.id}">${r.messages?.[0]?.content || 'No messages yet'}</div>
                    </div>
                </div>
            `).join('');

            if (selectFirst && rooms.length > 0 && !currentRoomId) {
                const first = rooms[0];
                loadChat(first.id, first.subject);
            }
        }

        async function loadChat(roomId, subject) {
            currentRoomId = roomId;
            document.getElementById('chatEmptyState').style.display = 'none';
            document.getElementById('chatContent').style.display = 'flex';
            document.getElementById('chatRoomTitle').innerText = subject;
            
            // UI Update
            document.querySelectorAll('.nc-room-item').forEach(el => el.classList.remove('active'));
            const activeRoom = document.getElementById(`room-${roomId}`);
            if (activeRoom) activeRoom.classList.add('active');

            const resp = await fetch(`/Chat/GetMessages?roomId=${roomId}`);
            const messages = await resp.json();
            
            const list = document.getElementById('messageList');
            list.innerHTML = '';
            messages.forEach(appendMessage);
            scrollToBottom();

            await connection.invoke("JoinRoom", roomId);
        }

        function appendMessage(msg) {
            const list = document.getElementById('messageList');
            const div = document.createElement('div');
            const isMe = msg.senderId === currentUserId;
            
            div.className = `nc-message ${isMe ? 'sent' : 'received'}`;
            div.innerHTML = `
                <div class="nc-message-bubble">${msg.content}</div>
                <div class="nc-message-info">
                    <span>${new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                    <span>•</span>
                    <span>${isMe ? 'You' : (msg.senderName || 'Support')}</span>
                </div>
            `;
            list.appendChild(div);
        }

        function updateRoomListPreview(msg) {
            const lastMsgEl = document.getElementById(`last-msg-${msg.roomId}`);
            if (lastMsgEl) {
                lastMsgEl.innerText = msg.content;
                // Move room to top
                const roomEl = document.getElementById(`room-${msg.roomId}`);
                const list = document.getElementById('roomList');
                if (roomEl && list.firstChild !== roomEl) {
                    list.prepend(roomEl);
                }
            } else {
                // New room might have been created
                loadRooms(false);
            }
        }

        async function startNewChat() {
            const subject = document.getElementById('chatTopicDropdown').value;
            if (!subject) return;

            const btn = document.getElementById('startChatBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Starting...';

            const formData = new FormData();
            formData.append('subject', subject);
            formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

            const response = await fetch('/Chat/StartChat', {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            });

            if (response.ok) {
                const room = await response.json();
                currentRoomId = room.id;
                await loadRooms();
                await loadChat(room.id, room.subject);
                document.getElementById('messageInput').focus();
            }
            btn.disabled = false;
            btn.innerText = 'Start Support Chat';
        }

        function scrollToBottom() {
            const list = document.getElementById('messageList');
            list.scrollTop = list.scrollHeight;
        }

        // Enter to Send
        document.getElementById('messageInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        document.getElementById('sendButton').addEventListener('click', sendMessage);

        async function sendMessage() {
            const input = document.getElementById('messageInput');
            const content = input.value.trim();
            if (content && currentRoomId) {
                input.value = '';
                await connection.invoke("SendMessage", currentRoomId, content);
                sendTypingStatus(false);
            }
        }

        let typingTimeout;
        document.getElementById('messageInput').addEventListener('input', () => {
            if (currentRoomId) {
                sendTypingStatus(true);
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(() => sendTypingStatus(false), 3000);
            }
        });

        function sendTypingStatus(isTyping) {
            if (currentRoomId) {
                connection.invoke("SendTypingStatus", currentRoomId, isTyping);
            }
        }

        startConnection();
    </script>
}
