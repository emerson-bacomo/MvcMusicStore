@model MvcMusic.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-file-invoice me-1"></i> Order Details</div>
                <h1 class="nc-page-title">Order #@Model.Id</h1>
                <p class="nc-text-muted mt-1" style="font-size:0.88rem;">Placed on @Model.OrderDate.ToString("MMMM d, yyyy h:mm tt")</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="nc-card mb-4">
                    <div class="nc-card-body">
                        <h3 class="nc-form-section-title">Order Items</h3>
                        <div class="nc-table-responsive">
                            <table class="nc-table">
                                <thead>
                                    <tr>
                                        <th><i class="fa fa-box me-1"></i> Product</th>
                                        <th class="text-center" style="width:1%;white-space:nowrap">Quantity</th>
                                        <th class="text-end" style="width:1%;white-space:nowrap">Unit Price</th>
                                        <th class="text-end" style="width:1%;white-space:nowrap">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.OrderItems)
                                    {
                                        var primaryImage = item.Product?.ProductImages?.FirstOrDefault(img => img.IsPrimary)?.Url 
                                                         ?? item.Product?.ProductImages?.FirstOrDefault()?.Url;
                                        
                                        // Use snapshots if available, fallback to current product info
                                        var displayName = item.ProductName ?? item.Product?.Name ?? "Deleted Product";
                                        var displayPrice = item.Price > 0 ? item.Price : (decimal)(item.Product?.Price ?? 0);
                                        
                                        <tr class="order-item-row" onclick="location.href='@Url.Action("Details", "Products", new { id = item.ProductId })'" style="cursor:pointer;">
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="product-icon-box">
                                                        @if (!string.IsNullOrEmpty(primaryImage))
                                                        {
                                                            <img src="@primaryImage" alt="@displayName" class="w-100 h-100 rounded" style="object-fit:cover;">
                                                        }
                                                        else
                                                        {
                                                            <i class="fa fa-box"></i>
                                                        }
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">@displayName</div>
                                                        <div class="nc-text-muted" style="font-size:0.75rem;">
                                                            @if (item.Product != null) { <span>@item.Product.Brand | @item.Product.Category</span> }
                                                            else { <span class="text-danger">Product data no longer available</span> }
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold" style="width:1%;white-space:nowrap">@item.Quantity</td>
                                            <td class="text-end" style="width:1%;white-space:nowrap">₱@displayPrice.ToString("N2")</td>
                                            <td class="text-end fw-bold" style="width:1%;white-space:nowrap;color:var(--nc-primary);">₱@((displayPrice * item.Quantity).ToString("N2"))</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" class="text-end fw-semibold pt-4">Grand Total:</td>
                                        <td class="text-end fw-bolder pt-4" style="font-size:1.25rem; color:var(--nc-primary);">₱@Model.TotalAmount.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="nc-card mb-4">
                    <div class="nc-card-body">
                        <h3 class="nc-form-section-title">Customer Details</h3>
                        @if (!string.IsNullOrEmpty(Model.Username))
                        {
                            <div class="info-group mb-3">
                                <label class="nc-label">Username (Snapshot)</label>
                                <div class="fw-semibold">@Model.Username</div>
                            </div>
                            <div class="info-group mb-3">
                                <label class="nc-label">Full Name (Snapshot)</label>
                                <div class="nc-text-secondary">@Model.UserFullName</div>
                            </div>
                        }
                        else
                        {
                            <div class="info-group mb-3">
                                <label class="nc-label">Name</label>
                                <div class="fw-semibold">@ViewBag.CustomerName</div>
                            </div>
                        }
                        <div class="info-group mb-3">
                            <label class="nc-label">Email</label>
                            <div class="nc-text-secondary">@ViewBag.CustomerEmail</div>
                        </div>

                        <h3 class="nc-form-section-title mt-4">Shipping Info</h3>
                        <div class="info-group mb-3">
                            <label class="nc-label">Receiver Name</label>
                            <div class="fw-semibold">@(Model.ReceiverName ?? ViewBag.CustomerName)</div>
                        </div>
                        <div class="info-group mb-3">
                            <label class="nc-label">Delivery Address</label>
                            <div class="nc-text-secondary" style="font-size: 0.85rem;">@(Model.Address ?? "No address provided")</div>
                        </div>
                        <div class="info-group">
                            <label class="nc-label">Status</label>
                            <span class="cust-badge @(Model.Status switch { "Delivered" => "active", "OnDelivery" => "delivery", "Pending" => "pending", "Cancelled" => "cancelled", _ => "" })">
                                @(Model.Status == "OnDelivery" ? "On Delivery" : Model.Status)
                            </span>
                        </div>
                    </div>
                </div>

                @if ((User.IsInRole("Admin") || User.IsInRole("SuperAdmin") || User.IsInRole("SalesStaff")) && Model.Status != "Delivered" && Model.Status != "Cancelled")
                {
                    <div class="nc-card">
                        <div class="nc-card-body">
                            <h3 class="nc-form-section-title">Actions</h3>
                            <div class="d-flex flex-column gap-2">
                                <form asp-action="MarkDelivered" asp-route-id="@Model.Id" method="post" class="w-100">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-nc-primary w-100">
                                        <i class="fa fa-check-circle me-1"></i> Mark as Delivered
                                    </button>
                                </form>
                                <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" class="w-100" onsubmit="return confirm('Are you sure you want to cancel this order?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-nc-outline w-100" style="color:var(--nc-error); border-color:var(--nc-error); padding: 0.85rem;">
                                        <i class="fa fa-times-circle me-1"></i> Cancel Order
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .order-item-row:hover {
            background: rgba(123, 171, 221, 0.08) !important;
        }

        .product-icon-box {
            width: 44px;
            height: 44px;
            background: rgba(123, 171, 221, 0.1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--nc-primary);
            border: 1px solid var(--nc-border);
            overflow: hidden;
        }

        .cust-badge {
            font-size: 0.73rem;
            padding: 0.2rem 0.7rem;
            border-radius: 100px;
            font-weight: 700;
            display: inline-block;
            text-transform: uppercase;
        }

        .cust-badge.active {
            background: rgba(129, 199, 132, 0.1);
            color: #81c784;
            border: 1px solid rgba(129, 199, 132, 0.2);
        }

        .cust-badge.delivery {
            background: rgba(123, 171, 221, 0.1);
            color: #7babdd;
            border: 1px solid rgba(123, 171, 221, 0.2);
        }

        .cust-badge.pending {
            background: rgba(255, 183, 77, 0.1);
            color: #ffb74d;
            border: 1px solid rgba(255, 183, 77, 0.2);
        }

        .cust-badge.cancelled {
            background: rgba(244, 67, 54, 0.1);
            color: #f44336;
            border: 1px solid rgba(244, 67, 54, 0.2);
        }

        .nc-form-section-title {
            font-size: 0.8rem;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--nc-border);
            padding-bottom: 0.5rem;
            margin-bottom: 1.25rem;
            color: var(--nc-primary);
            text-transform: uppercase;
        }
    </style>
}
