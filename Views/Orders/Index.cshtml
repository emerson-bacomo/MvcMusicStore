@model List<MvcMusic.ViewModels.RecentOrderItem>

@{
    ViewData["Title"] = "Order Management";
}

<div class="nc-page">
    <div class="container-fluid px-4">
        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">Order Management</h1>
                <p class="nc-page-subtitle">Track and process customer orders.</p>
            </div>
            <div class="nc-page-actions">
            </div>
        </div>

        <div id="orders-table-root"></div>
    </div>
</div>

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';
        
        document.addEventListener('DOMContentLoaded', () => {
            new UpdatableTable('#orders-table-root', {
                storagePrefix: 'orders',
                request: {
                    url: '@Url.Action("GetTableData")',
                    type: 'GET'
                },
                fieldDefinitions: {
                    id: { label: '#', widthPercentage: '1%', spanStyle: 'font-weight: 700; color: var(--nc-primary);' },
                    customer: { label: 'Customer', widthPercentage: '1%', spanStyle: 'font-weight: 600;' },
                    products: { label: 'Products', widthPercentage: '100%', widthMaximum: '0', spanStyle: 'font-size: 0.85rem; color: var(--nc-text-muted); overflow: hidden; text-overflow: ellipsis;' },
                    amount: { 
                        label: 'Amount', 
                        widthPercentage: '1%', 
                        spanStyle: 'font-weight: 700;',
                        renderContent: (val) => `${(window.ncConfig?.currency)}${parseFloat(val).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`
                    },
                    status: { 
                        label: 'Status', 
                        widthMinimum: '150px',
                        renderContent: (val) => {
                            const badgeClass = val === 'Delivered' ? 'active' : (val === 'OnDelivery' ? 'delivery' : (val === 'Pending' ? 'pending' : 'cancelled'));
                            const iconClass = val === 'Delivered' ? 'fa-check-circle' : (val === 'OnDelivery' ? 'fa-truck' : (val === 'Pending' ? 'fa-clock' : 'fa-times-circle'));
                            const label = val === 'OnDelivery' ? 'On Delivery' : val;
                            return `<span class="cust-badge ${badgeClass}"><i class="fa ${iconClass} me-1"></i> ${label}</span>`;
                        }
                    },
                    date: { 
                        label: 'Date', 
                        widthPercentage: '1%', 
                        spanStyle: 'font-size: 0.8rem; color: var(--nc-text-muted);',
                        renderContent: (val) => {
                            const d = new Date(val);
                            return d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                        }
                    },
                    actions: {
                        label: 'Actions',
                        widthPercentage: '1%',
                        spanStyle: 'padding: 0; display: flex; justify-content: flex-start;',
                        renderContent: (val, col, row) => `
                            <a href="/Orders/Detail/${row.id}" class="nc-action-link" title="View Details">
                                <i class="fa fa-eye"></i>
                            </a>`
                    }
                }
            });
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
    <style>
        .cust-badge {
            font-size: 0.73rem;
            padding: 0.2rem 0.7rem;
            border-radius: 100px;
            font-weight: 700;
            display: inline-block;
        }
        .cust-badge.active { background: rgba(129, 199, 132, 0.1); color: #81c784; border: 1px solid rgba(129, 199, 132, 0.2); }
        .cust-badge.delivery { background: rgba(123, 171, 221, 0.1); color: #7babdd; border: 1px solid rgba(123, 171, 221, 0.2); }
        .cust-badge.pending { background: rgba(255, 183, 77, 0.1); color: #ffb74d; border: 1px solid rgba(255, 183, 77, 0.2); }
        .cust-badge.cancelled { background: rgba(244, 67, 54, 0.1); color: #f44336; border: 1px solid rgba(244, 67, 54, 0.2); }

        .nc-action-link {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: var(--nc-bg-secondary);
            color: var(--nc-text-secondary);
            transition: all 0.25s;
            border: 1px solid var(--nc-border);
            cursor: pointer;
            font-size: 0.85rem;
        }
        .nc-action-link:hover {
            background: var(--nc-primary);
            color: #fff;
            transform: translateY(-2px);
            border-color: var(--nc-primary);
        }
    </style>
}
