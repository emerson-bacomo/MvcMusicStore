@model IEnumerable<MvcMusic.Models.Product>

@{
    ViewData["Title"] = "Browse Instruments";
    var categories = ViewData["Categories"] as List<string> ?? new List<string>();
    var currentCategory = ViewData["CurrentCategory"]?.ToString();
    var currentSearch = ViewData["CurrentSearch"]?.ToString();
}

<style>
    /* ── Filter Bar Scoped Styles ─────────────────────────────────── */
    .nc-filter-bar {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }
    .nc-search-wrap {
        position: relative;
        flex: 1;
        min-width: 200px;
    }
    .nc-search-wrap .nc-input { padding-left: 2.5rem; }
    .nc-search-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--nc-text-muted);
        font-size: 0.9rem;
    }
    .nc-select {
        background: rgba(255, 255, 255, 0.05);
        border: 1.5px solid var(--nc-border);
        border-radius: var(--nc-radius-sm);
        color: var(--nc-text-primary);
        padding: 0.7rem 1rem;
        font-family: inherit;
        font-size: 0.9rem;
        outline: none;
        cursor: pointer;
        transition: var(--transition);
    }
    .nc-select:focus { border-color: var(--nc-primary); }
    .nc-select option { background: var(--nc-bg-card); }

    .nc-products-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 1.5rem;
    }
</style>

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <div style="color:var(--nc-text-muted);font-size:0.8rem;margin-bottom:0.25rem;">
                    <i class="fa fa-music me-1"></i> Welcome, @User.Identity?.Name
                </div>
                <h1 class="nc-page-title">Browse Instruments</h1>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" asp-action="UserIndex">
            <div class="nc-filter-bar">
                <div class="nc-search-wrap">
                    <i class="fa fa-search nc-search-icon"></i>
                    <input type="text" name="search" value="@currentSearch" class="nc-input"
                           placeholder="Search by name or brand..." />
                </div>
                <select name="category" class="nc-select" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(cat == currentCategory ? "selected" : null)">@cat</option>
                    }
                </select>
                <button type="submit" class="btn-nc-primary" style="white-space:nowrap; padding: 0.7rem 1.5rem; border-radius: var(--nc-radius-sm);">
                    <i class="fa fa-search me-1"></i> Search
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentCategory))
                {
                    <a asp-action="UserIndex" class="btn-nc-outline" style="white-space:nowrap; padding: 0.7rem 1.2rem; border-radius: var(--nc-radius-sm);">
                        <i class="fa fa-xmark me-1"></i> Clear
                    </a>
                }
            </div>
        </form>

        @if (!Model.Any())
        {
            <div style="text-align:center;padding:4rem 0;color:var(--nc-text-muted);">
                <i class="fa fa-guitar" style="font-size:3rem;margin-bottom:1rem;display:block;"></i>
                <p style="font-size:1rem;">No instruments found matching your criteria.</p>
                <a asp-action="UserIndex" class="btn-nc-outline" style="margin-top:1rem;display:inline-block; padding: 0.6rem 1.2rem; border-radius: var(--nc-radius-sm);">View All</a>
            </div>
        }
        else
        {
            <div class="nc-products-grid">
                @foreach (var product in Model)
                {
                    <partial name="Components/_ProductCard" model="product" />
                }
            </div>
        }
    </div>
</div>

