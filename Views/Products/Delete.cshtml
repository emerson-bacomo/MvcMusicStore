@model MvcMusic.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="nc-page">
    <div class="nc-container" style="max-width:560px;">
        <div class="nc-page-header">
            <h1 class="nc-page-title" style="color:var(--nc-error);">Delete Product</h1>
            <a asp-action="Index" class="btn-nc-outline" style="padding: 0.6rem 1.2rem; border-radius: var(--nc-radius-sm);">
                <i class="fa fa-arrow-left me-1"></i> Back
            </a>
        </div>

        <div class="nc-card">
            <div class="nc-card-body" style="padding:2.5rem;">
                <div style="text-align:center;margin-bottom:2rem;">
                    <div style="font-size:3rem;margin-bottom:1rem;">⚠️</div>
                    <h2 style="font-size:1.3rem;font-weight:800;color:var(--nc-text-primary);margin-bottom:0.5rem;">
                        Remove from Inventory?
                    </h2>
                    <p style="color:var(--nc-text-secondary);font-size:0.9rem;">
                        This action will permanently delete the instrument and its details from the catalog.
                    </p>
                </div>

                <div style="background:rgba(229, 115, 115, 0.05);border:1px solid rgba(229, 115, 115, 0.2);border-radius:var(--nc-radius-sm);padding:1.5rem;margin-bottom:2rem;display:flex;align-items:center;gap:1.5rem;">
                    <img src="@Model.Image" alt="@Model.Name"
                         style="width:90px;height:90px;object-fit:cover;border-radius:var(--nc-radius-sm);border:1px solid var(--nc-border);flex-shrink:0;"
                         onerror="this.src='https://placehold.co/100x100/151a26/7babdd?text=NC'" />
                    <div>
                        <div style="font-weight:800;font-size:1.1rem;margin-bottom:0.25rem;">@Model.Name</div>
                        <span class="badge-nc" style="background: rgba(123, 171, 221, 0.1); border-color: var(--nc-primary); color: var(--nc-primary);">@Model.Category</span>
                        <div style="color:var(--nc-accent);font-weight:800;margin-top:0.4rem; font-size: 1.1rem;">₱ @Model.Price.ToString("N2")</div>
                    </div>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                        <button type="submit" class="btn-nc-danger" style="flex:1;padding:0.85rem; font-weight:700; border-radius: var(--nc-radius-sm);">
                            <i class="fa fa-trash me-1"></i> Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn-nc-outline" style="flex:1;padding:0.85rem;text-align:center; border-radius: var(--nc-radius-sm);">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

