@model MvcMusic.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="nc-page">
    <div class="nc-container">
        <div style="margin-bottom:2rem;">
            @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a asp-action="Index" class="btn-nc-outline" style="padding: 0.6rem 1.2rem; border-radius: var(--nc-radius-sm);">
                    <i class="fa fa-arrow-left me-1"></i> Back to Catalog
                </a>
            }
            else
            {
                <a asp-action="UserIndex" class="btn-nc-outline" style="padding: 0.6rem 1.2rem; border-radius: var(--nc-radius-sm);">
                    <i class="fa fa-arrow-left me-1"></i> Back to Browse
                </a>
            }
        </div>

        <partial name="Components/_ProductDetail" model="Model" />
    </div>
</div>

