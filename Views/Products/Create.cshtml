@model MvcMusic.Models.Product

@{
    ViewData["Title"] = "Add Product";
    ViewData["IsCreate"] = true;
}

<div class="nc-page" style="padding-top: 2rem;">
    <div class="nc-container">
        <partial name="Components/_ProductEditor" model='Model ?? new MvcMusic.Models.Product() { Name = string.Empty }' />
    </div>
</div>

@section Scripts {
    <script src="~/js/ProductEditor.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
