@model IEnumerable<MvcMusic.Models.Product>

@{
    ViewData["Title"] = "Instrument Management";
}

<div class="nc-page">
    <div class="nc-container">
        <div class="nc-page-header">
            <div>
                <h1 class="nc-page-title">Instrument Management</h1>
                <p class="nc-page-subtitle">Manage your inventory, pricing, and showcase highlights.</p>
            </div>
            <div class="nc-page-actions">
                <a asp-action="Create" class="btn-nc-primary nc-btn-featured">
                    <i class="fa fa-plus me-2"></i> Add New Instrument
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="nc-alert nc-alert-success mb-4">
                <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
            </div>
        }

        <div class="nc-card nc-table-card">
            <div class="nc-table-responsive">
                <table class="nc-table">
                    <thead>
                        <tr>
                            <th>Instrument</th>
                            <th>Category</th>
                            <th>Brand</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="nc-table-product">
                                        <img src="@(item.ProductImages?.FirstOrDefault(p => p.IsPrimary)?.Url ?? item.ProductImages?.FirstOrDefault()?.Url)" onerror="this.src='https://placehold.co/50x50/1a1f2c/7babdd?text=?'" />
                                        <div>
                                            <div class="product-name">@item.Name</div>
                                            @if (item.IsBanner)
                                            {
                                                <span class="badge-banner">Banner</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="nc-text-secondary">@item.Category</span></td>
                                <td><span class="nc-text-secondary">@item.Brand</span></td>
                                <td><span class="nc-text-primary fw-bold">₱ @item.Price.ToString("N2")</span></td>
                                <td>
                                    <span class="@(item.Stock <= 0 ? "text-danger" : item.Stock < 10 ? "text-warning" : "nc-text-secondary")">
                                        @item.Stock
                                    </span>
                                </td>
                                <td>
                                    @if (item.Stock > 0)
                                    {
                                        <span class="nc-status-badge status-active">Available</span>
                                    }
                                    else
                                    {
                                        <span class="nc-status-badge status-inactive">Sold Out</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="nc-action-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="nc-action-link" title="View"><i class="fa fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="nc-action-link" title="Edit"><i class="fa fa-pen"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="nc-action-link delete" title="Delete"><i class="fa fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .nc-page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem; }
    
    .nc-btn-featured {
        padding: 0.9rem 2rem;
        font-size: 1rem;
        box-shadow: 0 0 20px rgba(123, 171, 221, 0.2);
    }
    .nc-btn-featured:hover {
        box-shadow: 0 0 30px rgba(123, 171, 221, 0.4);
    }

    .nc-table-product { display: flex; align-items: center; gap: 1rem; }
    .nc-table-product img { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--nc-border); }
    .product-name { font-weight: 700; color: var(--nc-text-primary); font-size: 0.95rem; }
    
    .badge-banner {
        background: rgba(123, 171, 221, 0.1);
        color: var(--nc-primary);
        font-size: 0.6rem;
        padding: 0.1rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
        font-weight: 800;
        border: 1px solid rgba(123, 171, 221, 0.3);
        margin-top: 0.2rem;
        display: inline-block;
    }

    .nc-status-badge {
        font-size: 0.75rem;
        padding: 0.3rem 0.8rem;
        border-radius: 100px;
        font-weight: 700;
        display: inline-block;
    }
    .status-active { background: rgba(129, 199, 132, 0.1); color: #81c784; border: 1px solid rgba(129, 199, 132, 0.2); }
    .status-inactive { background: rgba(229, 115, 115, 0.1); color: #e57373; border: 1px solid rgba(229, 115, 115, 0.2); }

    .nc-action-group { display: flex; gap: 0.6rem; justify-content: flex-end; }
    .nc-action-link {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--nc-bg-secondary);
        color: var(--nc-text-secondary);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid var(--nc-border);
    }
    .nc-action-link:hover { background: var(--nc-primary); color: #fff; transform: translateY(-3px); border-color: var(--nc-primary); box-shadow: 0 4px 12px rgba(123, 171, 221, 0.3); }
    .nc-action-link.delete { color: rgba(250, 146, 144, 1); }
    .nc-action-link.delete:hover { background: rgba(250, 146, 144, 1); border-color: rgba(250, 146, 144, 1); color: #fff !important; }
</style>
