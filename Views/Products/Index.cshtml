@model IEnumerable<MvcMusic.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
}

<div class="nc-page">
    <div class="nc-container">
        @if (TempData["Success"] != null)
        {
            <div class="nc-alert nc-alert-success">
                <i class="fa fa-circle-check"></i> @TempData["Success"]
            </div>
        }

        <div class="nc-page-header">
            <div>
                <div style="color:var(--nc-text-muted);font-size:0.8rem;margin-bottom:0.25rem;">
                    <i class="fa fa-layer-group me-1"></i> Admin Panel
                </div>
                <h1 class="nc-page-title">Product Catalog</h1>
            </div>
            <a asp-action="Create" class="btn-nc-primary" style="padding: 0.6rem 1.2rem; border-radius: var(--nc-radius-sm);">
                <i class="fa fa-plus me-1"></i> Add Product
            </a>
        </div>

        <div class="nc-card">
            <div class="nc-card-body">
                <p style="color:var(--nc-text-secondary);font-size:0.85rem;margin-bottom:1.5rem;">
                    @Model.Count() product(s) in catalog
                </p>

                @if (!Model.Any())
                {
                    <div style="text-align:center;padding:3rem 0;color:var(--nc-text-muted);">
                        <i class="fa fa-box-open" style="font-size:2.5rem;margin-bottom:1rem;display:block;"></i>
                        <p>No products yet.</p>
                        <a asp-action="Create" class="btn-nc-primary" style="margin-top:1rem;display:inline-block; padding: 0.6rem 1.2rem; border-radius: var(--nc-radius-sm);">Add First Product</a>
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="nc-table">
                            <thead>
                                <tr>
                                    <th>Image</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Brand</th>
                                    <th>Price</th>
                                    <th>Stock</th>
                                    <th>Banner</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <img src="@item.Image" alt="@item.Name" class="product-thumb"
                                                 onerror="this.src='https://placehold.co/100x100/151a26/7babdd?text=NC'" />
                                        </td>
                                        <td>
                                            <span style="font-weight:700;color:var(--nc-text-primary);">@item.Name</span>
                                        </td>
                                        <td>
                                            <span class="badge-nc" style="background: rgba(123, 171, 221, 0.1); border-color: var(--nc-primary); color: var(--nc-primary);">@item.Category</span>
                                        </td>
                                        <td style="color:var(--nc-text-secondary); font-size: 0.85rem;">@item.Brand</td>
                                        <td style="color:var(--nc-accent);font-weight:800;">₱@item.Price.ToString("N2")</td>
                                        <td>
                                            <span style="color:@(item.Stock > 10 ? "#81c784" : "#ffb74d"); font-weight: 600;">
                                                @item.Stock
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsBanner)
                                            {
                                                <span style="color:var(--nc-primary);font-size:0.8rem;"><i class="fa fa-star me-1"></i>Yes</span>
                                            }
                                            else
                                            {
                                                <span style="color:var(--nc-text-muted);font-size:0.8rem;">—</span>
                                            }
                                        </td>
                                        <td>
                                            <div style="display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap;">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-nc-outline" style="font-size:0.75rem;padding:0.4rem 0.7rem; border-radius: var(--nc-radius-sm);">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-nc-primary" style="font-size:0.75rem;padding:0.4rem 0.7rem; border-radius: var(--nc-radius-sm);">
                                                    <i class="fa fa-pen"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-nc-danger" style="font-size:0.75rem;padding:0.4rem 0.7rem; border-radius: var(--nc-radius-sm);">
                                                    <i class="fa fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

