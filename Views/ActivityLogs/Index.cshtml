@model List<MvcMusic.Models.ActivityLog>

@{
    var emp = ViewBag.Employee as MvcMusic.Models.ApplicationUser;
    ViewData["Title"] = emp != null ? $"Logs — {emp.UserName}" : "All Activity Logs";
}

<div class="nc-page">
    <div class="container-fluid px-4">
        <div class="nc-page-header">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-clipboard-list me-1"></i> System Audits</div>
                <h1 class="nc-page-title">
                    @if (emp != null)
                    {
                        <span>Activity Logs - <span style="color:var(--nc-primary);font-size:1.4rem;">@emp.UserName</span></span>
                    }
                    else if (ViewBag.Product != null)
                    {
                        <span>Activity Logs - <span style="color:var(--nc-primary);font-size:1.4rem;">@ViewBag.Product.Name</span></span>
                    }
                    else
                    {
                        <span>All Activity Logs</span>
                    }
                </h1>
            </div>
            @if (emp != null)
            {
                <a asp-action="Index" class="btn-nc-outline" style="font-size: 0.8rem; padding: 0.5rem 1rem;">
                    <i class="fa fa-globe me-1"></i> View All Logs
                </a>
            }
        </div>

        <div id="logs-table"></div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
    <style>
        .log-action {
            font-size: 0.75rem;
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.05);
            color: var(--nc-text-secondary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: inline-block;
        }

        .role-badge {
            font-size: 0.70rem;
            padding: 0.15rem 0.5rem;
            border-radius: 100px;
            font-weight: 600;
        }

        .role-admin { background: rgba(229, 115, 115, 0.15); color: #e57373; }
        .role-superadmin { background: rgba(186, 104, 200, 0.15); color: #ba68c8; }
        .role-staff { background: rgba(79, 195, 247, 0.15); color: #4fc3f7; }
        .role-user { background: rgba(129, 199, 132, 0.15); color: #81c784; }

        .btn-close-custom {
            background: transparent;
            border: none;
            color: #fff;
            opacity: 0.5;
            padding: 0.5rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            border-radius: 8px;
        }
        .btn-close-custom:hover {
            opacity: 1;
            background: rgba(255,255,255,0.1);
            transform: scale(1.1);
        }

        /* Log Detail Styles */
        .log-detail-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid var(--nc-border);
            border-radius: 8px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.02);
            font-size: 0.85rem;
        }
        .log-detail-table th {
            padding: 0.75rem 1rem;
            background: rgba(255, 255, 255, 0.05);
            color: var(--nc-text-muted);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--nc-border);
        }
        .log-detail-table td {
            padding: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }
        .log-detail-table tr:last-child td { border-bottom: none; }
        
        .log-old-val { color: #e57373; text-decoration: line-through; opacity: 0.8; }
        .log-new-val { color: #81c784; font-weight: 600; }
        .log-field-name { font-weight: 700; color: #fff; width: 140px; }
        
        .log-image-preview {
            width: 60px;
            height: 60px;
            border-radius: 6px;
            object-fit: cover;
            border: 1px solid var(--nc-border);
            background: #000;
        }

        .nc-nav-tabs {
            border-bottom: 2px solid rgba(123, 171, 221, 0.15);
            gap: 0.5rem;
            display: flex;
        }
        .nc-nav-tabs .nav-link {
            border: 2px solid transparent;
            color: var(--nc-text-muted);
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.7rem 1.5rem;
            border-radius: 8px 8px 0 0;
            transition: all 0.2s;
            position: relative;
            background: transparent;
            margin-bottom: -2px; /* Pull down over border */
        }
        .nc-nav-tabs .nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,0.05);
        }
        .nc-nav-tabs .nav-link.active {
            color: var(--nc-primary);
            background: rgba(123, 171, 221, 0.1);
            border: 2px solid rgba(123, 171, 221, 0.3);
            border-bottom-color: #131822; /* match modal bg */
        }
    </style>
}

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';
        
        document.addEventListener('DOMContentLoaded', function() {
            const actions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Actions));
            const roles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Roles));
            const users = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Users));
            
            const params = new URLSearchParams(window.location.search);

            const table = new UpdatableTable('#logs-table', {
                label: '',
                storagePrefix: 'activityLogsTable',
                request: {
                    url: '@Url.Action("GetTableData", "ActivityLogs")' + window.location.search,
                    type: 'GET'
                },
                fieldDefinitions: {
                    timestamp: { 
                        label: 'Timestamp',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit nc-text-muted text-nowrap',
                        renderContent: (val) => {
                            if (!val) return "—";
                            const d = new Date(val); // Parses ISO UTC accurately
                            return `<span style="font-size:0.85rem;">${d.toLocaleDateString(undefined, { year: '2-digit', month: '2-digit', day: '2-digit' })} ${d.toLocaleTimeString(undefined, { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' })}</span>`;
                        }
                    },
                    username: { 
                        label: 'User',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        renderContent: (val) => `<span class="nc-text-secondary">${val || "—"}</span>`
                    },
                    fullname: { 
                        label: 'Full Name',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        renderContent: (val) => `<span class="nc-text-secondary">${val || "—"}</span>`
                    },
                    role: { 
                        label: 'Role',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        type: 'select',
                        options: roles.map(r => ({value: r, label: r})),
                        renderContent: (val) => {
                            if (!val) return '';
                            const rCode = val.toLowerCase();
                            return `<span class="nc-text-muted" style="font-size:0.8rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">${val}</span>`;
                        }
                    },
                    action: {
                        label: 'Action',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        type: 'select',
                        options: actions.map(a => ({value: a, label: a})),
                        renderContent: (val) => `<span style="font-weight:600; font-size:0.85rem;">${val}</span>`
                    },
                    details: {
                        label: 'Details',
                        widthPercentage: '0%',
                        renderContent: (val) => {
                            if (!val) return '—';
                            // Try to detect if it's JSON
                            if (val.trim().startsWith('{') || val.trim().startsWith('[')) {
                                try {
                                    const obj = JSON.parse(val);
                                    const items = Array.isArray(obj) ? obj : [obj];
                                    const firstSummary = items[0]?.summary || "Data modification detected";
                                    const summary = items.length > 1 ? `${firstSummary} (and ${items.length - 1} more)` : firstSummary;
                                    return `
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="nc-text-muted text-truncate" style="font-size:0.85rem; max-width:400px;" title="${summary}">${summary}</span>
                                            <button class="btn btn-sm btn-nc-outline py-0 px-2 flex-shrink-0" style="font-size:0.7rem; height:22px;" onclick='window.viewLogJson(${JSON.stringify(val)})'>
                                                <i class="fa fa-code me-1"></i> View Data
                                            </button>
                                        </div>
                                    `;
                                } catch (e) { /* Not JSON */ }
                            }
                            return `<span class="nc-text-muted" style="font-size:0.85rem;">${val}</span>`;
                        }
                    }
                },
                canAdd: false,
                canEdit: false,
                canDelete: false,
                itemsPerPage: 20,
                sortConfig: { key: 'timestamp', direction: 'desc' },
                customFilters: [
                    {
                        id: 'userId',
                        label: 'Users',
                        options: (users || []).map(u => ({ value: u.UserId, label: u.UserFullName || u.Username }))
                    }
                ]
            });
        });

        window.viewLogJson = function(jsonStr) {
            try {
                const data = JSON.parse(jsonStr);
                const items = Array.isArray(data) ? data : [data];
                
                // Set Raw JSON
                const pretty = JSON.stringify(data, null, 4);
                document.getElementById('jsonViewerBody').textContent = pretty;
                document.getElementById('jsonViewerBody').setAttribute('data-raw', jsonStr);

                // Build Visual View
                const visualBody = document.getElementById('visualViewerBody');
                visualBody.innerHTML = '';
                
                items.forEach((item, index) => {
                    const section = document.createElement('div');
                    section.className = index > 0 ? 'mt-4' : '';
                    
                    if (item.summary) {
                        section.innerHTML += `<div class="nc-text-muted mb-3" style="font-size:0.9rem; padding: 0.75rem 1rem; background: rgba(255,255,255,0.03); border-radius: 8px; border-left: 3px solid var(--nc-primary);">${item.summary}</div>`;
                    }

                    if (item.previousValues || item.newValues) {
                        const table = document.createElement('table');
                        table.className = 'log-detail-table';
                        table.innerHTML = `
                            <thead>
                                <tr>
                                    <th>Field</th>
                                    <th>Previous Value</th>
                                    <th>New Value</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        `;
                        const tbody = table.querySelector('tbody');
                        
                        const allKeys = new Set([
                            ...Object.keys(item.previousValues || {}),
                            ...Object.keys(item.newValues || {})
                        ]);

                        allKeys.forEach(key => {
                            const oldVal = item.previousValues?.[key];
                            const newVal = item.newValues?.[key];
                            
                            if (oldVal === newVal && oldVal !== undefined) return;

                            const row = document.createElement('tr');
                            
                            if (key === 'Gallery') {
                                let oldArr = [];
                                let newArr = [];
                                try { oldArr = JSON.parse(oldVal || "[]"); } catch (e) {}
                                try { newArr = JSON.parse(newVal || "[]"); } catch (e) {}

                                let oldHtml = '<div class="d-flex flex-wrap gap-2">';
                                if (oldArr.length === 0) oldHtml += '<span class="opacity-50" style="font-size: 0.85rem;">Empty</span>';
                                oldArr.forEach((url, idx) => {
                                    oldHtml += `
                                        <div class="position-relative" style="width: 50px; height: 50px; border-radius: 6px; overflow: hidden; border: 1px solid var(--nc-border);">
                                            <img src="${url}" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://placehold.co/100?text=Error'; this.className+=' opacity-20';" />
                                            <div class="position-absolute top-0 start-0 bg-dark text-white px-1" style="font-size: 0.6rem; border-bottom-right-radius: 4px; opacity: 0.9">${idx + 1}</div>
                                        </div>
                                    `;
                                });
                                oldHtml += '</div>';

                                let newHtml = '<div class="d-flex flex-wrap gap-2">';
                                if (newArr.length === 0 && oldArr.length === 0) newHtml += '<span class="opacity-50" style="font-size: 0.85rem;">Empty</span>';
                                
                                newArr.forEach((url, idx) => {
                                    const isNew = !oldArr.includes(url);
                                    const oldIdx = oldArr.indexOf(url);
                                    const isMoved = !isNew && oldIdx !== idx;
                                    let borderStyle = "1px solid var(--nc-border)";
                                    if (isNew) borderStyle = "2px solid #81c784";
                                    else if (isMoved) borderStyle = "2px solid #ffb74d";

                                    newHtml += `
                                        <div class="position-relative" style="width: 50px; height: 50px; border-radius: 6px; overflow: hidden; border: ${borderStyle};">
                                            <img src="${url}" class="w-100 h-100" style="object-fit: cover;" onerror="this.src='https://placehold.co/100?text=Error'; this.className+=' opacity-20';" />
                                            <div class="position-absolute top-0 start-0 bg-dark text-white px-1" style="font-size: 0.6rem; border-bottom-right-radius: 4px; opacity: 0.9">${idx + 1}</div>
                                        </div>
                                    `;
                                });
                                oldArr.forEach((url) => {
                                    if (!newArr.includes(url)) {
                                        newHtml += `
                                            <div class="position-relative" style="width: 50px; height: 50px; border-radius: 6px; overflow: hidden; border: 2px solid #e57373; opacity: 0.4;">
                                                <img src="${url}" class="w-100 h-100" style="object-fit: cover; filter: grayscale(100%);" onerror="this.src='https://placehold.co/100?text=Error'; this.className+=' opacity-20';" />
                                                <div class="position-absolute top-0 start-0 bg-danger text-white px-1" style="font-size: 0.6rem; border-bottom-right-radius: 4px; opacity: 0.9"><i class="fa fa-times"></i></div>
                                            </div>
                                        `;
                                    }
                                });
                                newHtml += '</div>';

                                row.innerHTML = `
                                    <td class="log-field-name">${formatFieldName(key)}</td>
                                    <td class="log-old-val" style="vertical-align: top;">${oldHtml}</td>
                                    <td class="log-new-val" style="vertical-align: top;">${newHtml}</td>
                                `;
                            } else {
                                row.innerHTML = `
                                    <td class="log-field-name">${formatFieldName(key)}</td>
                                    <td class="log-old-val">${formatValue(key, oldVal)}</td>
                                    <td class="log-new-val">${formatValue(key, newVal)}</td>
                                `;
                            }
                            tbody.appendChild(row);
                        });
                        section.appendChild(table);
                    } else if (typeof item === 'string') {
                        section.innerHTML += `<div class="p-3 rounded" style="background: rgba(0,0,0,0.2); font-size: 0.9rem;">${item}</div>`;
                    } else {
                        // Fallback for simple objects that aren't the standard change pattern
                        const table = document.createElement('table');
                        table.className = 'log-detail-table';
                        const tbody = document.createElement('tbody');
                        Object.entries(item).forEach(([key, val]) => {
                            if (key === 'summary' || key === 'table' || key === 'id' || key === 'type' || key === 'productId') return;
                            const row = document.createElement('tr');
                            row.innerHTML = `<td class="log-field-name">${formatFieldName(key)}</td><td colspan="2">${formatValue(key, val)}</td>`;
                            tbody.appendChild(row);
                        });
                        if (tbody.children.length > 0) {
                            table.appendChild(tbody);
                            section.appendChild(table);
                        }
                    }
                    if (section.innerHTML.trim() !== '') {
                        visualBody.appendChild(section);
                    }
                });

                // Default to Visual tab if it has content, else JSON
                const visualTab = document.getElementById('visual-tab');
                const jsonTab = document.getElementById('json-tab');
                if (visualBody.innerHTML) {
                    bootstrap.Tab.getOrCreateInstance(visualTab).show();
                } else {
                    bootstrap.Tab.getOrCreateInstance(jsonTab).show();
                }

                new bootstrap.Modal(document.getElementById('jsonModal')).show();
            } catch (e) {
                console.error(e);
                alert('Invalid JSON data');
            }
        };

        function formatFieldName(key) {
            // Convert camelCase or PascalCase to "Pascal Case"
            return key.replace(/([A-Z])/g, ' $1').replace(/^./, str => str.toUpperCase()).trim();
        }

        function formatValue(key, val) {
            if (val === null || val === undefined) return '<span class="opacity-50">None</span>';
            if (typeof val === 'boolean') return val ? '<span class="text-success">True</span>' : '<span class="text-danger">False</span>';
            
            const lowerKey = key.toLowerCase();
            
            // Smart Image Detection
            if (lowerKey.includes('image')) {
                return `<img src="${val}" class="log-image-preview" onerror="this.src='https://placehold.co/100?text=Error'; this.className+=' opacity-20';" />`;
            }

            // Smart Price Detection
            if (lowerKey.includes('price') || lowerKey.includes('amount')) {
                const num = parseFloat(val);
                if (!isNaN(num)) {
                    const currency = window.ncConfig?.currency;
                    return `<span class="fw-bold">${currency}${num.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>`;
                }
            }

            return val;
        }

        window.copyLogJson = function() {
            const raw = document.getElementById('jsonViewerBody').getAttribute('data-raw');
            navigator.clipboard.writeText(raw);
            const btn = event.currentTarget;
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="fa fa-check me-1"></i> Copied!';
            setTimeout(() => btn.innerHTML = original, 2000);
        };
    </script>

    <!-- JSON Viewer Modal -->
    <div class="modal fade" id="jsonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content nc-card" style="border:1px solid var(--nc-border); background: #131822 !important; border-radius: 12px; overflow: hidden;">
                <div class="modal-header border-0 pb-0" style="padding: 1.5rem 1.5rem 0 1.5rem;">
                    <h5 class="modal-title nc-page-title fs-5"><i class="fa fa-clipboard-list me-2 text-primary"></i> Data Details</h5>
                    <button type="button" class="ms-auto btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <ul class="nav nc-nav-tabs mb-4" id="logTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="visual-tab" data-bs-toggle="tab" data-bs-target="#visual-view" type="button" role="tab"><i class="fa fa-eye me-2"></i> Visual View</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="json-tab" data-bs-toggle="tab" data-bs-target="#json-view" type="button" role="tab"><i class="fa fa-code me-2"></i> Raw JSON</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="logTabContent">
                        <div class="tab-pane fade show active" id="visual-view" role="tabpanel">
                            <div id="visualViewerBody"></div>
                        </div>
                        <div class="tab-pane fade" id="json-view" role="tabpanel">
                            <pre id="jsonViewerBody" class="p-3 rounded m-0" style="background: rgba(0,0,0,0.5); color: #81c784; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; max-height: 500px; overflow: auto; border: 1px solid var(--nc-border);"></pre>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 p-4">
                    <button type="button" class="btn-nc-outline" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn-nc-primary px-4" onclick="window.copyLogJson()">
                        <i class="fa fa-copy me-1"></i> Copy JSON
                    </button>
                </div>
            </div>
        </div>
    </div>
}
