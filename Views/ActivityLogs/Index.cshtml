@model List<MvcMusic.Models.ActivityLog>

@{
    var emp = ViewBag.Employee as MvcMusic.Models.ApplicationUser;
    ViewData["Title"] = emp != null ? $"Logs — {emp.UserName}" : "All Activity Logs";
}

<div class="nc-page">
    <div class="container-fluid px-4">
        <div class="nc-page-header">
            <div>
                <div class="nc-text-muted mb-1" style="font-size:0.8rem;"><i class="fa fa-clipboard-list me-1"></i> System Audits</div>
                <h1 class="nc-page-title">
                    @if (emp != null)
                    {
                        <span>Activity Logs - <span style="color:var(--nc-primary);font-size:1.4rem;">@emp.UserName</span></span>
                    }
                    else
                    {
                        <span>All Activity Logs</span>
                    }
                </h1>
            </div>
            @if (emp != null)
            {
                <a asp-action="Index" class="btn-nc-outline" style="font-size: 0.8rem; padding: 0.5rem 1rem;">
                    <i class="fa fa-globe me-1"></i> View All Logs
                </a>
            }
        </div>

        <div id="logs-table"></div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/UpdatableTable.css" />
    <style>
        .log-action {
            font-size: 0.75rem;
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.05);
            color: var(--nc-text-secondary);
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: inline-block;
        }

        .role-badge {
            font-size: 0.70rem;
            padding: 0.15rem 0.5rem;
            border-radius: 100px;
            font-weight: 600;
        }

        .role-admin { background: rgba(229, 115, 115, 0.15); color: #e57373; }
        .role-superadmin { background: rgba(186, 104, 200, 0.15); color: #ba68c8; }
        .role-staff { background: rgba(79, 195, 247, 0.15); color: #4fc3f7; }
        .role-user { background: rgba(129, 199, 132, 0.15); color: #81c784; }
    </style>
}

@section Scripts {
    <script type="module">
        import UpdatableTable from '/js/UpdatableTable.js';
        
        document.addEventListener('DOMContentLoaded', function() {
            const actions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Actions));
            const roles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Roles));
            const users = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Users));

            const table = new UpdatableTable('#logs-table', {
                label: '',
                storagePrefix: 'activityLogsTable',
                request: {
                    url: '@Url.Action("GetTableData", "ActivityLogs")',
                    type: 'GET'
                },
                fieldDefinitions: {
                    timestamp: { 
                        label: 'Timestamp',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit nc-text-muted text-nowrap',
                        renderContent: (val) => {
                            if (!val) return "—";
                            const d = new Date(val); // Parses ISO UTC accurately
                            return `<span style="font-size:0.85rem;">${d.toLocaleDateString(undefined, { year: '2-digit', month: '2-digit', day: '2-digit' })} ${d.toLocaleTimeString(undefined, { hour12: false, hour: '2-digit', minute: '2-digit', second: '2-digit' })}</span>`;
                        }
                    },
                    username: { 
                        label: 'User',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        renderContent: (val) => `<span class="nc-text-secondary">${val || "—"}</span>`
                    },
                    fullname: { 
                        label: 'Full Name',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        renderContent: (val) => `<span class="nc-text-secondary">${val || "—"}</span>`
                    },
                    role: { 
                        label: 'Role',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        type: 'select',
                        options: roles.map(r => ({value: r, label: r})),
                        renderContent: (val) => {
                            if (!val) return '';
                            const rCode = val.toLowerCase();
                            return `<span class="nc-text-muted" style="font-size:0.8rem; font-weight:600; text-transform:uppercase; letter-spacing:0.05em;">${val}</span>`;
                        }
                    },
                    action: {
                        label: 'Action',
                        widthPercentage: '16%',
                        cellClass: 'ut-min-w-fit',
                        type: 'select',
                        options: actions.map(a => ({value: a, label: a})),
                        renderContent: (val) => `<span style="font-weight:600; font-size:0.85rem;">${val}</span>`
                    },
                    details: {
                        label: 'Details',
                        widthPercentage: '0%',
                        renderContent: (val) => {
                            if (!val) return '—';
                            // Try to detect if it's JSON
                            if (val.trim().startsWith('{') || val.trim().startsWith('[')) {
                                try {
                                    const obj = JSON.parse(val);
                                    const items = Array.isArray(obj) ? obj : [obj];
                                    const firstSummary = items[0]?.summary || "Data modification detected";
                                    const summary = items.length > 1 ? `${firstSummary} (and ${items.length - 1} more)` : firstSummary;
                                    return `
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="nc-text-muted text-truncate" style="font-size:0.85rem; max-width:400px;" title="${summary}">${summary}</span>
                                            <button class="btn btn-sm btn-nc-outline py-0 px-2 flex-shrink-0" style="font-size:0.7rem; height:22px;" onclick='window.viewLogJson(${JSON.stringify(val)})'>
                                                <i class="fa fa-code me-1"></i> View Data
                                            </button>
                                        </div>
                                    `;
                                } catch (e) { /* Not JSON */ }
                            }
                            return `<span class="nc-text-muted" style="font-size:0.85rem;">${val}</span>`;
                        }
                    }
                },
                canAdd: false,
                canEdit: false,
                canDelete: false,
                itemsPerPage: 20,
                sortConfig: { key: 'timestamp', direction: 'desc' },
                customFilters: [
                    {
                        id: 'userId',
                        label: 'Users',
                        options: (users || []).map(u => ({ value: u.UserId, label: u.UserFullName || u.Username }))
                    }
                ]
            });
        });

        window.viewLogJson = function(jsonStr) {
            try {
                const obj = JSON.parse(jsonStr);
                const pretty = JSON.stringify(obj, null, 4);
                document.getElementById('jsonViewerBody').textContent = pretty;
                new bootstrap.Modal(document.getElementById('jsonModal')).show();
            } catch (e) {
                alert('Invalid JSON data');
            }
        };
    </script>

    <!-- JSON Viewer Modal -->
    <div class="modal fade" id="jsonModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content nc-card" style="border:1px solid var(--nc-border); background: #131822 !important;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title nc-page-title fs-5"><i class="fa fa-code me-2 text-primary"></i> Data Details</h5>
                    <button type="button" class="ms-auto" data-bs-dismiss="modal" aria-label="Close" style="background: transparent; border: none; color: #fff; opacity: 0.5; padding: 1.25rem !important; margin: -1.25rem -1.25rem -1.25rem auto; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center;" onmouseover="this.style.opacity=1; this.style.transform='scale(1.1)'" onmouseout="this.style.opacity=0.5; this.style.transform='scale(1)'">
                        <i class="fa fa-times" style="font-size: 1.2rem;"></i>
                    </button>
                </div>
                <div class="modal-body py-4">
                    <pre id="jsonViewerBody" class="p-3 rounded" style="background: rgba(0,0,0,0.5); color: #81c784; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; max-height: 500px; overflow: auto; border: 1px solid var(--nc-border);"></pre>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn-nc-outline" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn-nc-primary px-4" onclick="navigator.clipboard.writeText(document.getElementById('jsonViewerBody').textContent); this.innerHTML='<i class=\'fa fa-check me-1\'></i> Copied!'; setTimeout(()=>this.innerHTML='<i class=\'fa fa-copy me-1\'></i> Copy', 2000)">
                        <i class="fa fa-copy me-1"></i> Copy
                    </button>
                </div>
            </div>
        </div>
    </div>
}
